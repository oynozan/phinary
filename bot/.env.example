# Copy to bot/.env (git-ignored). Variables already set in the shell win over this file.
# The repo-root .env is also read, after bot/.env.

# Signing keys. MIRROR_/KEEPER_ override DEPLOYER_ for that bot. Never printed.
DEPLOYER_PRIVATE_KEY=
# MIRROR_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY=
# The sealed-oracle bot signs with SEALED_KEY, else KEEPER_PRIVATE_KEY. Give it its own key: it sends a poke every
# block or two, which would race the keeper for nonces.
# SEALED_KEY=

# Chain
# DEPLOYMENTS_FILE=../deployments/unichain-sepolia.json
# RPC_URL=https://sepolia.unichain.org
# CHAIN_ID=1301
# DRY_RUN=0
# ONCE=0
# LOG_LEVEL=info
# TX_TIMEOUT_MS=30000

# Address overrides (otherwise read from DEPLOYMENTS_FILE)
# POOL_MANAGER=
# PREDICTION_HOOK=
# The ownerless MarketScheduler that owns PREDICTION_HOOK; the keeper calls its open(), which anyone may call
# MARKET_SCHEDULER=
# UNDERLYING_ORACLE=
# PRICE_STEERER=
# DEMO_WETH=
# DEMO_USDC=
# Only to pin the underlying pool: the mirror reads the key from the oracle's poolKey() and refuses a pinned mismatch
# UNDERLYING_POOL_FEE=500
# UNDERLYING_POOL_TICK_SPACING=10

# Price mirror
# MIRROR_INTERVAL_MS=1000
# MIRROR_THRESHOLD_BPS=2
# coinbase, kraken, binanceus quote ETH-USD; binance quotes ETHUSDT
# MIRROR_SOURCES=coinbase,kraken,binanceus
# MIRROR_FETCH_TIMEOUT_MS=2500
# MIRROR_MAX_JUMP_BPS=1000
# MIRROR_MIN_PRICE=100
# MIRROR_MAX_PRICE=100000

# Keeper schedule. The keeper only calls the scheduler's open(), which is permissionless and enforces its own
# on-chain period (SCHEDULER_PERIOD_SEC, set at deploy time); keep KEEPER_PERIOD_SEC equal to it so the keeper does
# not poll a slot before it is open (harmless: open() then reverts AlreadyOpened and the keeper just waits it out).
# KEEPER_POLL_MS=2000
# KEEPER_PERIOD_SEC=60
# KEEPER_ALIGN=1
# KEEPER_CREATE=1
# KEEPER_SETTLE=1
# KEEPER_SCAN_BACK=50
# Seconds past expiry before settleInvalid; raised to the hook's GRACE + 1 (3601) if lower
# KEEPER_INVALID_AFTER_SEC=3601

# Sealed-oracle poker and prover (npm run sealed). SEALED_ORACLE overrides `sealedOracle` in DEPLOYMENTS_FILE.
# SEALED_ORACLE=
# Most proofs per proveMany (1-64, ~0.72M gas each); a batch is halved until it fits half a block
# SEALED_BATCH=16
# SEALED_POLL_MS=500
# Read-only RPCs tried after RPC_URL for headers and eth_getProof, comma-separated
# SEALED_RPC_FALLBACKS=

# Market parameters (human units). These no longer configure the keeper bot itself: every opened market's timing,
# quote and budget are fixed on-chain in the MarketScheduler's immutable config, set at deploy time (defaults below
# are SchedulerPair's). They still name the env variables read by the deploy scripts (script/base/SchedulerPair.sol,
# script/DeployScheduler.s.sol) and by the manual, EOA-owned-hook path (script/CreateMarket.s.sol, which defaults
# QUOTE_GAMMA_S and MARKET_TENOR_SEC differently, see its comment), since the repo-root .env is shared with them.
# SCHEDULER_PERIOD_SEC=60
# SCHEDULER_MIN_BUDGET_USDC=1
# MARKET_TENOR_SEC=120
# MARKET_WINDOW_SEC=10
# MARKET_CUTOFF_BUFFER_SEC=2
# MARKET_N_SAMPLES=10
# MARKET_OPEN_DELAY_SEC=0
# MARKET_BUDGET_USDC=10
# h0 is frozen at 2 cents (PLAN 10); below that the round-trip and extraction bounds do not hold
# QUOTE_H0=0.02
# QUOTE_GAMMA_S=0.00002
# QUOTE_LAMBDA=0.001
# QUOTE_Q_EPOCH_MAX=100
# QUOTE_P_MIN=0.02
# 0 = oracle variance, 1 = fixed (CreateMarket.s.sol only; the scheduler always opens markets in mode 0)
# SIGMA_MODE=0
# FIXED_SIGMA_ANNUAL=0.6
# MARKET_TICKER=ETH
