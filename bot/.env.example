# Copy to bot/.env (git-ignored). Variables already set in the shell win over this file.
# The repo-root .env is also read, after bot/.env.

# Signing keys. MIRROR_/KEEPER_ override DEPLOYER_ for that bot. Never printed.
DEPLOYER_PRIVATE_KEY=
# MIRROR_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY=

# Chain
# DEPLOYMENTS_FILE=../deployments/unichain-sepolia.json
# RPC_URL=https://sepolia.unichain.org
# CHAIN_ID=1301
# DRY_RUN=0
# ONCE=0
# LOG_LEVEL=info
# TX_TIMEOUT_MS=30000

# Address overrides (otherwise read from DEPLOYMENTS_FILE)
# POOL_MANAGER=
# PREDICTION_HOOK=
# UNDERLYING_ORACLE=
# PRICE_STEERER=
# DEMO_WETH=
# DEMO_USDC=
# Only to pin the underlying pool: the mirror reads the key from the oracle's poolKey() and refuses a pinned mismatch
# UNDERLYING_POOL_FEE=500
# UNDERLYING_POOL_TICK_SPACING=10

# Price mirror
# MIRROR_INTERVAL_MS=1000
# MIRROR_THRESHOLD_BPS=2
# coinbase, kraken, binanceus quote ETH-USD; binance quotes ETHUSDT
# MIRROR_SOURCES=coinbase,kraken,binanceus
# MIRROR_FETCH_TIMEOUT_MS=2500
# MIRROR_MAX_JUMP_BPS=1000
# MIRROR_MIN_PRICE=100
# MIRROR_MAX_PRICE=100000

# Keeper schedule
# KEEPER_POLL_MS=2000
# KEEPER_PERIOD_SEC=60
# KEEPER_ALIGN=1
# KEEPER_CREATE=1
# KEEPER_SETTLE=1
# KEEPER_SCAN_BACK=50
# Seconds past expiry before settleInvalid; raised to the hook's GRACE + 1 (3601) if lower
# KEEPER_INVALID_AFTER_SEC=3601

# Market template (human units)
# MARKET_TENOR_SEC=60
# MARKET_WINDOW_SEC=10
# MARKET_CUTOFF_BUFFER_SEC=2
# MARKET_N_SAMPLES=10
# MARKET_OPEN_DELAY_SEC=0
# MARKET_EXPIRY_ALIGN_SEC=0
# MARKET_BUDGET_USDC=10
# h0 is frozen at 2 cents (PLAN 10); below that the round-trip and extraction bounds do not hold
# QUOTE_H0=0.02
# QUOTE_GAMMA_S=0.00005
# QUOTE_LAMBDA=0.001
# QUOTE_Q_EPOCH_MAX=100
# QUOTE_P_MIN=0.02
# SIGMA_MODE=0
# FIXED_SIGMA_ANNUAL=0.6
# FIXED_VAR_E36=
# Only 0 (Gaussian): PredictionHook reverts UnsupportedKernel otherwise
# KERNEL=0
# MARKET_TIMEZONE=UTC
# Placeholders: {side} (UP or DOWN), {ticker}, {strike}, {date} (26 Sep), {time} (14:31:00), {hhmm} (14:31), {hhmmss} (143100).
# Symbols longer than 11 characters are rejected (MetaMask's wallet_watchAsset limit). On a shell command line, single-quote templates that contain ${strike}.
# MARKET_TICKER=ETH
# MARKET_NAME_TEMPLATE={ticker} > ${strike} {date} {hhmm}
# MARKET_SYMBOL_TEMPLATE={ticker}{side}
