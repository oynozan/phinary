{
  "name": "prediction-backup-app",
  "version": "0.1.0",
  "private": true,
  "description": "Backup swap page for PredictionHook YES/NO markets: talks only to the chain (V4Quoter, UniversalRouter 2.0, Permit2).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "local:stack": "node scripts/local-stack.ts",
    "test:e2e": "node scripts/e2e.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.49.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "puppeteer-core": "24.43.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
