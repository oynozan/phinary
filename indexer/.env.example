# Selects deployments/<name>.json: "unichain-sepolia" (default) or "local".
PONDER_NETWORK=unichain-sepolia

# Optional: override the RPC URL for chain 1301 (defaults to the deployment file's rpcUrl).
PONDER_RPC_URL_1301=

# Optional: override the block that price/vault snapshots start from (defaults to the deployment-safe snapshot block; event indexing still uses deployBlock).
SNAPSHOT_START_BLOCK=
