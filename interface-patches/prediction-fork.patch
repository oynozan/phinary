+const HOOK = getAddress('0x00000000000000000000000000000000c0de2aa8')
+const GATEKEEPER = getAddress('0x00000000000000000000000000000000000060a7')
+const ETH_ORACLE = getAddress('0x0000000000000000000000000000000000001080')
+const SOL_ORACLE = getAddress('0x0000000000000000000000000000000000002080')
+const USDC = UNICHAIN_SEPOLIA.usdc
+const NOW = 1_790_499_980 // 20 s into a minute, 380 s into a quarter hour
+
+interface TrackFixture {
+  scheduler: Address
+  ticker: string
+  period: number
+  oracle: Address
+}
+const ETH1M: TrackFixture = {
+  scheduler: getAddress('0x0000000000000000000000000000000000005c01'),
+  ticker: 'ETH1M',
+  period: 60,
+  oracle: ETH_ORACLE,
+}
+const ETH15M: TrackFixture = {
+  scheduler: getAddress('0x0000000000000000000000000000000000005c02'),
+  ticker: 'ETH15M',
+  period: 900,
+  oracle: ETH_ORACLE,
+}
+const SOL1M: TrackFixture = {
+  scheduler: getAddress('0x0000000000000000000000000000000000005c03'),
+  ticker: 'SOL1M',
+  period: 60,
+  oracle: SOL_ORACLE,
+}
+const SOL15M: TrackFixture = {
+  scheduler: getAddress('0x0000000000000000000000000000000000005c04'),
+  ticker: 'SOL15M',
+  period: 900,
+  oracle: SOL_ORACLE,
+}
+// Gatekeeper order is not display order: the picker sorts by asset, then period
+const GATEKEEPER_ORDER = [ETH1M, SOL1M, ETH15M, SOL15M]
+
+interface MarketFixture {
+  track: TrackFixture
+  status: number
+  expiry: number
+  /** Overrides the ticker-built YES symbol, to prove `schedulerOf` wins over the symbol */
+  yesSymbol?: string
+}
+
+// Ids 1..45; the registry window (40) starts at 6, so the two 15-minute markets (3, 4) are outside it
+const fixtures = new Map<bigint, MarketFixture>()
+function slotExpiry(t: TrackFixture, back: number): number {
+  return (Math.floor(NOW / t.period) - back) * t.period + t.period
+}
+function resetFixtures(): void {
+  fixtures.clear()
+  fixtures.set(1n, { track: ETH15M, status: 2, expiry: slotExpiry(ETH15M, 2) })
+  fixtures.set(2n, { track: SOL15M, status: 2, expiry: slotExpiry(SOL15M, 2) })
+  fixtures.set(3n, { track: ETH15M, status: 1, expiry: slotExpiry(ETH15M, 0) })
+  fixtures.set(4n, { track: SOL15M, status: 1, expiry: slotExpiry(SOL15M, 0) })
+  fixtures.set(5n, { track: ETH15M, status: 2, expiry: slotExpiry(ETH15M, 1) })
+  // Settled 1-minute markets, ETH then SOL each minute: 42 and 43 a minute ago, 40 and 41 two minutes ago, ...
+  for (let id = 6; id <= 43; id++) {
+    const back = Math.floor((43 - id) / 2) + 1
+    fixtures.set(BigInt(id), { track: id % 2 ? SOL1M : ETH1M, status: 2, expiry: slotExpiry(ETH1M, back) })
+  }
+  fixtures.set(42n, { track: ETH1M, status: 2, expiry: slotExpiry(ETH1M, 1), yesSymbol: 'ODDUP' })
+  fixtures.set(44n, { track: ETH1M, status: 1, expiry: slotExpiry(ETH1M, 0) })
+  fixtures.set(45n, { track: SOL1M, status: 1, expiry: slotExpiry(SOL1M, 0) })
+}
+
+const yesOf = (id: bigint): Address => getAddress(`0xfe${id.toString(16).padStart(38, '0')}`)
+const noOf = (id: bigint): Address => getAddress(`0x01${id.toString(16).padStart(38, '0')}`)
+
+class Revert {
+  constructor(readonly data: Hex) {}
+}
+
+const innerCalls: string[] = []
+
+function contract(name: string, abi: Abi, impl: Record<string, (...args: never[]) => unknown>): (data: Hex) => Hex {
+  return (data) => {
+    let decoded
+    try {
+      decoded = decodeFunctionData({ abi, data })
+    } catch {
+      throw new Revert('0x')
+    }
+    const fn = impl[decoded.functionName] as ((...a: unknown[]) => unknown) | undefined
+    if (!fn) {
+      throw new Revert('0x')
+    }
+    innerCalls.push(`${name}.${decoded.functionName}(${(decoded.args ?? []).join(',')})`)
+    return encodeFunctionResult({
+      abi,
+      functionName: decoded.functionName,
+      result: fn(...(decoded.args ?? [])),
+    } as never)
+  }
+}
+
+function marketInfo(id: bigint): Record<string, unknown> {
+  const f = fixtures.get(id)
+  return {
+    yes: f ? yesOf(id) : zeroAddress,
+    no: f ? noOf(id) : zeroAddress,
+    oracle: f?.track.oracle ?? zeroAddress,
+    lnStrikeWad: 0n,
+    openTime: f ? BigInt(f.expiry - f.track.period) : 0n,
+    expiry: BigInt(f?.expiry ?? 0),
+    window: 10,
+    cutoffBuffer: 2,
+    status: f?.status ?? 0,
+    yesWon: false,
+    bucket: 0n,
+    outYes: 0n,
+    outNo: 0n,
+    invYes: 0n,
+    invNo: 0n,
+  }
+}
+
+const handlers: Record<string, (data: Hex) => Hex> = {
+  [HOOK.toLowerCase()]: contract('hook', predictionHookAbi, {
+    marketCount: () => 45n,
+    marketInfo: (id: bigint) => marketInfo(id),
+    poolKeys: (id: bigint) => [
+      predictionPoolKey({ token: yesOf(id), usdc: USDC, hook: HOOK }),
+      predictionPoolKey({ token: noOf(id), usdc: USDC, hook: HOOK }),
+    ],
+  }),
+  [GATEKEEPER.toLowerCase()]: contract('gatekeeper', MARKET_GATEKEEPER_ABI, {
+    schedulers: () => GATEKEEPER_ORDER.map((t) => t.scheduler),
+    schedulerOf: (id: bigint) => fixtures.get(id)?.track.scheduler ?? zeroAddress,
+  }),
+}
+for (const t of GATEKEEPER_ORDER) {
+  handlers[t.scheduler.toLowerCase()] = contract(t.ticker, TRACK_SCHEDULER_ABI, {
+    config: () => ({
+      period: t.period,
+      tenor: t.period,
+      window: t.period === 60 ? 10 : 30,
+      cutoffBuffer: 2,
+      nSamples: 10,
+      quote: { h0Wad: 0n, gammaSWad: 0n, lambdaWad: 0n, qEpochMax: 0n, pMinWad: 0n },
+      maxBudget: 0n,
+      minBudget: 0n,
+      ticker: t.ticker,
+    }),
+    oracle: () => t.oracle,
+    marketOfSlot: (slot: bigint) => {
+      for (const [id, f] of fixtures) {
+        if (f.track === t && BigInt(f.expiry / t.period - 1) === slot) {
+          return id
+        }
+      }
+      return 0n
+    },
+  })
+}
+
+function tokenHandler(id: bigint, isYes: boolean): (data: Hex) => Hex {
+  const f = fixtures.get(id)
+  const symbol = (): string =>
+    isYes ? (fixtures.get(id)?.yesSymbol ?? `${f?.track.ticker}UP`) : `${f?.track.ticker}DOWN`
+  return contract('token', outcomeTokenAbi, {
+    symbol,
+    name: () => `${f?.track.ticker} > $2690.13`,
+    hook: () => HOOK,
+    marketId: () => id,
+    isYes: () => isYes,
+  })
+}
+
+function run(to: string, data: Hex): Hex {
+  const lower = to.toLowerCase()
+  const h = handlers[lower]
+  if (h) {
+    return h(data)
+  }
+  const id = BigInt(`0x${lower.slice(4)}`)
+  if (lower.startsWith('0xfe') || lower.startsWith('0x01')) {
+    return tokenHandler(id, lower.startsWith('0xfe'))(data)
+  }
+  throw new Revert('0x')
+}
+
+handlers[UNICHAIN_SEPOLIA.multicall3.toLowerCase()] = contract(
+  'multicall',
+  parseAbi([
+    'struct Call3 { address target; bool allowFailure; bytes callData; }',
+    'struct Result { bool success; bytes returnData; }',
+    'function aggregate3(Call3[] calls) payable returns (Result[] returnData)',
+  ]),
+  {
+    aggregate3: (calls: readonly { target: Address; callData: Hex }[]) =>
+      calls.map((c) => {
+        try {
+          return { success: true, returnData: run(c.target, c.callData) }
+        } catch (e) {
+          return { success: false, returnData: e instanceof Revert ? e.data : '0x' }
+        }
+      }),
+  },
+)
+
+const client = createClient({
+  chain: unichainSepolia,
+  transport: custom({
+    async request({ method, params }: { method: string; params: unknown[] }) {
+      if (method === 'eth_chainId') {
+        return '0x515'
+      }
+      if (method !== 'eth_call') {
+        throw new Error(`unsupported ${method}`)
+      }
+      const [tx] = params as [{ to: string; data?: Hex; input?: Hex }]
+      try {
+        return run(tx.to, (tx.data ?? tx.input) as Hex)
+      } catch (e) {
+        if (e instanceof Revert) {
+          throw new RpcRequestError({
+            body: {},
+            url: 'mock://',
+            error: { code: 3, message: 'execution reverted', data: e.data },
+          })
+        }
+        throw e
+      }
+    },
+  }),
+})
+
+function ticker(id: bigint): string | undefined {
+  return getPredictionMarketTrack(getPredictionMarket(id))?.ticker
+}
+
+describe('market tracks', () => {
+  beforeEach(() => {
+    vi.useFakeTimers({ toFake: ['Date'] })
+    vi.setSystemTime(NOW * 1000)
+    resetFixtures()
+    setPredictionPublicClient(client)
+    resetPredictionRegistry()
+    innerCalls.length = 0
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  afterAll(() => {
+    setPredictionPublicClient(undefined)
+  })
+
+  it('reads the tracks from the gatekeeper and orders them by asset, then period', async () => {
+    await refreshPredictionRegistry()
+    expect(getPredictionTracks().map((t) => t.label)).toEqual([
+      'ETH 1-minute',
+      'ETH 15-minute',
+      'SOL 1-minute',
+      'SOL 15-minute',
+    ])
+    expect(getPredictionTracks().map((t) => t.asset)).toEqual(['ETH', 'ETH', 'SOL', 'SOL'])
+  })
+
+  it('classifies markets by gatekeeper.schedulerOf: ETH1M, ETH15M and SOL1M apart, whatever the symbol says', async () => {
+    await refreshPredictionRegistry()
+    expect(ticker(44n)).toBe('ETH1M')
+    expect(ticker(45n)).toBe('SOL1M')
+    expect(ticker(43n)).toBe('SOL1M')
+    // Market 42's YES symbol matches no ticker; the gatekeeper still knows its scheduler
+    expect(getPredictionMarket(42n)?.yes.symbol).toBe('ODDUP')
+    expect(ticker(42n)).toBe('ETH1M')
+  })
+
+  it('registers each track recent markets, so 15-minute markets outside the newest-40 window are listed', async () => {
+    await refreshPredictionRegistry()
+    // 40 in the window (6..45) and 1..5 through `marketOfSlot` of the 15-minute tracks
+    expect(getPredictionMarkets().length).toBe(45)
+    expect(getPredictionMarket(3n)?.status).toBe('Trading')
+    expect(ticker(3n)).toBe('ETH15M')
+    expect(ticker(4n)).toBe('SOL15M')
+    expect(ticker(5n)).toBe('ETH15M')
+    expect(getPredictionMarket(3n)?.yes.symbol).toBe('ETH15MUP')
+    expect(getPredictionTokenTrack(getPredictionMarket(4n)?.no)?.label).toBe('SOL 15-minute')
+  })
+
+  it('re-reads an out-of-window market until it settles, then stops', async () => {
+    await refreshPredictionRegistry()
+    fixtures.set(3n, { ...(fixtures.get(3n) as MarketFixture), status: 2 })
+    innerCalls.length = 0
+    await refreshPredictionRegistry()
+    expect(getPredictionMarket(3n)?.status).toBe('Settled')
+    expect(innerCalls).toContain('hook.marketInfo(3)')
