@@ -0,0 +1,214 @@
+import { getCommonBase } from 'uniswap/src/constants/routing'
+import { PREDICTION_HOOK_STORAGE_KEY } from 'uniswap/src/features/predictionMarkets/config'
+import {
+  getPredictionMarkets,
+  getPredictionRegistryVersion,
+  getPredictionToken,
+  refreshPredictionRegistry,
+  resetPredictionRegistry,
+  resolvePredictionRoute,
+} from 'uniswap/src/features/predictionMarkets/registry'
+import { setPredictionPublicClient } from 'uniswap/src/features/predictionMarkets/rpc'
+import {
+  outcomeTokenAbi,
+  predictionHookAbi,
+  predictionPoolKey,
+  UNICHAIN_SEPOLIA,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  type Abi,
+  type Address,
+  createClient,
+  custom,
+  decodeFunctionData,
+  encodeFunctionResult,
+  getAddress,
+  type Hex,
+  parseAbi,
+  RpcRequestError,
+  zeroAddress,
+} from 'viem'
+import { unichainSepolia } from 'viem/chains'
+
+const HOOK = getAddress('0x00000000000000000000000000000000c0de2aa8')
+const USDC = UNICHAIN_SEPOLIA.usdc
+const Y1 = getAddress('0xfe00000000000000000000000000000000000001')
+const N1 = getAddress('0x0100000000000000000000000000000000000001')
+const Y7 = getAddress('0xfe00000000000000000000000000000000000007')
+const N7 = getAddress('0x0100000000000000000000000000000000000007')
+const FOREIGN = getAddress('0xdead000000000000000000000000000000000001')
+
+class Revert {
+  constructor(readonly data: Hex) {}
+}
+
+function contract(abi: Abi, impl: Record<string, (...args: never[]) => unknown>): (data: Hex) => Hex {
+  return (data) => {
+    let decoded
+    try {
+      decoded = decodeFunctionData({ abi, data })
+    } catch {
+      throw new Revert('0x')
+    }
+    const fn = impl[decoded.functionName] as ((...a: unknown[]) => unknown) | undefined
+    if (!fn) {
+      throw new Revert('0x')
+    }
+    return encodeFunctionResult({
+      abi,
+      functionName: decoded.functionName,
+      result: fn(...(decoded.args ?? [])),
+    } as never)
+  }
+}
+
+function info(yes: Address, no: Address, status: number) {
+  return {
+    yes,
+    no,
+    oracle: zeroAddress,
+    lnStrikeWad: 0n,
+    openTime: 0n,
+    expiry: 60n,
+    window: 10,
+    cutoffBuffer: 2,
+    status,
+    yesWon: false,
+    bucket: 0n,
+    outYes: 0n,
+    outNo: 0n,
+    invYes: 0n,
+    invNo: 0n,
+  }
+}
+
+function token(p: { symbol: string; owner: Address; marketId: bigint; isYes: boolean }): (data: Hex) => Hex {
+  return contract(outcomeTokenAbi, {
+    symbol: () => p.symbol,
+    name: () => `${p.symbol} name`,
+    hook: () => p.owner,
+    marketId: () => p.marketId,
+    isYes: () => p.isYes,
+  })
+}
+
+const handlers: Record<string, (data: Hex) => Hex> = {
+  [HOOK.toLowerCase()]: contract(predictionHookAbi, {
+    marketCount: () => 1n,
+    marketInfo: (id: bigint) => (id === 1n ? info(Y1, N1, 1) : info(zeroAddress, zeroAddress, 0)),
+    poolKeys: (id: bigint) => {
+      const [yes, no] = id === 1n ? [Y1, N1] : id === 7n ? [Y7, N7] : []
+      if (!yes || !no) {
+        throw new Revert('0x')
+      }
+      return [
+        predictionPoolKey({ token: yes, usdc: USDC, hook: HOOK }),
+        predictionPoolKey({ token: no, usdc: USDC, hook: HOOK }),
+      ]
+    },
+  }),
+  [Y1.toLowerCase()]: token({ symbol: 'YES-1', owner: HOOK, marketId: 1n, isYes: true }),
+  [N1.toLowerCase()]: token({ symbol: 'NO-1', owner: HOOK, marketId: 1n, isYes: false }),
+  [Y7.toLowerCase()]: token({ symbol: 'YES-7', owner: HOOK, marketId: 7n, isYes: true }),
+  [FOREIGN.toLowerCase()]: token({ symbol: 'FAKE', owner: FOREIGN, marketId: 1n, isYes: true }),
+}
+
+function run(to: string, data: Hex): Hex {
+  const h = handlers[to.toLowerCase()]
+  if (!h) {
+    throw new Revert('0x')
+  }
+  return h(data)
+}
+
+handlers[UNICHAIN_SEPOLIA.multicall3.toLowerCase()] = contract(
+  parseAbi([
+    'struct Call3 { address target; bool allowFailure; bytes callData; }',
+    'struct Result { bool success; bytes returnData; }',
+    'function aggregate3(Call3[] calls) payable returns (Result[] returnData)',
+  ]),
+  {
+    aggregate3: (calls: readonly { target: Address; callData: Hex }[]) =>
+      calls.map((c) => {
+        try {
+          return { success: true, returnData: run(c.target, c.callData) }
+        } catch (e) {
+          return { success: false, returnData: e instanceof Revert ? e.data : '0x' }
+        }
+      }),
+  },
+)
+
+const calls: string[] = []
+const client = createClient({
+  chain: unichainSepolia,
+  transport: custom({
+    async request({ method, params }: { method: string; params: unknown[] }) {
+      if (method === 'eth_chainId') {
+        return '0x515'
+      }
+      if (method !== 'eth_call') {
+        throw new Error(`unsupported ${method}`)
+      }
+      const [tx] = params as [{ to: string; data?: Hex; input?: Hex }]
+      calls.push(tx.to.toLowerCase())
+      try {
+        return run(tx.to, (tx.data ?? tx.input) as Hex)
+      } catch (e) {
+        if (e instanceof Revert) {
+          throw new RpcRequestError({
+            body: {},
+            url: 'mock://',
+            error: { code: 3, message: 'execution reverted', data: e.data },
+          })
+        }
+        throw e
+      }
+    },
+  }),
+})
+
+describe('prediction market registry', () => {
+  beforeEach(() => {
+    localStorage.setItem(PREDICTION_HOOK_STORAGE_KEY, HOOK)
+    setPredictionPublicClient(client)
+    resetPredictionRegistry()
+    calls.length = 0
+  })
+
+  afterAll(() => {
+    localStorage.removeItem(PREDICTION_HOOK_STORAGE_KEY)
+    setPredictionPublicClient(undefined)
+  })
+
+  it('reads the newest markets from the hook and exposes their tokens as benign common bases', async () => {
+    const before = getPredictionRegistryVersion()
+    await refreshPredictionRegistry()
+    expect(getPredictionRegistryVersion()).toBeGreaterThan(before)
+    expect(getPredictionMarkets().map((m) => m.id)).toEqual([1n])
+    expect(getPredictionToken(1301, Y1.toLowerCase())?.symbol).toBe('YES-1')
+    expect(getPredictionToken(1301, N1)?.poolKey).toEqual(predictionPoolKey({ token: N1, usdc: USDC, hook: HOOK }))
+    expect(getCommonBase(1301, N1)?.currency.symbol).toBe('NO-1')
+  })
+
+  it('resolves an older market token on demand and caches foreign tokens', async () => {
+    const route = await resolvePredictionRoute(USDC, Y7)
+    expect(route?.token.symbol).toBe('YES-7')
+    expect(route?.isBuy).toBe(true)
+    expect(route?.zeroForOne).toBe(BigInt(USDC) < BigInt(Y7))
+    expect(getPredictionToken(1301, Y7)?.marketId).toBe(7n)
+
+    expect(await resolvePredictionRoute(FOREIGN, USDC)).toBeUndefined()
+    const n = calls.length
+    expect(await resolvePredictionRoute(FOREIGN, USDC)).toBeUndefined()
+    expect(calls.length).toBe(n)
+    expect(await resolvePredictionRoute(Y7, Y1)).toBeUndefined()
+  })
+
+  it('does nothing until a hook address is configured', async () => {
+    localStorage.removeItem(PREDICTION_HOOK_STORAGE_KEY)
+    await refreshPredictionRegistry()
+    expect(await resolvePredictionRoute(USDC, Y7)).toBeUndefined()
+    expect(calls).toEqual([])
+  })
+})
