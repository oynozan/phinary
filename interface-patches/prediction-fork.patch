+} from 'viem'
+import { unichainSepolia } from 'viem/chains'
+
+vi.mock('uniswap/src/features/predictionMarkets/deployment.generated', () => ({
+  PREDICTION_DEPLOYMENT_JSON: {
+    chainId: 1301,
+    predictionHook: '0x00000000000000000000000000000000c0de2aa8',
+    marketGatekeeper: '0x00000000000000000000000000000000000060a7',
+    // Deliberately not the gatekeeper's order: the gatekeeper's own list wins
+    marketSchedulers: ['0x0000000000000000000000000000000000005c01'],
+    underlyingOracle: '0x0000000000000000000000000000000000001080',
+    underlyings: [
+      {
