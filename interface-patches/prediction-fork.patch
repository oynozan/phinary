@@ -0,0 +1,204 @@
+import { useQuery } from '@tanstack/react-query'
+import type { Currency } from '@uniswap/sdk-core'
+import { type ColorTokens, Flex, Text } from '@universe/mycelium'
+import { memo, useMemo, useState } from 'react'
+import { getPredictionDeployment } from 'uniswap/src/features/predictionMarkets/config'
+import {
+  getPredictionMarket,
+  getPredictionToken,
+  getPredictionTokenTrack,
+  usePredictionRegistry,
+} from 'uniswap/src/features/predictionMarkets/registry'
+import { type OutcomeTokenInfo, strikeUsdFromLn } from 'uniswap/src/features/predictionMarkets/sdk'
+import { predictionMarketAsset } from 'uniswap/src/features/predictionMarkets/tracks'
+import { getPredictionErrorData } from 'uniswap/src/features/predictionMarkets/tradingApiFormat'
+import {
+  formatCountdown,
+  formatMarketQuestion,
+  formatUsd,
+} from 'uniswap/src/features/predictionMarkets/ui/marketFormat'
+import {
+  describeOutcome,
+  type PredictionMarketPhase,
+  summarizePredictionMarket,
+} from 'uniswap/src/features/predictionMarkets/ui/marketStatus'
+import { describePredictionError } from 'uniswap/src/features/predictionMarkets/ui/predictionErrors'
+import { predictionMarketLiveQueryOptions } from 'uniswap/src/features/predictionMarkets/ui/predictionMarketLive'
+import { useSwapFormStoreDerivedSwapInfo } from 'uniswap/src/features/transactions/swap/stores/swapFormStore/useSwapFormStore'
+import { CurrencyField } from 'uniswap/src/types/currency'
+import { ONE_SECOND_MS } from 'utilities/src/time/time'
+import { useInterval } from 'utilities/src/time/timing'
+
+const BADGE_COLORS: Record<PredictionMarketPhase, { background: ColorTokens; text: ColorTokens }> = {
+  upcoming: { background: '$surface3', text: '$neutral2' },
+  trading: { background: '$statusSuccess2', text: '$statusSuccess' },
+  closing: { background: '$statusWarning2', text: '$statusWarning' },
+  closed: { background: '$statusWarning2', text: '$statusWarning' },
+  settled: { background: '$accent2', text: '$accent1' },
+  invalid: { background: '$statusCritical2', text: '$statusCritical' },
+}
+
+function nowSeconds(): number {
+  return Math.floor(Date.now() / 1000)
+}
+
+function outcomeToken(currency: Currency | undefined): OutcomeTokenInfo | undefined {
+  return currency?.isToken ? getPredictionToken(currency.chainId, currency.address) : undefined
+}
+
+function OutcomeRow({
+  label,
+  selected,
+  outcome,
+}: {
+  label: string
+  selected: boolean
+  outcome: { probability: string; prices: string }
+}): JSX.Element {
+  const color = selected ? '$neutral1' : '$neutral2'
+  return (
+    <Flex row alignItems="center" justifyContent="space-between" gap="$spacing8">
+      <Flex row alignItems="center" gap="$spacing8">
+        <Text variant={selected ? 'buttonLabel3' : 'body3'} color={color} minWidth={28}>
+          {label}
+        </Text>
+        <Text variant="body3" color={color}>
+          {outcome.probability}
+        </Text>
+      </Flex>
+      <Text variant="body3" color="$neutral2">
+        {outcome.prices}
+      </Text>
+    </Flex>
+  )
+}
+
+function formatSpot({ asset, spotUsd, strikeUsd }: { asset?: string; spotUsd: number; strikeUsd: number }): string {
+  const gap = spotUsd - strikeUsd
+  return `${asset ?? 'Spot'} ${formatUsd(spotUsd)}, ${formatUsd(Math.abs(gap))} ${gap >= 0 ? 'above' : 'below'} strike`
+}
+
+function hintColor(phase: PredictionMarketPhase, selectedWon: boolean): ColorTokens {
+  switch (phase) {
+    case 'closing':
+    case 'closed':
+      return '$statusWarning'
+    case 'settled':
+      return selectedWon ? '$statusSuccess' : '$statusCritical'
+    case 'trading':
+      return '$neutral1'
+    default:
+      return '$neutral2'
+  }
+}
+
+/** Status, countdowns and live prices of the prediction market whose YES or NO token is in the swap form */
+export const PredictionMarketPanel = memo(function PredictionMarketPanel(): JSX.Element | null {
+  const { input, output, chainId, tradeError } = useSwapFormStoreDerivedSwapInfo((s) => ({
+    input: s.currencies[CurrencyField.INPUT]?.currency,
+    output: s.currencies[CurrencyField.OUTPUT]?.currency,
+    chainId: s.chainId,
+    tradeError: s.trade.error,
+  }))
+  usePredictionRegistry(chainId)
+  const [now, setNow] = useState(nowSeconds)
+
+  const token = outcomeToken(output) ?? outcomeToken(input)
+  const registered = token ? getPredictionMarket(token.marketId) : undefined
+  const ref = useMemo(
+    () =>
+      token ? { hook: token.poolKey.hooks, marketId: token.marketId, oracle: registered?.info.oracle } : undefined,
+    [token, registered?.info.oracle],
+  )
+  const { data: live } = useQuery(predictionMarketLiveQueryOptions(ref))
+  useInterval(() => setNow(nowSeconds()), token ? ONE_SECOND_MS : null)
+
+  const info = live?.info ?? registered?.info
+  if (!token || !info) {
+    return null
+  }
+
+  const cutoff = info.expiry - BigInt(info.window) - BigInt(info.cutoffBuffer)
+  const summary = summarizePredictionMarket({ market: { cutoff, info }, isYes: token.isYes, now })
+  const strikeUsd = strikeUsdFromLn(info.lnStrikeWad)
+  const track = getPredictionTokenTrack(token)
+  const asset = predictionMarketAsset({
+    track,
+    oracle: info.oracle,
+    symbol: token.symbol,
+    underlyings: getPredictionDeployment().underlyings,
+  })
+  const question = formatMarketQuestion({ strikeUsd, info, asset }, now)
+  const isFinal = summary.phase === 'settled' || summary.phase === 'invalid'
+  const errorData = getPredictionErrorData(tradeError)
+  const errorText =
+    errorData && errorData.predictionCode !== 'MARKET_CLOSED'
+      ? describePredictionError(errorData, now).message
+      : undefined
+  const facts = [
+    track ? `${track.duration} market` : undefined,
+    live?.spotUsd === undefined || isFinal ? undefined : formatSpot({ asset, spotUsd: live.spotUsd, strikeUsd }),
+    summary.phase === 'upcoming' ? `Opens in ${formatCountdown(Number(info.openTime) - now)}` : undefined,
+    summary.phase === 'trading' || summary.phase === 'closing'
+      ? `Closes in ${formatCountdown(Number(cutoff) - now)}`
+      : undefined,
+    (summary.phase === 'trading' || summary.phase === 'closing' || summary.phase === 'closed') &&
+    now < Number(info.expiry)
+      ? `Expires in ${formatCountdown(Number(info.expiry) - now)}`
+      : undefined,
+  ].filter(Boolean)
+
+  return (
+    <Flex
+      gap="$spacing8"
+      p="$spacing16"
+      borderRadius="$rounded20"
+      borderWidth="$spacing1"
+      borderColor="$surface3"
+      backgroundColor="$surface1"
+      testID="prediction-market-panel"
+    >
+      <Flex row alignItems="flex-start" justifyContent="space-between" gap="$spacing8">
+        <Text variant="subheading2" color="$neutral1" flexShrink={1}>
+          {question}
+        </Text>
+        <Flex
+          px="$spacing8"
+          py="$spacing2"
+          borderRadius="$roundedFull"
+          backgroundColor={BADGE_COLORS[summary.phase].background}
+          flexShrink={0}
+        >
+          <Text variant="buttonLabel4" color={BADGE_COLORS[summary.phase].text}>
+            {summary.badge}
+          </Text>
+        </Flex>
+      </Flex>
+      {facts.length > 0 && (
+        <Text variant="body3" color="$neutral2">
+          {facts.join(' · ')}
+        </Text>
+      )}
+      <Flex gap="$spacing4">
+        <OutcomeRow
+          label="YES"
+          selected={token.isYes}
+          outcome={describeOutcome({ info, quote: live?.quote, isYes: true })}
+        />
+        <OutcomeRow
+          label="NO"
+          selected={!token.isYes}
+          outcome={describeOutcome({ info, quote: live?.quote, isYes: false })}
+        />
+      </Flex>
+      <Text variant="body3" color={hintColor(summary.phase, info.yesWon === token.isYes)}>
+        {summary.hint}
+      </Text>
+      {errorText && (
+        <Text variant="body3" color="$statusWarning">
+          {errorText}
+        </Text>
+      )}
+    </Flex>
+  )
+})
diff --git a/packages/uniswap/src/features/predictionMarkets/ui/marketFormat.ts b/packages/uniswap/src/features/predictionMarkets/ui/marketFormat.ts
new file mode 100644
index 0000000..b1e1489
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/ui/marketFormat.ts
@@ -0,0 +1,54 @@
+import type { Market } from 'uniswap/src/features/predictionMarkets/sdk'
+
+const DAY_SECONDS = 86_400
+const HOUR_SECONDS = 3_600
+
+function pad2(n: number): string {
+  return n.toString().padStart(2, '0')
+}
+
+/** A market time in UTC, the zone the market names use, with the date only when it is not within a day of `now` */
+export function formatMarketTime(seconds: bigint | number, now: number): string {
+  const t = Number(seconds)
+  const d = new Date(t * 1000)
+  const clock = `${pad2(d.getUTCHours())}:${pad2(d.getUTCMinutes())}:${pad2(d.getUTCSeconds())}`
+  if (Math.abs(t - now) < DAY_SECONDS) {
+    return `${clock} UTC`
+  }
+  const date = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
+  return `${date}, ${clock} UTC`
+}
+
+/** Seconds left as `m:ss`, `h:mm:ss` or `2d 3h` */
+export function formatCountdown(seconds: number): string {
+  const s = Math.max(0, Math.floor(seconds))
+  if (s >= DAY_SECONDS) {
+    return `${Math.floor(s / DAY_SECONDS)}d ${Math.floor((s % DAY_SECONDS) / HOUR_SECONDS)}h`
+  }
+  const h = Math.floor(s / HOUR_SECONDS)
+  const m = Math.floor((s % HOUR_SECONDS) / 60)
+  const rest = pad2(s % 60)
+  return h > 0 ? `${h}:${pad2(m)}:${rest}` : `${m}:${rest}`
+}
+
+export function formatUsd(value: number): string {
+  return `$${value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
+}
+
+/** A WAD price of an outcome token in USDC, e.g. `$0.546` */
+export function formatOutcomePrice(wad: bigint): string {
+  return `$${(Number(wad) / 1e18).toFixed(3)}`
+}
+
+/** A WAD price as the market's implied probability, e.g. `50.3%` */
+export function formatProbability(wad: bigint): string {
+  return `${((Number(wad) / 1e18) * 100).toFixed(1)}%`
+}
+
+/** "SOL above $151.20 at 23:02:04 UTC?", or "Price above ..." when the market's asset is unknown */
+export function formatMarketQuestion(
+  market: Pick<Market, 'strikeUsd' | 'info'> & { asset: string | undefined },
+  now: number,
+): string {
+  return `${market.asset ?? 'Price'} above ${formatUsd(market.strikeUsd)} at ${formatMarketTime(market.info.expiry, now)}?`
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/ui/marketStatus.ts b/packages/uniswap/src/features/predictionMarkets/ui/marketStatus.ts
new file mode 100644
index 0000000..cc29b77
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/ui/marketStatus.ts
@@ -0,0 +1,134 @@
+import { PREDICTION_CONFIRM_SECONDS } from 'uniswap/src/features/predictionMarkets/config'
+import {
+  type HookQuote,
+  type Market,
+  type MarketInfo,
+  MarketStatus,
+  WAD,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  formatCountdown,
+  formatMarketTime,
+  formatOutcomePrice,
+  formatProbability,
+} from 'uniswap/src/features/predictionMarkets/ui/marketFormat'
+
+export type PredictionMarketPhase = 'upcoming' | 'trading' | 'closing' | 'closed' | 'settled' | 'invalid'
+
+export interface PredictionMarketSummary {
+  phase: PredictionMarketPhase
+  badge: string
+  /** What the holder of the selected token can do now */
+  hint: string
+}
+
+type PhaseInput = {
+  cutoff: Market['cutoff']
+  info: Pick<MarketInfo, 'openTime' | 'expiry' | 'status' | 'yesWon'>
+}
+
+/** Still before the cutoff, but too close to it for a swap sent now to confirm in time */
+export function isPredictionMarketClosing(cutoff: bigint, now: number): boolean {
+  const left = Number(cutoff) - now
+  return left > 0 && left < PREDICTION_CONFIRM_SECONDS
+}
+
+/**
+ * Mirrors the hook's `_inTradingWindow`, open from `openTime` until `expiry - window - cutoffBuffer`, with the last
+ * seconds before the cutoff as 'closing'
+ */
+export function getPredictionMarketPhase({ cutoff, info }: PhaseInput, now: number): PredictionMarketPhase {
+  if (info.status === MarketStatus.Settled) {
+    return 'settled'
+  }
+  if (info.status === MarketStatus.Invalid) {
+    return 'invalid'
+  }
+  if (now < Number(info.openTime)) {
+    return 'upcoming'
+  }
+  if (now >= Number(cutoff)) {
+    return 'closed'
+  }
+  return isPredictionMarketClosing(cutoff, now) ? 'closing' : 'trading'
+}
+
+export function summarizePredictionMarket({
+  market,
+  isYes,
+  now,
+}: {
+  market: PhaseInput
+  isYes: boolean
+  now: number
+}): PredictionMarketSummary {
+  const { info } = market
+  const phase = getPredictionMarketPhase(market, now)
+  const side = isYes ? 'YES' : 'NO'
+  const winner = info.yesWon ? 'YES' : 'NO'
+  switch (phase) {
+    case 'upcoming':
+      return { phase, badge: 'Opens soon', hint: `Trading opens at ${formatMarketTime(info.openTime, now)}` }
+    case 'trading':
+      return { phase, badge: 'Trading', hint: `Trading closes in ${formatCountdown(Number(market.cutoff) - now)}` }
+    case 'closing':
+      return {
+        phase,
+        badge: 'Closing',
+        hint: `Trading closes in ${formatCountdown(Number(market.cutoff) - now)}, too soon for a new swap to confirm`,
+      }
+    case 'closed':
+      return {
+        phase,
+        badge: 'Closed - awaiting settlement',
+        hint:
+          now < Number(info.expiry)
+            ? `Trading closed - settles at ${formatMarketTime(info.expiry, now)}`
+            : 'Trading closed - settling now',
+      }
+    case 'settled':
+      return {
+        phase,
+        badge: `Settled: ${winner} won`,
+        hint:
+          side === winner
+            ? `${side} won - sell ${side} for exactly $1.00`
+            : `${winner} won - ${side} is worth $0 and cannot be sold`,
+      }
+    case 'invalid':
+      break
+  }
+  return { phase, badge: 'Invalid', hint: 'Market voided - YES and NO each sell for $0.50' }
+}
+
+/** One outcome's probability and prices, fixed payouts once settled, and the mid alone after the cutoff */
+export function describeOutcome({
+  info,
+  quote,
+  isYes,
+}: {
+  info: Pick<MarketInfo, 'status' | 'yesWon'>
+  quote: HookQuote | undefined
+  isYes: boolean
+}): { probability: string; prices: string } {
+  if (info.status === MarketStatus.Settled) {
+    const won = info.yesWon === isYes
+    return { probability: won ? 'Won' : 'Lost', prices: won ? 'Pays $1.00' : 'Pays $0.00' }
+  }
+  if (info.status === MarketStatus.Invalid) {
+    return { probability: 'Voided', prices: 'Pays $0.50' }
+  }
+  // The hook quotes zeros inside the settlement averaging window
+  if (!quote?.midYes) {
+    return { probability: '-', prices: '' }
+  }
+  const mid = isYes ? quote.midYes : WAD - quote.midYes
+  if (!quote.tradable) {
+    return { probability: formatProbability(mid), prices: `Mid ${formatOutcomePrice(mid)}` }
+  }
+  const [ask, bid] = isYes ? [quote.askYes, quote.bidYes] : [quote.askNo, quote.bidNo]
+  return {
+    probability: formatProbability(mid),
+    prices: `Ask ${formatOutcomePrice(ask)} · Bid ${formatOutcomePrice(bid)}`,
+  }
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/ui/predictionErrors.ts b/packages/uniswap/src/features/predictionMarkets/ui/predictionErrors.ts
new file mode 100644
index 0000000..13ae5c6
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/ui/predictionErrors.ts
@@ -0,0 +1,145 @@
+import {
+  type Warning,
+  WarningAction,
+  WarningLabel,
+  WarningSeverity,
+} from 'uniswap/src/components/modals/WarningModal/types'
+import { getPredictionMarket } from 'uniswap/src/features/predictionMarkets/registry'
+import type { Market } from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  getPredictionErrorData,
+  PREDICTION_CLOSING_REVERT,
+  PREDICTION_RPC_ERROR_CODE,
+  PREDICTION_USDC_ONLY_CODE,
+  type PredictionErrorData,
+} from 'uniswap/src/features/predictionMarkets/tradingApiFormat'
+import { formatMarketTime } from 'uniswap/src/features/predictionMarkets/ui/marketFormat'
+
+export interface PredictionErrorText {
+  /** Short enough for the swap button */
+  title: string
+  message: string
+}
+
+function nowSeconds(): number {
+  return Math.floor(Date.now() / 1000)
+}
+
+function describeClosedMarket({
+  data,
+  market,
+  now,
+}: {
+  data: PredictionErrorData
+  market: Market | undefined
+  now: number
+}): PredictionErrorText {
+  const side = data.isYes === undefined ? undefined : data.isYes ? 'YES' : 'NO'
+  const other = data.isYes === undefined ? undefined : data.isYes ? 'NO' : 'YES'
+  // MarketClosed means Settled or Invalid, and for a sell also that the token lost
+  if (data.revert === 'MarketClosed') {
+    if (data.isBuy === false && side && other) {
+      return {
+        title: `${other} won - ${side} can't be sold`,
+        message: `${other} won. ${side} is worth $0 and cannot be sold.`,
+      }
+    }
+    if (market?.status === 'Invalid') {
+      return { title: 'Market voided', message: 'This market was voided. YES and NO each sell for $0.50.' }
+    }
+    const winner = market?.status === 'Settled' ? (market.info.yesWon ? 'YES' : 'NO') : undefined
+    return {
+      title: 'Market settled',
+      message: `${winner ? `${winner} won. ` : ''}A settled market can't be bought. The winning token sells for exactly $1.00.`,
+    }
+  }
+  if (data.revert === PREDICTION_CLOSING_REVERT) {
+    return {
+      title: 'Trading closing',
+      message: `Trading closes${market ? ` at ${formatMarketTime(market.cutoff, now)}` : ' in a few seconds'}, too soon for a swap to confirm before then.`,
+    }
+  }
+  if (market && now < Number(market.info.openTime)) {
+    return { title: 'Market not open yet', message: `Trading opens at ${formatMarketTime(market.info.openTime, now)}.` }
+  }
+  if (!market) {
+    return { title: 'Trading closed', message: 'Trading has closed for this market.' }
+  }
+  const after = data.isBuy === false ? ', then the winning token sells for exactly $1.00' : ''
+  return {
+    title: 'Trading closed',
+    message: `Trading closed at ${formatMarketTime(market.cutoff, now)}. The market settles at ${formatMarketTime(market.info.expiry, now)}${after}.`,
+  }
+}
+
+/** Plain-language text for a failed outcome-token quote or swap */
+export function describePredictionError(data: PredictionErrorData, now: number = nowSeconds()): PredictionErrorText {
+  if (data.errorCode === PREDICTION_RPC_ERROR_CODE) {
+    return {
+      title: 'Price unavailable, retrying',
+      message: 'The Unichain Sepolia RPC did not answer. The price refreshes every second.',
+    }
+  }
+  const market = data.marketId ? getPredictionMarket(BigInt(data.marketId)) : undefined
+  const side = data.isYes === undefined ? 'This token' : data.isYes ? 'YES' : 'NO'
+  switch (data.predictionCode) {
+    case 'MARKET_CLOSED':
+      return describeClosedMarket({ data, market, now })
+    case 'OUT_OF_BAND':
+      return {
+        title: 'Price outside trading band',
+        message: `${side} would trade too close to $0 or $1, outside the band the market quotes. Try a smaller amount or wait for the price to move.`,
+      }
+    case 'CAPACITY':
+      return data.revert === 'EpochCapExceeded'
+        ? {
+            title: 'Amount too large',
+            message: 'The market takes a limited amount per block. Try a smaller amount.',
+          }
+        : {
+            title: 'Not enough liquidity',
+            message: "The market's reserve can't cover this trade. Try a smaller amount.",
+          }
+    case 'AMOUNT_TOO_LOW':
+      return { title: 'Enter a larger amount', message: 'The amount is too small to trade.' }
+    case 'ORACLE':
+      return {
+        title: 'Price feed unavailable',
+        message: 'The price oracle has no data right now. Try again in a few seconds.',
+      }
+    case 'SLIPPAGE':
+      return { title: 'Price moved', message: 'The price moved beyond your slippage tolerance. Review the new price.' }
+    case PREDICTION_USDC_ONLY_CODE:
+      return { title: 'Trade against USDC', message: 'YES and NO tokens trade only against USDC.' }
+    case 'NO_ROUTE':
+      return { title: 'Market unavailable', message: data.detail ?? 'This market pool does not exist.' }
+    default:
+      return {
+        title: 'Trade rejected',
+        message: `The market rejected this trade${data.detail ? ` (${data.detail})` : ''}. Try a smaller amount.`,
+      }
+  }
+}
+
+/** The swap-form warning for a failed outcome-token quote, or undefined for any other error */
+export function getPredictionSwapWarning(error: Error): Warning | undefined {
+  const data = getPredictionErrorData(error)
+  if (!data) {
+    return undefined
+  }
+  const { title, message } = describePredictionError(data)
+  return {
+    type:
+      data.predictionCode === 'AMOUNT_TOO_LOW'
+        ? WarningLabel.EnterLargerAmount
+        : data.predictionCode
+          ? WarningLabel.NoRoutesError
+          : WarningLabel.SwapRouterError,
+    severity: WarningSeverity.Low,
+    action: WarningAction.DisableReview,
+    title,
+    message,
+    // Testnet mode hides the form's warning row, so the button carries the reason
+    buttonText: title,
+  }
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/ui/predictionMarketLive.ts b/packages/uniswap/src/features/predictionMarkets/ui/predictionMarketLive.ts
new file mode 100644
index 0000000..1ea3498
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/ui/predictionMarketLive.ts
@@ -0,0 +1,110 @@
+import { queryOptions } from '@tanstack/react-query'
+import { getPredictionDeployment, PREDICTION_QUOTE_POLL_MS } from 'uniswap/src/features/predictionMarkets/config'
+import { getPredictionPublicClient } from 'uniswap/src/features/predictionMarkets/rpc'
+import {
+  type HookQuote,
+  type MarketInfo,
+  MarketStatus,
+  predictionHookAbi,
+  sameAddress,
+  wadToNumber,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import type { QueryOptionsResult } from 'utilities/src/reactQuery/queryOptions'
+import { type Address, parseAbi, zeroAddress } from 'viem'
+import { multicall, readContract } from 'viem/actions'
+
+const ORACLE_ABI = parseAbi(['function lnSpotSoBWad() view returns (int256)'])
+const MULTICALL_BLOCK_ABI = parseAbi([
+  'function getBlockNumber() view returns (uint256)',
+  'function getCurrentBlockTimestamp() view returns (uint256)',
+])
+
+export interface PredictionMarketRef {
+  hook: Address
+  marketId: bigint
+  /** The market's own oracle (`marketInfo.oracle`) when known; otherwise it is learned from the first read */
+  oracle?: Address
+}
+
+export interface PredictionMarketLive {
+  info: MarketInfo
+  quote?: HookQuote
+  /** The market's underlying (ETH, SOL) in USD from the market's own oracle, at the start of the latest block */
+  spotUsd?: number
+  /** The block these reads ran against */
+  block?: { number: bigint; timestamp: number }
+}
+
+/** `marketInfo.oracle` per `hook:marketId`, so every read after the first prices from the market's own oracle */
+const marketOracles = new Map<string, Address>()
+
+function lnSpotToUsd(lnSpot: bigint): number {
+  return Math.exp(wadToNumber(lnSpot))
+}
+
+/** `hook.marketInfo`, `hook.quote`, the market oracle's spot price and the block in one multicall */
+export async function readPredictionMarketLive(ref: PredictionMarketRef): Promise<PredictionMarketLive> {
+  const key = `${ref.hook.toLowerCase()}:${ref.marketId}`
+  const known = ref.oracle ?? marketOracles.get(key)
+  // A call to the zero address fails decoding, which leaves `spotUsd` empty
+  const oracle = known ?? zeroAddress
+  const { multicall3 } = getPredictionDeployment()
+  const client = getPredictionPublicClient()
+  const [info, quote, lnSpot, blockNumber, timestamp] = await multicall(client, {
+    contracts: [
+      { address: ref.hook, abi: predictionHookAbi, functionName: 'marketInfo', args: [ref.marketId] },
+      { address: ref.hook, abi: predictionHookAbi, functionName: 'quote', args: [ref.marketId] },
+      { address: oracle, abi: ORACLE_ABI, functionName: 'lnSpotSoBWad' },
+      { address: multicall3, abi: MULTICALL_BLOCK_ABI, functionName: 'getBlockNumber' },
+      { address: multicall3, abi: MULTICALL_BLOCK_ABI, functionName: 'getCurrentBlockTimestamp' },
+    ],
+    allowFailure: true,
+    multicallAddress: multicall3,
+  })
+  if (info.status !== 'success') {
+    throw info.error
+  }
+  const mi = info.result as MarketInfo
+  const marketOracle = sameAddress(mi.oracle, zeroAddress) ? undefined : mi.oracle
+  let spotUsd =
+    lnSpot.status === 'success' && sameAddress(oracle, marketOracle) ? lnSpotToUsd(lnSpot.result) : undefined
+  if (marketOracle && !sameAddress(oracle, marketOracle)) {
+    // First read of this market: price it from the oracle `marketInfo` names, then remember that oracle
+    marketOracles.set(key, marketOracle)
+    spotUsd = await readContract(client, { address: marketOracle, abi: ORACLE_ABI, functionName: 'lnSpotSoBWad' })
+      .then(lnSpotToUsd)
+      .catch(() => undefined)
+  }
+  return {
+    info: mi,
+    quote: quote.status === 'success' ? (quote.result as HookQuote) : undefined,
+    spotUsd,
+    block:
+      blockNumber.status === 'success' && timestamp.status === 'success'
+        ? { number: blockNumber.result, timestamp: Number(timestamp.result) }
+        : undefined,
+  }
+}
+
+export const PREDICTION_MARKET_LIVE_KEY = 'predictionMarketLive'
+
+type PredictionMarketLiveKey = [typeof PREDICTION_MARKET_LIVE_KEY, string | undefined, string | undefined]
+
+function isFinal(live: PredictionMarketLive | undefined): boolean {
+  return live?.info.status === MarketStatus.Settled || live?.info.status === MarketStatus.Invalid
+}
+
+/** Polls every second while mounted and the page is visible, and stops once the market is settled */
+export function predictionMarketLiveQueryOptions(
+  ref: PredictionMarketRef | undefined,
+): QueryOptionsResult<PredictionMarketLive, Error, PredictionMarketLive, PredictionMarketLiveKey> {
+  return queryOptions({
+    queryKey: [PREDICTION_MARKET_LIVE_KEY, ref?.hook, ref?.marketId.toString()] as PredictionMarketLiveKey,
+    queryFn: (): Promise<PredictionMarketLive> =>
+      ref ? readPredictionMarketLive(ref) : Promise.reject(new Error('no prediction market selected')),
+    enabled: !!ref,
+    refetchInterval: (query) => (isFinal(query.state.data) ? false : PREDICTION_QUOTE_POLL_MS),
+    refetchIntervalInBackground: false,
+    retry: 1,
+  })
+}
