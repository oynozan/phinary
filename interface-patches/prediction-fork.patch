+    type: 'v4-pool',
+    address: poolId(route.poolKey),
+    tokenIn,
+    tokenOut,
+    sqrtRatioX96: ONE_TO_ONE_SQRT_PRICE_X96,
+    liquidity: '0',
+    tickCurrent: '0',
+    fee: String(route.poolKey.fee),
+    tickSpacing: route.poolKey.tickSpacing,
+    hooks: route.poolKey.hooks,
+    amountIn: quoted.amountIn.toString(),
+    amountOut: quoted.amountOut.toString(),
+  }
+  return {
+    requestId: id,
+    routing: TradingApi.Routing.CLASSIC,
+    ...permit,
+    quote: {
+      chainId: params.tokenInChainId,
+      swapper: params.swapper,
+      tradeType: params.type,
+      input: { token: params.tokenIn, amount: quoted.amountIn.toString(), maximumAmount: maxIn.toString() },
+      output: {
+        token: params.tokenOut,
+        amount: quoted.amountOut.toString(),
+        minimumAmount: minOut.toString(),
+        recipient: params.swapper,
+      },
+      slippage,
+      gasFee: (gasUse * price).toString(),
+      gasUseEstimate: gasUse.toString(),
+      gasPrice: price.toString(),
+      route: [[hop]],
+      routeString: `[V4] ${tokenIn.symbol} --0%/PredictionHook--> ${tokenOut.symbol}`,
+      quoteId: id,
+      portionBips: 0,
+    },
+  }
+}
+
+/** Answers `/check_approval`: ERC20 -> Permit2 allowance (the Permit2 -> router leg is the quote's `permitData`). */
+export async function fetchPredictionApproval(
+  params: TradingApi.ApprovalRequest,
+): Promise<TradingApi.ApprovalResponse> {
+  const client = getPredictionPublicClient()
+  const d = getPredictionDeployment()
+  const token = params.token as Address
+  const allowance = await readContract(client, {
+    address: token,
+    abi: erc20Abi,
+    functionName: 'allowance',
+    args: [params.walletAddress as Address, d.permit2],
+  }).catch((error: unknown) => {
+    throw toPredictionFetchError(error)
+  })
+  if (allowance >= BigInt(params.amount)) {
+    return {
+      requestId: requestId(),
+      approval: null as unknown as NullableTransactionRequest,
+      cancel: null as unknown as NullableTransactionRequest,
+    }
+  }
+  const tx = erc20ApproveTx({ token, spender: d.permit2 })
+  return {
+    requestId: requestId(),
+    approval: {
+      to: tx.to,
+      from: params.walletAddress,
+      data: tx.data,
+      value: '0x00',
+      chainId: params.chainId,
+      gasLimit: PREDICTION_APPROVAL_GAS_LIMIT.toString(),
+    },
+    cancel: null as unknown as NullableTransactionRequest,
+    gasFee: (PREDICTION_APPROVAL_GAS_LIMIT * (await gasPrice(client))).toString(),
+    cancelGasFee: '0',
+  }
+}
+
+/**
+ * Answers `/swap`: UniversalRouter 2.0 `execute([PERMIT2_PERMIT,] V4_SWAP)` for the echoed quote. With
+ * `simulateTransaction` it runs `eth_estimateGas` and throws on revert, so the UI never submits a doomed swap.
+ * Without it (the app skips simulation until approvals are done) the gas limit is a generous fixed bound.
+ */
+export async function fetchPredictionSwap({
+  params,
+  quote,
+  route,
+}: {
+  params: TradingApi.CreateSwapRequest
+  quote: TradingApi.ClassicQuote
+  route: PredictionRoute
+}): Promise<TradingApi.CreateSwapResponse> {
+  const d = getPredictionDeployment()
+  const client = getPredictionPublicClient()
+  const exactIn = quote.tradeType === TradingApi.TradeType.EXACT_INPUT
+  const input = quote.input
+  const output = quote.output
+  const swapper = quote.swapper
+  if (!input?.amount || !output?.amount || !isConnected(swapper)) {
+    throw predictionFetchError({ detail: 'quote is missing amounts or swapper' })
+  }
+  const amount = BigInt(exactIn ? input.amount : output.amount)
+  const limit = BigInt(exactIn ? (output.minimumAmount ?? output.amount) : (input.maximumAmount ?? input.amount))
+  const permit =
+    params.signature && params.permitData
+      ? { permit: fromPermitData(params.permitData), signature: params.signature as Hex }
+      : undefined
+  let tx
+  try {
+    tx = buildSwap({
+      poolKey: route.poolKey,
+      zeroForOne: route.zeroForOne,
+      tradeType: exactIn ? 'EXACT_INPUT' : 'EXACT_OUTPUT',
+      amount,
+      limit,
+      deadline: BigInt(params.deadline ?? nowSeconds() + PREDICTION_DEFAULT_DEADLINE_SECONDS),
+      permit,
+      router: d.universalRouter,
+    })
+  } catch (error) {
+    throw predictionFetchError({ detail: error instanceof Error ? error.message : String(error), cause: error })
+  }
+  let gasLimit = unsimulatedGasLimit(quote)
+  if (params.simulateTransaction) {
+    try {
+      gasLimit = gasWithHeadroom(await estimateSwapGas(client, { tx, account: swapper }))
+    } catch (error) {
+      throw toPredictionFetchError(error, route)
+    }
+  }
+  return {
+    requestId: requestId(),
+    swap: {
+      to: tx.to,
+      from: swapper,
+      data: tx.data,
+      value: '0x00',
+      chainId: quote.chainId ?? (PREDICTION_CHAIN_ID as number as TradingApi.ChainId),
+      gasLimit: gasLimit.toString(),
+    },
+    gasFee: (gasLimit * (await gasPrice(client))).toString(),
+  }
+}
+
+function unsimulatedGasLimit(quote: TradingApi.ClassicQuote): bigint {
+  const quoted = quote.gasUseEstimate ? BigInt(quote.gasUseEstimate) : 0n
+  const scaled = 2n * quoted + PREDICTION_PERMIT_GAS_OVERHEAD
+  return scaled > PREDICTION_SWAP_GAS_LIMIT_FALLBACK ? scaled : PREDICTION_SWAP_GAS_LIMIT_FALLBACK
+}
+
+/** Answers `/swaps` for chain 1301 from receipts (the hosted API does not track our transactions). */
+export async function fetchPredictionSwapStatuses(txHashes: readonly string[]): Promise<TradingApi.GetSwapsResponse> {
+  const client = getPredictionPublicClient()
+  const swaps = await Promise.all(
+    txHashes.map(async (txHash) => {
+      try {
+        const receipt = await getTransactionReceipt(client, { hash: txHash as Hex })
+        const status = receipt.status === 'success' ? TradingApi.SwapStatus.SUCCESS : TradingApi.SwapStatus.FAILED
+        return { txHash, status, swapType: TradingApi.Routing.CLASSIC }
+      } catch {
+        return { txHash, status: TradingApi.SwapStatus.PENDING, swapType: TradingApi.Routing.CLASSIC }
+      }
+    }),
+  )
+  return { requestId: requestId(), swaps }
+}
+
+async function matchQuote(params: TradingApi.QuoteRequest): Promise<PredictionRoute | undefined> {
+  const chainIn = Number(params.tokenInChainId)
+  if (!isPredictionChain(chainIn) || chainIn !== Number(params.tokenOutChainId)) {
+    return undefined
+  }
+  const route = await resolvePredictionRoute(params.tokenIn, params.tokenOut)
+  if (route) {
+    return route
+  }
+  if (getPredictionToken(chainIn, params.tokenIn) || getPredictionToken(chainIn, params.tokenOut)) {
+    throw predictionUsdcOnlyError()
+  }
+  return undefined
+}
+
+async function matchSwapQuote(
+  quote: TradingApi.CreateSwapRequest['quote'],
+): Promise<{ quote: TradingApi.ClassicQuote; route: PredictionRoute } | undefined> {
+  if (!('input' in quote) || !('output' in quote) || !isPredictionChain(Number(quote.chainId))) {
+    return undefined
+  }
+  const classic = quote as TradingApi.ClassicQuote
+  const tokenIn = classic.input?.token
+  const tokenOut = classic.output?.token
+  if (!tokenIn || !tokenOut) {
+    return undefined
+  }
+  const route = await resolvePredictionRoute(tokenIn, tokenOut)
+  return route ? { quote: classic, route } : undefined
+}
+
+/**
+ * Wraps the Trading API client so USDC <-> YES/NO swaps on chain 1301 are quoted with V4Quoter and encoded for
+ * UniversalRouter 2.0 in the page. Every other request goes to the hosted API unchanged.
+ */
+export function withPredictionMarketOverrides<T extends TradingApiClient>(base: T): T {
+  const refuseBatched =
+    <P extends { quote: TradingApi.CreateSwapRequest['quote'] }, R>(fn: (p: P) => Promise<R>) =>
+    async (p: P): Promise<R> => {
+      if (await matchSwapQuote(p.quote)) {
+        throw predictionFetchError({
+          detail: 'Batched and smart-wallet swaps are not supported for prediction markets',
+        })
+      }
+      return fn(p)
+    }
+
+  return {
+    ...base,
+    fetchQuote: async (params): Promise<DiscriminatedQuoteResponse> => {
+      const route = await matchQuote(params)
+      return route ? fetchPredictionQuote({ params, route, indicative: false }) : base.fetchQuote(params)
+    },
+    fetchIndicativeQuote: async (params): Promise<DiscriminatedQuoteResponse> => {
+      const route = await matchQuote(params as TradingApi.QuoteRequest)
+      return route
+        ? fetchPredictionQuote({ params: params as TradingApi.QuoteRequest, route, indicative: true })
+        : base.fetchIndicativeQuote(params)
+    },
+    fetchCheckApproval: async (params): Promise<TradingApi.ApprovalResponse> => {
+      const chainId = Number(params.chainId)
+      const ours =
+        isPredictionChain(chainId) &&
+        (!!getPredictionToken(chainId, params.token) || !!getPredictionToken(chainId, params.tokenOut))
+      return ours ? fetchPredictionApproval(params) : base.fetchCheckApproval(params)
+    },
+    fetchSwap: async (params): Promise<TradingApi.CreateSwapResponse> => {
+      const match = await matchSwapQuote(params.quote)
+      return match ? fetchPredictionSwap({ params, quote: match.quote, route: match.route }) : base.fetchSwap(params)
+    },
+    fetchSwap5792: refuseBatched(base.fetchSwap5792),
+    fetchSwap7702: refuseBatched(base.fetchSwap7702),
+    fetchSwap4337: refuseBatched(base.fetchSwap4337),
+    fetchSwaps: async (params): Promise<TradingApi.GetSwapsResponse> => {
+      if (isPredictionChain(Number(params.chainId)) && params.txHashes?.length && !params.userOpHashes?.length) {
+        return fetchPredictionSwapStatuses(params.txHashes)
+      }
+      return base.fetchSwaps(params)
+    },
+    fetchCheckPermissions: async (params: CheckPermissionsRequest): Promise<CheckPermissionsResponse> => {
+      const chainId = Number(params.chainId)
+      if (isPredictionChain(chainId) && params.tokens.some((t) => getPredictionToken(chainId, t))) {
+        return { requestId: requestId(), results: params.tokens.map((token) => ({ token, isPermissioned: false })) }
+      }
+      return base.fetchCheckPermissions(params)
+    },
+  }
+}
