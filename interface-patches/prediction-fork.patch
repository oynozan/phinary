+    const mid = tau > 10n ? midAt(t) : 0n
+    return {
+      tradable: t < EXPIRY - 12,
+      tau,
+      varE36: 0n,
+      xWad: 0n,
+      midYes: mid,
+      askYes: mid,
+      bidYes: mid,
+      askNo: mid ? WAD - mid : 0n,
+      bidNo: mid ? WAD - mid : 0n,
+    }
+  },
+  marketInfo: (t: number) => ({
+    yes: zeroAddress,
+    no: zeroAddress,
+    oracle: zeroAddress,
+    lnStrikeWad: 0n,
+    openTime: BigInt(OPEN),
+    expiry: BigInt(EXPIRY),
+    window: 10,
+    cutoffBuffer: 2,
+    status: t >= SETTLED_AT ? MarketStatus.Settled : MarketStatus.Trading,
+    yesWon: false,
+    bucket: 0n,
+    outYes: 0n,
+    outNo: 0n,
+    invYes: 0n,
+    invNo: 0n,
+  }),
+})
+
+const multicallAbi = parseAbi([
+  'struct Call3 { address target; bool allowFailure; bytes callData; }',
+  'struct Result { bool success; bytes returnData; }',
+  'function aggregate3(Call3[] calls) payable returns (Result[] returnData)',
+  'function getBlockNumber() view returns (uint256)',
+  'function getCurrentBlockTimestamp() view returns (uint256)',
+])
+
+function execute(t: number, to: string, data: Hex): Hex {
+  if (to.toLowerCase() === HOOK.toLowerCase()) {
+    return hook(t, data)
+  }
+  if (to.toLowerCase() === getPredictionDeployment().multicall3.toLowerCase()) {
+    return multicall(t, data)
+  }
+  throw new Revert('0x')
+}
+
+const multicall = contract(multicallAbi, {
+  getBlockNumber: (t: number) => BigInt(t - GENESIS),
+  getCurrentBlockTimestamp: (t: number) => BigInt(t),
+  aggregate3: (t: number, calls: readonly { target: Address; callData: Hex }[]) =>
+    calls.map((c) => {
+      try {
+        return { success: true, returnData: execute(t, c.target, c.callData) }
+      } catch (e) {
+        return { success: false, returnData: e instanceof Revert ? e.data : '0x' }
+      }
+    }),
+})
+
+const requests: { block: number | 'latest' }[] = []
+const client = createClient({
+  chain: unichainSepolia,
+  transport: custom(
+    {
+      async request({ method, params }: { method: string; params: unknown[] }) {
+        if (method === 'eth_chainId') {
+          return '0x515'
+        }
+        if (method !== 'eth_call') {
+          throw new Error(`unsupported ${method}`)
+        }
+        const [tx, tag] = params as [{ to: string; data?: Hex; input?: Hex }, string]
+        const t = tag === 'latest' ? head : Number(hexToBigInt(tag as Hex)) + GENESIS
+        requests.push({ block: tag === 'latest' ? 'latest' : t - OPEN })
+        if (t > head) {
+          throw new Error('header not found')
+        }
+        if (failBlocks.has(t)) {
+          failBlocks.delete(t)
+          throw new Error('upstream timeout')
+        }
+        if (brokenBlocks.has(t)) {
+          throw new Error('missing trie node')
+        }
+        try {
+          return execute(t, tx.to, (tx.data ?? tx.input) as Hex)
+        } catch (e) {
+          if (e instanceof Revert) {
+            throw new RpcRequestError({
+              body: {},
+              url: 'mock://',
+              error: { code: 3, message: 'execution reverted', data: e.data },
+            })
+          }
+          throw e
+        }
+      },
+    },
+    { retryCount: 0 },
+  ),
+})
+
+describe('prediction market price history', () => {
+  beforeEach(() => {
+    localStorage.setItem(PREDICTION_HOOK_STORAGE_KEY, HOOK)
+    setPredictionPublicClient(client)
+    resetMarketHistories()
+    failBlocks.clear()
+    brokenBlocks.clear()
+    requests.length = 0
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  afterAll(() => {
+    localStorage.removeItem(PREDICTION_HOOK_STORAGE_KEY)
+    setPredictionPublicClient(undefined)
+  })
+
+  it('rebuilds the history from quotes at past blocks, skipping blocks before the market existed', async () => {
+    head = OPEN + 20
+    const snap = await loadMarketHistory(1n)
+    expect(snap.loading).toBe(false)
+    expect(snap.points.map((p) => p.time)).toEqual(Array.from({ length: 18 }, (_, i) => CREATED + i))
+    expect(snap.points.every((p) => p.midYes === midAt(p.time))).toBe(true)
+    // One multicall at the head, then one eth_call per earlier block
+    expect(requests.filter((r) => r.block === 'latest')).toHaveLength(1)
+    expect(requests.filter((r) => r.block !== 'latest')).toHaveLength(20)
+
+    const yes = buildPredictionSeries({ points: snap.points, isYes: true, market: snap.market })
+    const no = buildPredictionSeries({ points: snap.points, isYes: false, market: snap.market })
+    expect(yes.at(-1)).toEqual({ time: OPEN + 20, value: 0.7 })
+    expect(no.at(-1)?.value).toBeCloseTo(0.3, 12)
+  })
+
+  it('reads only the new blocks on the next poll', async () => {
+    head = OPEN + 20
+    await loadMarketHistory(1n)
+    requests.length = 0
+    head = OPEN + 22
+    const snap = await loadMarketHistory(1n)
+    expect(requests).toEqual([{ block: 'latest' }, { block: 21 }])
+    expect(snap.points.at(-1)?.time).toBe(OPEN + 22)
+  })
+
+  it('retries blocks whose read failed for a non-revert reason, after a backoff', async () => {
+    vi.useFakeTimers({ toFake: ['Date'] })
+    head = OPEN + 10
+    failBlocks.add(OPEN + 6)
+    const first = await loadMarketHistory(1n)
+    expect(first.points.map((p) => p.time)).not.toContain(OPEN + 6)
+
+    requests.length = 0
+    await loadMarketHistory(1n)
+    expect(requests).toEqual([{ block: 'latest' }])
+
+    vi.setSystemTime(Date.now() + historyRetryDelayMs(1))
+    const third = await loadMarketHistory(1n)
+    expect(third.points.map((p) => p.time)).toContain(OPEN + 6)
+  })
+
+  it('backs off exponentially up to 30 s', () => {
+    expect([1, 2, 3, 4, 5, 6].map(historyRetryDelayMs)).toEqual([3_000, 6_000, 12_000, 24_000, 30_000, 30_000])
+  })
+
+  it('gives up on a block that keeps failing, so a settled market still completes', async () => {
+    vi.useFakeTimers({ toFake: ['Date'] })
+    head = SETTLED_AT + 60
+    brokenBlocks.add(OPEN + 20)
+    let reads = 0
+    for (let attempt = 1; attempt <= 4; attempt++) {
+      requests.length = 0
+      await loadMarketHistory(1n)
+      reads += requests.filter((r) => r.block === 20).length
+      vi.setSystemTime(Date.now() + historyRetryDelayMs(attempt))
+    }
+    expect(reads).toBe(4)
+    requests.length = 0
+    const snap = await loadMarketHistory(1n)
+    expect(requests.filter((r) => r.block !== 'latest')).toEqual([])
+    expect(snap.points.map((p) => p.time)).not.toContain(OPEN + 20)
+    expect(snap.points).toHaveLength(EXPIRY - 11 - CREATED)
+  })
+
+  it('stops the series at expiry - window and ends it at the payout after settlement', async () => {
+    head = OPEN + 30
+    await loadMarketHistory(1n)
+
+    head = EXPIRY + 1
+    const pending = await loadMarketHistory(1n)
+    expect(pending.market?.status).toBe(MarketStatus.Trading)
+    expect(pending.points.at(-1)?.time).toBe(EXPIRY - 11)
+    expect(buildPredictionSeries({ points: pending.points, isYes: true, market: pending.market }).at(-1)?.time).toBe(
+      EXPIRY - 11,
+    )
+
+    head = SETTLED_AT
+    requests.length = 0
+    const settled = await loadMarketHistory(1n)
+    expect(requests).toEqual([{ block: 'latest' }])
+    const yes = buildPredictionSeries({ points: settled.points, isYes: true, market: settled.market })
+    const no = buildPredictionSeries({ points: settled.points, isYes: false, market: settled.market })
+    expect(yes.at(-1)).toEqual({ time: EXPIRY, value: 0 })
+    expect(no.at(-1)).toEqual({ time: EXPIRY, value: 1 })
+    expect(yes).toHaveLength(EXPIRY - 11 - CREATED + 2)
+  })
+
+  it("reuses the market panel's live read of the latest block", async () => {
+    head = OPEN + 20
+    await SharedQueryClient.fetchQuery(predictionMarketLiveQueryOptions({ hook: HOOK, marketId: 1n }))
+    requests.length = 0
+    const unsubscribe = subscribeMarketHistory(1n, () => undefined)
+    await waitFor(() => expect(requests.filter((r) => r.block !== 'latest')).toHaveLength(20))
+    unsubscribe()
+    expect(requests.filter((r) => r.block === 'latest')).toEqual([])
+  })
+
+  it('pauses polling while the page is hidden and resumes when it is shown', async () => {
+    head = OPEN + 20
+    const visibility = vi.spyOn(document, 'visibilityState', 'get').mockReturnValue('hidden')
+    const unsubscribe = subscribeMarketHistory(1n, () => undefined)
+    await waitFor(() => expect(requests.filter((r) => r.block === 'latest')).toHaveLength(1))
+    await new Promise((resolve) => setTimeout(resolve, 2_500))
+    expect(requests.filter((r) => r.block === 'latest')).toHaveLength(1)
+
+    visibility.mockReturnValue('visible')
+    head = OPEN + 22
+    document.dispatchEvent(new Event('visibilitychange'))
+    await waitFor(() => expect(requests.filter((r) => r.block === 'latest')).toHaveLength(2))
+    unsubscribe()
+    visibility.mockRestore()
+  }, 10_000)
+
+  it('loads a settled market in one pass', async () => {
+    head = SETTLED_AT + 3600
+    const snap = await loadMarketHistory(1n)
+    expect(snap.points).toHaveLength(EXPIRY - 11 - CREATED + 1)
+    expect(snap.market?.status).toBe(MarketStatus.Settled)
+    expect(requests.filter((r) => r.block !== 'latest')).toHaveLength(50)
+  })
+})
+
+describe('usePredictionPriceHistory', () => {
