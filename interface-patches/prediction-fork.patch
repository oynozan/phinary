+/** Permit2 -> router leg, a PermitSingle or with `asTransaction` a `Permit2.approve` tx, none if already allowed */
+async function permitFor({
+  client,
+  owner,
+  token,
+  amount,
+  asTransaction,
+  price,
+}: {
+  client: Client
+  owner: Address
+  token: Address
+  amount: bigint
+  asTransaction: boolean
+  price: Promise<bigint>
+}): Promise<PermitFields> {
+  const d = getPredictionDeployment()
+  const allowance = await readAllowances(client, {
+    owner,
+    token,
+    amount,
+    spender: d.universalRouter,
+    permit2: d.permit2,
+  })
+  if (!allowance.needsPermit) {
+    return { permitData: null }
+  }
+  if (!asTransaction) {
+    return {
+      permitData: toPermitData(
+        buildPermitSingle({ token, nonce: allowance.permit2Nonce, spender: d.universalRouter, now: nowSeconds() }),
+      ),
+    }
+  }
+  const tx = permit2ApproveTx({
+    token,
+    spender: d.universalRouter,
+    permit2: d.permit2,
+    expiration: nowSeconds() + PREDICTION_PERMIT2_APPROVE_SECONDS,
+  })
+  return {
+    permitData: null,
+    permitTransaction: {
+      to: tx.to,
+      from: owner,
+      data: tx.data,
+      value: '0x00',
+      chainId: PREDICTION_CHAIN_ID as number as TradingApi.ChainId,
+      gasLimit: PREDICTION_PERMIT2_APPROVE_GAS_LIMIT.toString(),
+    },
+    permitGasFee: (PREDICTION_PERMIT2_APPROVE_GAS_LIMIT * (await price)).toString(),
+  }
+}
+
+/**
+ * Auto slippage (percent) for a quote: sized to how far this market's price can move before the swap lands, so the
+ * last minute of a short market gets tens of percent. Settled markets redeem at a fixed price.
+ */
+export function predictionAutoSlippagePercent({
+  route,
+  quoted,
+  now = nowSeconds(),
+}: {
+  route: PredictionRoute
+  quoted: Pick<QuoteResult, 'exactIn' | 'amountIn' | 'amountOut'>
+  now?: number
+}): number {
+  const market = getPredictionMarket(route.token.marketId)
+  if (!market) {
+    return PREDICTION_FALLBACK_SLIPPAGE_PERCENT
+  }
+  const settled = market.status === 'Settled' || market.status === 'Invalid'
+  const bps = autoSlippageBps({
+    exactIn: quoted.exactIn,
+    isBuy: route.isBuy,
+    amountIn: quoted.amountIn,
+    amountOut: quoted.amountOut,
+    secondsToWindow: settled ? Number.MAX_SAFE_INTEGER : Number(market.info.expiry) - market.info.window - now,
+    confirmSeconds: PREDICTION_CONFIRM_SECONDS,
+  })
+  return bps / 100
+}
