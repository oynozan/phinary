+++ b/packages/uniswap/src/features/predictionMarkets/tracks.ts
@@ -0,0 +1,278 @@
+import type { PredictionUnderlying } from 'uniswap/src/features/predictionMarkets/config'
+import {
+  type Market,
+  type MarketInfo,
+  MarketStatus,
+  type MarketStatusName,
+  OUTCOME_DECIMALS,
+  type OutcomeTokenInfo,
+  type PoolKey,
+  predictionHookAbi,
+  sameAddress,
+  strikeUsdFromLn,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import { type Address, type Client, erc20Abi, parseAbi, zeroAddress } from 'viem'
+import { multicall } from 'viem/actions'
+
+export const MARKET_GATEKEEPER_ABI = parseAbi([
+  'function schedulers() view returns (address[])',
+  'function schedulerOf(uint256 marketId) view returns (address)',
+])
+
+export const TRACK_SCHEDULER_ABI = parseAbi([
+  'struct QuoteParams { uint64 h0Wad; uint64 gammaSWad; uint128 lambdaWad; uint128 qEpochMax; uint64 pMinWad; }',
+  'struct Config { uint32 period; uint32 tenor; uint32 window; uint32 cutoffBuffer; uint32 nSamples; QuoteParams quote; uint256 maxBudget; uint256 minBudget; string ticker; }',
+  'function config() view returns (Config)',
+  'function oracle() view returns (address)',
+  'function marketOfSlot(uint256 slot) view returns (uint256)',
+])
+
+/** One MarketScheduler: a fixed asset, cadence and market length */
+export interface PredictionTrack {
+  scheduler: Address
+  oracle?: Address
+  /** "ETH1M"; the YES/NO symbols are the ticker plus UP/DOWN */
+  ticker: string
+  /** "ETH", "SOL" */
+  asset: string
+  periodSec: number
+  tenorSec: number
+  /** Market length, "1-minute" */
+  duration: string
+  /** "ETH 1-minute" */
+  label: string
+}
+
+const UNITS: [number, string][] = [
+  [86_400, 'day'],
+  [3_600, 'hour'],
+  [60, 'minute'],
+]
+
+/** A market length as a compound adjective: 60 -> "1-minute", 900 -> "15-minute", 90 -> "90-second" */
+export function formatTrackDuration(seconds: number): string {
+  for (const [size, unit] of UNITS) {
+    if (seconds >= size && seconds % size === 0) {
+      return `${seconds / size}-${unit}`
+    }
+  }
+  return `${seconds}-second`
+}
+
+/** The asset a ticker names, without its period suffix: "ETH15M" -> "ETH", "SOL1M" -> "SOL", "ETH" -> "ETH" */
+export function assetFromTicker(ticker: string): string {
+  return ticker.replace(/\d+[SMHD]$/i, '') || ticker
+}
+
+/** The ticker an outcome-token symbol was built from ("ETH15MDOWN" -> "ETH15M"), or undefined */
+export function tickerFromOutcomeSymbol(symbol: string | undefined): string | undefined {
+  const match = symbol ? /^(.+?)(UP|DOWN)$/.exec(symbol) : null
+  return match?.[1]
+}
+
+export function underlyingForOracle(
+  underlyings: readonly PredictionUnderlying[],
+  oracle: string | undefined,
+): PredictionUnderlying | undefined {
+  return oracle && !sameAddress(oracle, zeroAddress)
+    ? underlyings.find((u) => sameAddress(u.oracle, oracle))
+    : undefined
+}
+
+/**
+ * The asset a market is on: its track's, else the deployment underlying behind its oracle, else the one its outcome
+ * symbol names ("SOL15MUP" -> "SOL").
+ */
+export function predictionMarketAsset(p: {
+  track?: PredictionTrack
+  oracle?: string
+  symbol?: string
+  underlyings: readonly PredictionUnderlying[]
+}): string | undefined {
+  const ticker = tickerFromOutcomeSymbol(p.symbol)
+  return (
+    p.track?.asset ??
+    underlyingForOracle(p.underlyings, p.oracle)?.symbol ??
+    (ticker ? assetFromTicker(ticker) : undefined)
+  )
+}
+
+export function makePredictionTrack(p: {
+  scheduler: Address
+  oracle?: Address
+  ticker: string
+  periodSec: number
+  tenorSec: number
+  underlyings: readonly PredictionUnderlying[]
+}): PredictionTrack {
+  const asset = underlyingForOracle(p.underlyings, p.oracle)?.symbol ?? assetFromTicker(p.ticker)
+  const duration = formatTrackDuration(p.tenorSec)
+  return {
+    scheduler: p.scheduler,
+    oracle: p.oracle,
+    ticker: p.ticker,
+    asset,
+    periodSec: p.periodSec,
+    tenorSec: p.tenorSec,
+    duration,
+    label: `${asset} ${duration}`,
+  }
+}
+
+/** By asset in order of first appearance, then by period and market length: ETH 1m, ETH 15m, SOL 1m, SOL 15m */
+export function sortPredictionTracks(tracks: readonly PredictionTrack[]): PredictionTrack[] {
+  const assetRank = new Map<string, number>()
+  for (const t of tracks) {
+    if (!assetRank.has(t.asset)) {
+      assetRank.set(t.asset, assetRank.size)
+    }
+  }
+  return [...tracks].sort(
+    (a, b) =>
+      (assetRank.get(a.asset) ?? 0) - (assetRank.get(b.asset) ?? 0) ||
+      a.periodSec - b.periodSec ||
+      a.tenorSec - b.tenorSec,
+  )
+}
+
+/**
+ * The track whose ticker built `symbol` exactly (`ticker + "UP"` or `ticker + "DOWN"`). Never a prefix match: "ETH" is
+ * a prefix of "ETH15M", and markets of different tracks can share an expiry.
+ */
+export function classifyBySymbol(
+  symbol: string | undefined,
+  tracks: readonly PredictionTrack[],
+): PredictionTrack | undefined {
+  return symbol ? tracks.find((t) => symbol === `${t.ticker}UP` || symbol === `${t.ticker}DOWN`) : undefined
+}
+
+/**
+ * Reads each scheduler's `config()` and `oracle()`. With a gatekeeper, its `schedulers()` list wins over `schedulers`.
+ * Schedulers whose config cannot be read are left out.
+ */
+export async function readPredictionTracks(
+  client: Client,
+  p: {
+    gatekeeper?: Address
+    schedulers: readonly Address[]
+    underlyings: readonly PredictionUnderlying[]
+    multicallAddress: Address
+  },
+): Promise<PredictionTrack[]> {
+  let schedulers = [...p.schedulers]
+  if (p.gatekeeper) {
+    const [listed] = await multicall(client, {
+      contracts: [{ address: p.gatekeeper, abi: MARKET_GATEKEEPER_ABI, functionName: 'schedulers' }],
+      allowFailure: true,
+      multicallAddress: p.multicallAddress,
+    })
+    if (listed.status === 'success' && listed.result.length) {
+      schedulers = [...listed.result]
+    }
+  }
+  if (!schedulers.length) {
+    return []
+  }
+  const results = await multicall(client, {
+    contracts: schedulers.flatMap((address) => [
+      { address, abi: TRACK_SCHEDULER_ABI, functionName: 'config' } as const,
+      { address, abi: TRACK_SCHEDULER_ABI, functionName: 'oracle' } as const,
+    ]),
+    allowFailure: true,
+    multicallAddress: p.multicallAddress,
+  })
+  const tracks: PredictionTrack[] = []
+  schedulers.forEach((scheduler, i) => {
+    const config = results[i * 2]
+    const oracle = results[i * 2 + 1]
+    if (config?.status !== 'success') {
+      return
+    }
+    const c = config.result as { period: number; tenor: number; ticker: string }
+    tracks.push(
+      makePredictionTrack({
+        scheduler,
+        oracle: oracle?.status === 'success' ? (oracle.result as Address) : undefined,
+        ticker: c.ticker,
+        periodSec: Number(c.period),
+        tenorSec: Number(c.tenor),
+        underlyings: p.underlyings,
+      }),
+    )
+  })
+  return sortPredictionTracks(tracks)
+}
+
+const STATUS_NAMES: MarketStatusName[] = ['None', 'Trading', 'Settled', 'Invalid']
+
+/** `listMarkets` for arbitrary ids: `marketInfo`, `poolKeys` and the YES/NO symbol and name. Unknown ids are skipped. */
+export async function readPredictionMarketsByIds(
+  client: Client,
+  p: { hook: Address; ids: readonly bigint[]; multicallAddress: Address },
+): Promise<Market[]> {
+  if (!p.ids.length) {
+    return []
+  }
+  const results = await multicall(client, {
+    contracts: p.ids.flatMap((id) => [
+      { address: p.hook, abi: predictionHookAbi, functionName: 'marketInfo', args: [id] } as const,
+      { address: p.hook, abi: predictionHookAbi, functionName: 'poolKeys', args: [id] } as const,
+    ]),
+    allowFailure: true,
+    multicallAddress: p.multicallAddress,
+  })
+  const found: { id: bigint; info: MarketInfo; keys: readonly [PoolKey, PoolKey] }[] = []
+  p.ids.forEach((id, i) => {
+    const info = results[i * 2]
+    const keys = results[i * 2 + 1]
+    if (info?.status !== 'success' || keys?.status !== 'success') {
+      return
+    }
+    const mi = info.result as MarketInfo
+    if (mi.status === MarketStatus.None || sameAddress(mi.yes, zeroAddress)) {
+      return
+    }
+    found.push({ id, info: mi, keys: keys.result as readonly [PoolKey, PoolKey] })
+  })
+  if (!found.length) {
+    return []
+  }
+  const meta = await multicall(client, {
+    contracts: found.flatMap((m) =>
+      [m.info.yes, m.info.no].flatMap((address) => [
+        { address, abi: erc20Abi, functionName: 'symbol' } as const,
+        { address, abi: erc20Abi, functionName: 'name' } as const,
+      ]),
+    ),
+    allowFailure: true,
+    multicallAddress: p.multicallAddress,
+  })
+  const text = (j: number): string | undefined => {
+    const r = meta[j]
+    return r?.status === 'success' ? (r.result as string) : undefined
+  }
+  return found.map((m, i) => {
+    const token = (isYes: boolean): OutcomeTokenInfo => {
+      const j = i * 4 + (isYes ? 0 : 2)
+      return {
+        address: isYes ? m.info.yes : m.info.no,
+        symbol: text(j) ?? `${isYes ? 'YES' : 'NO'}-${m.id}`,
+        name: text(j + 1) ?? `${isYes ? 'Yes' : 'No'} #${m.id}`,
+        decimals: OUTCOME_DECIMALS,
+        isYes,
+        marketId: m.id,
+        poolKey: isYes ? m.keys[0] : m.keys[1],
+      }
+    }
+    return {
+      id: m.id,
+      hook: p.hook,
+      info: m.info,
+      status: STATUS_NAMES[m.info.status] ?? 'None',
+      strikeUsd: strikeUsdFromLn(m.info.lnStrikeWad),
+      cutoff: m.info.expiry - BigInt(m.info.window) - BigInt(m.info.cutoffBuffer),
+      yes: token(true),
+      no: token(false),
+    }
+  })
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/tradingApiFormat.ts b/packages/uniswap/src/features/predictionMarkets/tradingApiFormat.ts
new file mode 100644
index 0000000..7e4296b
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/tradingApiFormat.ts
@@ -0,0 +1,213 @@
+import { FetchError, TradingApi } from '@universe/api'
+import { getPredictionDeployment } from 'uniswap/src/features/predictionMarkets/config'
+import { getPredictionMarket, type PredictionRoute } from 'uniswap/src/features/predictionMarkets/registry'
+import {
+  decodeRevert,
+  PERMIT2_DOMAIN_NAME,
+  PERMIT_SINGLE_TYPES,
+  type PermitSingle,
+  PredictionSwapError,
+  toSwapError,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import { isPredictionMarketClosing } from 'uniswap/src/features/predictionMarkets/ui/marketStatus'
+import { type Abi, type Address, parseAbi } from 'viem'
+
+/** PredictionHook's own errors, which the vendored SDK ABIs lack */
+export const PREDICTION_HOOK_ERRORS_ABI: Abi = parseAbi([
+  'error Unauthorized()',
+  'error InvalidParams()',
+  'error UnsupportedKernel()',
+  'error UnknownMarket()',
+  'error UnknownPool()',
+  'error NotTradable()',
+  'error MarketClosed()',
+  'error NotSettled()',
+  'error TooEarly()',
+  'error OracleAvailable()',
+  'error OutOfBand()',
+  'error EpochCapExceeded()',
+  'error Insolvent()',
+  'error ZeroAmount()',
+  'error InsufficientIdle()',
+  'error InsufficientShares()',
+  'error ForeignInitialize()',
+  'error LiquidityDisabled()',
+  'error DonateDisabled()',
+])
+
+export const PREDICTION_RPC_ERROR_CODE = 'PredictionRpcError'
+
+/** `predictionCode` for an outcome token paired with anything but USDC */
+export const PREDICTION_USDC_ONLY_CODE = 'USDC_ONLY'
+
+/** What a prediction-market `FetchError` carries in `data`, next to the Trading API's `errorCode` and `detail` */
+export interface PredictionErrorData {
+  errorCode?: string
+  detail?: string
+  /** A revert's `RevertCode` or `USDC_ONLY`, absent for RPC failures */
+  predictionCode?: string
+  /** Innermost decoded revert name such as `NotTradable` */
+  revert?: string
+  marketId?: string
+  isYes?: boolean
+  isBuy?: boolean
+}
+
+function routeContext(route: PredictionRoute | undefined): Pick<PredictionErrorData, 'marketId' | 'isYes' | 'isBuy'> {
+  return route ? { marketId: route.token.marketId.toString(), isYes: route.token.isYes, isBuy: route.isBuy } : {}
+}
+
+/** The prediction-market details of a quote or swap error, or undefined for any other error */
+export function getPredictionErrorData(error: unknown): PredictionErrorData | undefined {
+  if (!(error instanceof FetchError)) {
+    return undefined
+  }
+  const data = error.data as PredictionErrorData | undefined
+  return data?.predictionCode || data?.errorCode === PREDICTION_RPC_ERROR_CODE ? data : undefined
+}
+
+/** True when the hook rejected the quote (closed market, out of band, too large), so a retry fails too */
+export function isPredictionQuoteRejection(error: unknown): boolean {
+  return !!getPredictionErrorData(error)?.predictionCode
+}
+
+/** True when the market is settled or voided (`MarketClosed`), so the pair never quotes again */
+export function isFinalPredictionRejection(error: unknown): boolean {
+  return getPredictionErrorData(error)?.revert === 'MarketClosed'
+}
+
+/** React Query `retry` for outcome-token quotes, one retry like other quotes and none after a hook rejection */
+export function shouldRetryPredictionQuote(failureCount: number, error: unknown): boolean {
+  return failureCount < 1 && !isPredictionQuoteRejection(error)
+}
+
+/** `revert` of the app's own rejection of a quote in the last seconds before the cutoff */
+export const PREDICTION_CLOSING_REVERT = 'TradingClosing'
+
+/** A `FetchError` the swap form maps to a warning: 404 ResourceNotFound ("No routes found") or QuoteAmountTooLowError. */
+export function predictionFetchError({
+  detail,
+  errorCode = TradingApi.Err404.errorCode.RESOURCE_NOT_FOUND,
+  extra = {},
+  cause,
+}: {
+  detail: string
+  errorCode?: TradingApi.Err404.errorCode
+  extra?: Record<string, unknown>
+  cause?: unknown
+}): FetchError {
+  return new FetchError({ response: new Response(null, { status: 404 }), data: { errorCode, detail, ...extra }, cause })
+}
+
+/** Thrown for an outcome token paired with anything but USDC */
+export function predictionUsdcOnlyError(): FetchError {
+  return predictionFetchError({
+    detail: 'Prediction tokens trade only against USDC',
+    extra: { predictionCode: PREDICTION_USDC_ONLY_CODE },
+  })
+}
+
+/** Thrown for a quote so close to the cutoff that the swap would land after it and revert `NotTradable` */
+export function predictionClosingError(route: PredictionRoute): FetchError {
+  return predictionFetchError({
+    detail: 'Trading closes too soon for a swap to confirm',
+    extra: { predictionCode: 'MARKET_CLOSED', revert: PREDICTION_CLOSING_REVERT, ...routeContext(route) },
+  })
+}
+
+/** Refuses a quote for a market in its last seconds of trading, see `isPredictionMarketClosing` */
+export function assertPredictionMarketNotClosing(route: PredictionRoute, now: number): void {
+  const market = getPredictionMarket(route.token.marketId)
+  if (market?.status === 'Trading' && isPredictionMarketClosing(market.cutoff, now)) {
+    throw predictionClosingError(route)
+  }
+}
+
+/** Names a hook revert that the vendored SDK decoded without our hook ABI, by selector only */
+function withHookErrorNames(swapError: PredictionSwapError): PredictionSwapError {
+  const revert = swapError.revert
+  if (!revert || revert.name) {
+    return swapError
+  }
+  const decoded = decodeRevert(revert.raw, PREDICTION_HOOK_ERRORS_ABI)
+  return decoded.name
+    ? new PredictionSwapError({ message: decoded.message, code: decoded.code, revert: decoded, cause: swapError })
+    : swapError
+}
+
+/** Quote/simulation failure as a `FetchError` tagged with `route`, never 412-429 which reads as rate limiting */
+export function toPredictionFetchError(error: unknown, route?: PredictionRoute): FetchError {
+  if (error instanceof FetchError) {
+    return error
+  }
+  let swapError: PredictionSwapError | undefined
+  try {
+    swapError = withHookErrorNames(toSwapError(error, PREDICTION_HOOK_ERRORS_ABI))
+  } catch {
+    swapError = undefined
+  }
+  if (!swapError) {
+    const detail = error instanceof Error ? error.message : String(error)
+    return new FetchError({
+      response: new Response(null, { status: 500 }),
+      data: { errorCode: PREDICTION_RPC_ERROR_CODE, detail, ...routeContext(route) },
+      cause: error,
+    })
+  }
+  const errorCode =
+    swapError.code === 'AMOUNT_TOO_LOW'
+      ? TradingApi.Err404.errorCode.QUOTE_AMOUNT_TOO_LOW_ERROR
+      : TradingApi.Err404.errorCode.RESOURCE_NOT_FOUND
+  return predictionFetchError({
+    detail: swapError.message,
+    errorCode,
+    extra: { predictionCode: swapError.code, revert: swapError.revert?.name, ...routeContext(route) },
+    cause: error,
+  })
+}
+
+/** Permit2 `PermitSingle` in the Trading API's `permitData` shape (decimal strings), ready for `eth_signTypedData_v4`. */
+export function toPermitData(permit: PermitSingle): TradingApi.Permit {
+  const d = getPredictionDeployment()
+  return {
+    domain: { name: PERMIT2_DOMAIN_NAME, chainId: d.chainId, verifyingContract: d.permit2 },
+    types: {
+      PermitSingle: PERMIT_SINGLE_TYPES.PermitSingle.map((f) => ({ ...f })),
+      PermitDetails: PERMIT_SINGLE_TYPES.PermitDetails.map((f) => ({ ...f })),
+    },
+    values: {
+      details: {
+        token: permit.details.token,
+        amount: permit.details.amount.toString(),
+        expiration: permit.details.expiration.toString(),
+        nonce: permit.details.nonce.toString(),
+      },
+      spender: permit.spender,
+      sigDeadline: permit.sigDeadline.toString(),
+    },
+  }
+}
+
+/** Inverse of `toPermitData` for the `permitData` the app echoes back to `/swap`. */
+export function fromPermitData(permitData: TradingApi.Permit): PermitSingle {
+  const values = permitData.values as
+    | {
+        details: { token: Address; amount: string; expiration: string | number; nonce: string | number }
+        spender: Address
+        sigDeadline: string
+      }
+    | undefined
+  if (!values) {
+    throw predictionFetchError({ detail: 'permitData.values missing' })
+  }
+  return {
+    details: {
+      token: values.details.token,
+      amount: BigInt(values.details.amount),
+      expiration: Number(values.details.expiration),
+      nonce: Number(values.details.nonce),
+    },
+    spender: values.spender,
+    sigDeadline: BigInt(values.sigDeadline),
+  }
+}
