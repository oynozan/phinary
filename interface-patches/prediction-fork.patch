+
+  it('groups the picker by track: open markets per track, settled markets of every track together', async () => {
+    await refreshPredictionRegistry()
+    const { open, settled } = selectPredictionMarketsForPicker(getPredictionMarkets(), {
+      nowSeconds: NOW,
+      tracks: getPredictionTracks(),
+      trackOf: getPredictionMarketTrack,
+    })
+    expect(open.map((g) => [g.name, g.markets.map((m) => m.id)])).toEqual([
+      ['ETH 1-minute', [44n]],
+      ['ETH 15-minute', [3n]],
+      ['SOL 1-minute', [45n]],
+      ['SOL 15-minute', [4n]],
+    ])
+    // Newest two per track, newest expiry first (ties in track order); the older 15-minute markets come last
+    expect(settled.map((m) => m.id)).toEqual([42n, 43n, 40n, 41n, 5n, 1n, 2n])
+  })
+
+  it('gives the token selector one section per track and USDC once', async () => {
+    await refreshPredictionRegistry()
+    const { result, unmount } = renderHook(() => usePredictionTokenOptions(1301))
+    await act(async () => {
+      await refreshPredictionRegistry()
+    })
+    const open = result.current.open ?? []
+    expect(open.map((s) => s.name)).toEqual([
+      'Prediction markets',
+      'ETH 1-minute',
+      'ETH 15-minute',
+      'SOL 1-minute',
+      'SOL 15-minute',
+    ])
+    expect(new Set(open.map((s) => s.id)).size).toBe(open.length)
+    const symbols = open.map((s) => s.options.map((o) => o.currencyInfo.currency.symbol))
+    expect(symbols).toEqual([
+      ['USDC'],
+      ['ETH1MUP', 'ETH1MDOWN'],
+      ['ETH15MUP', 'ETH15MDOWN'],
