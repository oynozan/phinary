+
+async function refreshOnce(hook: Address): Promise<void> {
+  const client = getPredictionPublicClient()
+  const d = getPredictionDeployment()
+  const [list] = await Promise.all([
+    listMarkets(client, {
+      hook,
+      limit: PREDICTION_REGISTRY_WINDOW,
+      quotes: false,
+      multicallAddress: d.multicall3,
+    }),
+    ensureTracks(client, d).catch((error: unknown) => {
+      logger.warn('predictionMarkets/registry', 'ensureTracks', 'market track read failed', { error })
+    }),
+  ])
+  registerPredictionMarkets(list)
+  await refreshTrackMarkets({ client, d, hook, list })
+}
+
+/**
+ * Reads the newest markets from the hook, the market tracks once, and each track's recent markets. No-op until a
+ * hook address is configured.
+ */
+export function refreshPredictionRegistry(): Promise<void> {
+  const hook = getPredictionDeployment().predictionHook
+  if (!hook) {
+    return Promise.resolve()
+  }
+  inflight ??= refreshOnce(hook)
+    .catch((error: unknown) => {
+      logger.warn('predictionMarkets/registry', 'refreshPredictionRegistry', 'market registry read failed', { error })
+    })
+    .finally(() => {
+      inflight = undefined
+    })
+  return inflight
+}
+
+/** Subscribes to registry changes; polling runs while at least one subscriber exists. */
+export function subscribePredictionRegistry(listener: () => void): () => void {
+  listeners.add(listener)
+  if (!timer) {
+    refreshPredictionRegistry().catch(() => undefined)
+    timer = setInterval(() => {
+      refreshPredictionRegistry().catch(() => undefined)
+    }, PREDICTION_REGISTRY_POLL_MS)
+  }
+  return () => {
+    listeners.delete(listener)
+    if (!listeners.size && timer) {
+      clearInterval(timer)
+      timer = undefined
+    }
+  }
+}
+
+export function getPredictionRegistryVersion(): number {
+  return version
+}
+
+export function getPredictionToken(
+  chainId: number | undefined,
+  address: string | undefined,
+): OutcomeTokenInfo | undefined {
+  if (!isPredictionChain(chainId) || !address) {
+    return undefined
+  }
+  return tokens.get(normalizeTokenAddressForCache(address))
+}
+
+export function getPredictionMarkets(): Market[] {
+  return [...markets.values()].sort((a, b) => (a.id < b.id ? 1 : -1))
+}
+
+export function getPredictionMarket(id: bigint): Market | undefined {
+  return markets.get(id.toString())
+}
+
+/** The deployment's market tracks, ordered by asset then period; empty until read */
+export function getPredictionTracks(): PredictionTrack[] {
+  return tracks
+}
+
+/**
+ * The track that opened a market: `gatekeeper.schedulerOf(id)` (or the `marketOfSlot` read) when known, else the track
+ * whose ticker built the outcome symbol exactly.
+ */
+export function getPredictionTokenTrack(
+  token: Pick<OutcomeTokenInfo, 'marketId' | 'symbol'> | undefined,
+): PredictionTrack | undefined {
+  if (!token) {
+    return undefined
+  }
+  const scheduler = marketSchedulers.get(token.marketId.toString())
+  const byScheduler = scheduler ? tracks.find((t) => sameAddress(t.scheduler, scheduler)) : undefined
+  return byScheduler ?? classifyBySymbol(token.symbol, tracks)
+}
+
+export function getPredictionMarketTrack(market: Pick<Market, 'yes'> | undefined): PredictionTrack | undefined {
+  return getPredictionTokenTrack(market?.yes)
+}
+
+/**
+ * Looks up `address` and, if unknown, asks the chain whether it is one of the hook's outcome tokens
+ * (`OutcomeToken.hook() == hook`). Negative answers are cached.
+ */
+export function resolvePredictionToken(address: string): Promise<OutcomeTokenInfo | undefined> {
+  const key = normalizeTokenAddressForCache(address)
+  const known = tokens.get(key)
+  const hook = getPredictionDeployment().predictionHook
+  if (known || foreign.has(key) || !hook || isPlaceholderAddress(key)) {
+    return Promise.resolve(known)
+  }
+  let p = pending.get(key)
+  if (!p) {
+    p = resolveOutcomeToken(getPredictionPublicClient(), {
+      token: key as Address,
+      hook,
+      multicallAddress: getPredictionDeployment().multicall3,
+    })
+      .then((t) => {
+        if (t) {
+          registerToken(t)
+        } else {
+          foreign.add(key)
+        }
+        return t
+      })
+      .catch(() => undefined)
+      .finally(() => pending.delete(key))
+    pending.set(key, p)
+  }
+  return p
+}
+
+export interface PredictionRoute {
+  token: OutcomeTokenInfo
+  poolKey: PoolKey
+  zeroForOne: boolean
+  isBuy: boolean
+}
+
+/** A USDC <-> outcome-token swap on one of our pools, or undefined for any other pair. */
+export function getPredictionRoute(tokenIn: string, tokenOut: string): PredictionRoute | undefined {
+  const usdc = getPredictionDeployment().usdc
+  const buy = sameAddress(tokenIn, usdc) ? tokens.get(normalizeTokenAddressForCache(tokenOut)) : undefined
+  const sell = sameAddress(tokenOut, usdc) ? tokens.get(normalizeTokenAddressForCache(tokenIn)) : undefined
+  const token = buy ?? sell
+  if (!token) {
+    return undefined
+  }
+  return { token, poolKey: token.poolKey, zeroForOne: sameAddress(token.poolKey.currency0, tokenIn), isBuy: !!buy }
+}
+
+/** Same as `getPredictionRoute`, resolving an unknown non-USDC side on chain first. */
+export async function resolvePredictionRoute(tokenIn: string, tokenOut: string): Promise<PredictionRoute | undefined> {
+  const usdc = getPredictionDeployment().usdc
+  const other = sameAddress(tokenIn, usdc) ? tokenOut : sameAddress(tokenOut, usdc) ? tokenIn : undefined
+  if (!other) {
+    return undefined
+  }
+  await resolvePredictionToken(other)
+  return getPredictionRoute(tokenIn, tokenOut)
+}
+
+type CurrencyLike = { chainId: number; isToken: boolean; address?: string }
+
+/** True when either side is one of our outcome tokens. */
+export function touchesPredictionToken(currencyIn?: CurrencyLike, currencyOut?: CurrencyLike): boolean {
+  const touches = (c?: CurrencyLike): boolean => !!c?.isToken && !!getPredictionToken(c.chainId, c.address)
+  return touches(currencyIn) || touches(currencyOut)
+}
+
+/** Quote refresh interval for swaps that touch an outcome token (every block on Unichain), else undefined. */
+export function getPredictionQuotePollMs(currencyIn?: CurrencyLike, currencyOut?: CurrencyLike): number | undefined {
+  return touchesPredictionToken(currencyIn, currencyOut) ? PREDICTION_QUOTE_POLL_MS : undefined
+}
+
+/**
+ * Re-renders the caller when the registry changes. Polling starts only for chain 1301; an unknown `address`
+ * on 1301 triggers one on-chain lookup.
+ */
+export function usePredictionRegistry(chainId: number | undefined, address?: string): number {
+  const active = isPredictionChain(chainId)
+  const current = useSyncExternalStore(
+    active ? subscribePredictionRegistry : noopSubscribe,
+    getPredictionRegistryVersion,
+    getPredictionRegistryVersion,
+  )
+  useEffect(() => {
+    if (active && address) {
+      resolvePredictionToken(address).catch(() => undefined)
+    }
+  }, [active, address])
+  return current
+}
+
+function noopSubscribe(): () => void {
+  return () => undefined
+}
+
+/** Test helper. */
+export function resetPredictionRegistry(): void {
+  tokens.clear()
+  markets.clear()
+  foreign.clear()
+  pending.clear()
+  marketSchedulers.clear()
+  tracks = []
+  tracksSource = undefined
+  notify()
+}
