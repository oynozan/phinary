+
+class Revert {
+  constructor(readonly data: Hex) {}
+}
+
+type Impl = Record<string, (...args: never[]) => unknown>
+
+function contract(abi: Abi, impl: Impl): (data: Hex) => Hex {
+  return (data) => {
+    const { functionName, args } = decodeFunctionData({ abi, data })
+    const fn = impl[functionName] as ((...a: unknown[]) => unknown) | undefined
+    if (!fn) {
+      throw new Revert('0x')
+    }
+    return encodeFunctionResult({ abi, functionName, result: fn(...(args ?? [])) } as never)
+  }
+}
+
+function quoterRevert(hookError: Hex): Hex {
+  return encodeErrorResult({
+    abi: v4QuoterAbi,
+    errorName: 'UnexpectedRevertBytes',
+    args: [
+      encodeErrorResult({
+        abi: poolManagerErrorsAbi,
+        errorName: 'WrappedError',
+        args: [
+          HOOK,
+          '0x575e24b4',
+          hookError,
+          encodeErrorResult({ abi: poolManagerErrorsAbi, errorName: 'HookCallFailed' }),
+        ],
+      }),
+    ],
+  })
+}
+
+const bandRevert = quoterRevert(encodeErrorResult({ abi: hookErrorsAbi, errorName: 'Band' }))
+
+let hookRevert: Hex | undefined
+
+const handlers: Record<string, (data: Hex) => Hex> = {
+  [UNICHAIN_SEPOLIA.v4Quoter.toLowerCase()]: contract(v4QuoterAbi, {
+    quoteExactInputSingle: (p: { exactAmount: bigint }) => {
+      if (hookRevert) {
+        throw new Revert(hookRevert)
+      }
+      if (p.exactAmount >= 10n ** 12n) {
+        throw new Revert(bandRevert)
+      }
+      return [(p.exactAmount * 100n) / 25n, 90_000n]
+    },
+    quoteExactOutputSingle: (p: { exactAmount: bigint }) => [(p.exactAmount * 25n) / 100n, 80_000n],
+  }),
+  [UNICHAIN_SEPOLIA.permit2.toLowerCase()]: contract(permit2Abi, {
+    allowance: (owner: Address) => (owner === RICH ? [2n ** 160n - 1n, 4_000_000_000, 5] : [0n, 0, 2]),
+  }),
+  [USDC.toLowerCase()]: contract(erc20Abi, {
+    allowance: (owner: Address) => {
+      if (owner === FLAKY) {
+        throw new Error('fetch failed')
+      }
+      return owner === RICH ? maxUint256 : 0n
+    },
+  }),
+}
+
+let estimateGasRevert: Hex | undefined
+
+const receipts: Record<string, '0x1' | '0x0'> = { ['0x' + 'aa'.repeat(32)]: '0x1', ['0x' + 'bb'.repeat(32)]: '0x0' }
+
+const client = createClient({
+  chain: unichainSepolia,
+  transport: custom({
+    async request({ method, params }: { method: string; params: unknown[] }) {
+      if (method === 'eth_chainId') {
+        return '0x515'
+      }
+      if (method === 'eth_gasPrice') {
+        return '0x16e360'
+      }
+      if (method === 'eth_estimateGas') {
+        if (estimateGasRevert) {
+          throw new RpcRequestError({
+            body: {},
+            url: 'mock://',
+            error: { code: 3, message: 'execution reverted', data: estimateGasRevert },
+          })
+        }
+        return '0x30d40'
+      }
+      if (method === 'eth_getTransactionReceipt') {
+        const [hash] = params as [string]
+        const status = receipts[hash]
+        if (!status) {
+          return null
+        }
+        return {
+          blockHash: `0x${'11'.repeat(32)}`,
+          blockNumber: '0x1',
+          contractAddress: null,
+          cumulativeGasUsed: '0x1',
+          effectiveGasPrice: '0x1',
+          from: ALICE,
+          gasUsed: '0x1',
+          logs: [],
+          logsBloom: `0x${'00'.repeat(256)}`,
+          status,
+          to: UNICHAIN_SEPOLIA.universalRouter,
+          transactionHash: hash,
+          transactionIndex: '0x0',
+          type: '0x2',
+        }
+      }
+      if (method === 'eth_call') {
+        const [tx] = params as [{ to: string; data?: Hex; input?: Hex }]
+        const h = handlers[tx.to.toLowerCase()]
+        try {
+          if (!h) {
+            throw new Revert('0x')
+          }
+          return h((tx.data ?? tx.input) as Hex)
+        } catch (e) {
+          if (e instanceof Revert) {
+            throw new RpcRequestError({
+              body: {},
+              url: 'mock://',
+              error: { code: 3, message: 'execution reverted', data: e.data },
+            })
+          }
+          throw e
+        }
+      }
+      throw new Error(`unsupported ${method}`)
+    },
+  }),
+})
+
+const WEEK = 7 * 86_400
+
+function market({
+  expiry = BigInt(Math.floor(Date.now() / 1000) + WEEK),
+  window = 0,
