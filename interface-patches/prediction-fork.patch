+/**
+ * Price history of one prediction market, rebuilt from chain state.
+ *
+ * Each history point is `hook.quote(marketId)` read with `eth_call` at a past block, so the chart shows exactly what the
+ * hook quoted at that second. One market entry serves both its YES and NO token. While at least one chart subscribes
+ * and the page is visible, the entry polls once per second. The latest block's quote, marketInfo, block number and
+ * timestamp come from the market panel's query (one multicall, shared when both are open). Then the entry reads any
+ * grid blocks it has not seen yet with a few parallel calls (drpc's free tier rejects JSON-RPC batches above 3 calls).
+ * Past blocks never change, so every read is cached for the lifetime of the page. A past read that fails is retried
+ * with exponential backoff and given up on (left unpriced) after a few attempts. Polling stops once the market is
+ * settled and its history is complete.
+ */
+
+import { SharedQueryClient } from '@universe/api'
+import {
+  type BlockAnchor,
+  type HistoryMarket,
+  isFinalMarket,
+  type MidPoint,
+  quoteToMidPoint,
+  selectHistoryBlocks,
+} from 'uniswap/src/features/predictionMarkets/chart/priceHistory'
+import { getPredictionDeployment } from 'uniswap/src/features/predictionMarkets/config'
+import { getPredictionPublicClient } from 'uniswap/src/features/predictionMarkets/rpc'
+import { type HookQuote, type MarketInfo, predictionHookAbi } from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  PREDICTION_MARKET_LIVE_KEY,
+  predictionMarketLiveQueryOptions,
+} from 'uniswap/src/features/predictionMarkets/ui/predictionMarketLive'
+import { logger } from 'utilities/src/logger/logger'
+import { type Address, BaseError, ContractFunctionRevertedError } from 'viem'
+import { readContract } from 'viem/actions'
+
+/** One new block per second on Unichain Sepolia */
+export const PREDICTION_HISTORY_POLL_MS = 1_000
+export const PREDICTION_HISTORY_CONCURRENCY = 6
+const RETRY_MS = 3_000
+const MAX_RETRY_MS = 30_000
+/** A past block whose read keeps failing is left unpriced after this many attempts */
+const MAX_BLOCK_ATTEMPTS = 4
+const MAX_CACHED_MARKETS = 32
+
+/** 3 s, 6 s, 12 s... up to 30 s */
+export function historyRetryDelayMs(attempts: number): number {
+  return Math.min(RETRY_MS * 2 ** Math.max(attempts - 1, 0), MAX_RETRY_MS)
+}
+
+export interface MarketHistorySnapshot {
+  market?: HistoryMarket
+  points: readonly MidPoint[]
+  loading: boolean
+  isError: boolean
+}
+
+interface Entry {
+  hook: Address
+  marketId: bigint
+  market?: HistoryMarket
+  mids: Map<number, bigint>
+  /** Blocks already read, priced or not */
+  read: Set<bigint>
+  /** Past blocks whose read failed, with the attempt count and when to try again */
+  retries: Map<bigint, { attempts: number; at: number }>
+  tip?: MidPoint
+  loaded: boolean
+  complete: boolean
+  failures: number
+  snapshot: MarketHistorySnapshot
+  listeners: Set<() => void>
+  timer?: ReturnType<typeof setTimeout>
+  running: boolean
+}
+
+const EMPTY_SNAPSHOT: MarketHistorySnapshot = { points: [], loading: false, isError: false }
+const LOADING_SNAPSHOT: MarketHistorySnapshot = { points: [], loading: true, isError: false }
+const entries = new Map<string, Entry>()
+
+export function marketHistoryKey(hook: Address, marketId: bigint): string {
+  return `${hook.toLowerCase()}:${marketId}`
+}
+
+function toHistoryMarket(info: MarketInfo): HistoryMarket {
+  return {
+    openTime: Number(info.openTime),
+    expiry: Number(info.expiry),
+    window: Number(info.window),
+    status: info.status,
+    yesWon: info.yesWon,
+  }
+}
+
+function publish(entry: Entry): void {
+  const points = [...entry.mids.entries()].map(([time, midYes]) => ({ time, midYes })).sort((a, b) => a.time - b.time)
+  const last = points.at(-1)
+  if (entry.tip && (!last || entry.tip.time > last.time)) {
+    points.push(entry.tip)
+  }
+  entry.snapshot = {
+    market: entry.market,
+    points,
+    loading: !entry.loaded && entry.failures === 0,
+    isError: !entry.loaded && entry.failures > 0,
+  }
+  for (const l of entry.listeners) {
+    l()
+  }
+}
+
+async function readLatest(
+  entry: Entry,
+  maxAgeMs: number,
+): Promise<{ market: HistoryMarket; latest: BlockAnchor; quote?: HookQuote }> {
+  const live = await SharedQueryClient.fetchQuery({
+    ...predictionMarketLiveQueryOptions({ hook: entry.hook, marketId: entry.marketId }),
+    staleTime: maxAgeMs,
+  })
+  if (!live.block) {
+    throw new Error('latest block unavailable')
+  }
+  return { market: toHistoryMarket(live.info), latest: live.block, quote: live.quote }
+}
+
+function isRevert(error: unknown): boolean {
+  return error instanceof BaseError && !!error.walk((e) => e instanceof ContractFunctionRevertedError)
+}
+
+async function readBlocks({
+  entry,
+  market,
+  blocks,
+}: {
+  entry: Entry
+  market: HistoryMarket
+  blocks: readonly bigint[]
+}): Promise<number> {
+  const client = getPredictionPublicClient()
+  let failed = 0
+  let next = 0
+  const worker = async (): Promise<void> => {
+    while (next < blocks.length) {
+      const blockNumber = blocks[next++] as bigint
+      try {
+        const quote = await readContract(client, {
+          address: entry.hook,
+          abi: predictionHookAbi,
+          functionName: 'quote',
+          args: [entry.marketId],
+          blockNumber,
+        })
+        const point = quoteToMidPoint(quote as HookQuote, market)
+        if (point) {
+          entry.mids.set(point.time, point.midYes)
+        }
+        entry.read.add(blockNumber)
+        entry.retries.delete(blockNumber)
+      } catch (error) {
+        // Before the market's creation block the hook reverts with UnknownMarket
+        if (isRevert(error)) {
+          entry.read.add(blockNumber)
+          entry.retries.delete(blockNumber)
+          continue
+        }
+        failed++
+        const attempts = (entry.retries.get(blockNumber)?.attempts ?? 0) + 1
+        if (attempts >= MAX_BLOCK_ATTEMPTS) {
+          entry.read.add(blockNumber)
+          entry.retries.delete(blockNumber)
+        } else {
+          entry.retries.set(blockNumber, { attempts, at: Date.now() + historyRetryDelayMs(attempts) })
+        }
+      }
+    }
+  }
+  await Promise.all(Array.from({ length: Math.min(PREDICTION_HISTORY_CONCURRENCY, blocks.length) }, worker))
+  return failed
+}
+
+function isDue(entry: Entry, now: number): (blockNumber: bigint) => boolean {
+  return (blockNumber) => !entry.read.has(blockNumber) && (entry.retries.get(blockNumber)?.at ?? 0) <= now
+}
+
+/** One poll; resolves to how many past reads failed */
+async function refreshMarketHistory(entry: Entry, maxAgeMs: number): Promise<number> {
+  const { market, latest, quote } = await readLatest(entry, maxAgeMs)
+  entry.market = market
+  const grid = selectHistoryBlocks({ market, latest })
+  const tip = quote && quoteToMidPoint(quote, market)
+  if (tip && grid.at(-1) === latest.number) {
+    entry.mids.set(tip.time, tip.midYes)
+    entry.read.add(latest.number)
+  } else if (tip) {
+    entry.tip = tip
+  }
+  const now = Date.now()
+  const failed = await readBlocks({ entry, market, blocks: grid.filter(isDue(entry, now)) })
+  entry.loaded = true
+  entry.complete = isFinalMarket(market) && grid.every((b) => entry.read.has(b))
+  publish(entry)
+  return failed
+}
+
+/** A final market has nothing new at the tip, so it waits for its next due retry */
+function nextPollDelay(entry: Entry): number {
+  if (!entry.market || !isFinalMarket(entry.market)) {
+    return PREDICTION_HISTORY_POLL_MS
+  }
+  const retryTimes = [...entry.retries.values()].map((r) => r.at)
+  if (!retryTimes.length) {
+    return PREDICTION_HISTORY_POLL_MS
+  }
+  return Math.max(PREDICTION_HISTORY_POLL_MS, Math.min(...retryTimes) - Date.now())
+}
+
+function isPageHidden(): boolean {
+  return typeof document !== 'undefined' && document.visibilityState === 'hidden'
+}
+
+let resumesOnVisible = false
+
+/** Restarts the polls that paused while the page was hidden */
+function resumeOnVisible(): void {
+  if (resumesOnVisible || typeof document === 'undefined') {
+    return
+  }
+  resumesOnVisible = true
+  document.addEventListener('visibilitychange', () => {
+    if (isPageHidden()) {
+      return
+    }
+    for (const entry of entries.values()) {
+      if (entry.listeners.size && !entry.timer && !entry.running) {
+        run(entry)
+      }
+    }
+  })
+}
+
+function schedule(entry: Entry, delay: number): void {
+  clearTimeout(entry.timer)
+  entry.timer = undefined
+  if (!entry.listeners.size || entry.complete) {
+    return
+  }
+  entry.timer = setTimeout(() => {
+    entry.timer = undefined
+    if (isPageHidden()) {
+      resumeOnVisible()
+      return
+    }
+    run(entry)
+  }, delay)
+}
+
+function run(entry: Entry): void {
+  if (entry.running || entry.complete) {
+    return
+  }
+  entry.running = true
+  refreshMarketHistory(entry, PREDICTION_HISTORY_POLL_MS)
+    .then((failed) => {
+      entry.failures = 0
+      if (failed) {
+        logger.warn('predictionMarkets/chart', 'refreshMarketHistory', 'some past price reads failed', { failed })
+      }
+      schedule(entry, nextPollDelay(entry))
+    })
+    .catch((error: unknown) => {
+      entry.failures++
+      publish(entry)
+      logger.warn('predictionMarkets/chart', 'refreshMarketHistory', 'price history read failed', { error })
+      schedule(entry, historyRetryDelayMs(entry.failures))
+    })
+    .finally(() => {
+      entry.running = false
+    })
+}
+
+function evictIdle(): void {
+  for (const [key, entry] of entries) {
+    if (entries.size <= MAX_CACHED_MARKETS) {
+      return
+    }
+    if (!entry.listeners.size && !entry.running) {
+      entries.delete(key)
+    }
+  }
+}
+
+function getEntry(hook: Address, marketId: bigint): Entry {
+  const key = marketHistoryKey(hook, marketId)
+  let entry = entries.get(key)
+  if (!entry) {
+    entry = {
+      hook,
+      marketId,
+      mids: new Map(),
+      read: new Set(),
+      retries: new Map(),
+      loaded: false,
+      complete: false,
+      failures: 0,
+      snapshot: LOADING_SNAPSHOT,
+      listeners: new Set(),
+      running: false,
+    }
+    entries.set(key, entry)
+    evictIdle()
+  }
+  return entry
+}
+
+/** Subscribes to a market's history and polls it while subscribed */
+export function subscribeMarketHistory(marketId: bigint, listener: () => void): () => void {
+  const hook = getPredictionDeployment().predictionHook
+  if (!hook) {
+    return () => undefined
+  }
+  const entry = getEntry(hook, marketId)
+  entry.listeners.add(listener)
+  if (!entry.running && !entry.timer) {
+    run(entry)
+  }
+  return () => {
+    entry.listeners.delete(listener)
+    if (!entry.listeners.size) {
+      clearTimeout(entry.timer)
+      entry.timer = undefined
+    }
+  }
+}
+
+export function getMarketHistorySnapshot(marketId: bigint | undefined): MarketHistorySnapshot {
+  const hook = getPredictionDeployment().predictionHook
+  if (!hook || marketId === undefined) {
+    return EMPTY_SNAPSHOT
+  }
+  return entries.get(marketHistoryKey(hook, marketId))?.snapshot ?? LOADING_SNAPSHOT
+}
+
+/** Runs one poll outside the subscription loop and returns the resulting snapshot */
+export async function loadMarketHistory(marketId: bigint): Promise<MarketHistorySnapshot> {
+  const hook = getPredictionDeployment().predictionHook
+  if (!hook) {
+    return EMPTY_SNAPSHOT
+  }
+  const entry = getEntry(hook, marketId)
+  await refreshMarketHistory(entry, 0)
+  return entry.snapshot
+}
+
+/** Test helper */
+export function resetMarketHistories(): void {
+  for (const entry of entries.values()) {
+    clearTimeout(entry.timer)
+  }
+  entries.clear()
+  SharedQueryClient.removeQueries({ queryKey: [PREDICTION_MARKET_LIVE_KEY] })
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/chart/priceHistory.test.ts b/packages/uniswap/src/features/predictionMarkets/chart/priceHistory.test.ts
new file mode 100644
index 0000000..5276b21
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/chart/priceHistory.test.ts
@@ -0,0 +1,128 @@
+import {
+  blockAtTime,
+  buildPredictionSeries,
+  type HistoryMarket,
+  historyStepSeconds,
+  lastPricedTime,
+  outcomeValue,
+  quoteToMidPoint,
+  selectHistoryBlocks,
+} from 'uniswap/src/features/predictionMarkets/chart/priceHistory'
+import { MarketStatus, WAD } from 'uniswap/src/features/predictionMarkets/sdk'
+
+const OPEN = 1_790_377_680
+const GENESIS = 1_726_852_428
+
+const market = (over: Partial<HistoryMarket> = {}): HistoryMarket => ({
+  openTime: OPEN,
+  expiry: OPEN + 60,
+  window: 10,
+  status: MarketStatus.Trading,
+  yesWon: false,
+  ...over,
+})
+
+const anchorAt = (timestamp: number) => ({ number: BigInt(timestamp - GENESIS), timestamp })
+const blockOf = (t: number) => BigInt(t - GENESIS)
+
+describe('selectHistoryBlocks', () => {
+  it('maps a timestamp to its block with 1 s blocks', () => {
+    expect(blockAtTime({ anchor: anchorAt(OPEN + 30), time: OPEN })).toBe(blockOf(OPEN))
+    expect(blockAtTime({ anchor: anchorAt(OPEN + 30), time: OPEN + 30 })).toBe(blockOf(OPEN + 30))
+  })
+
+  it('reads every block of a 60 s market from openTime up to the latest block', () => {
+    const blocks = selectHistoryBlocks({ market: market(), latest: anchorAt(OPEN + 20) })
+    expect(blocks).toHaveLength(21)
+    expect(blocks[0]).toBe(blockOf(OPEN))
+    expect(blocks.at(-1)).toBe(blockOf(OPEN + 20))
+  })
+
+  it('stops at the last second the hook prices (tau > window)', () => {
+    const m = market()
+    expect(lastPricedTime(m)).toBe(OPEN + 49)
+    const blocks = selectHistoryBlocks({ market: m, latest: anchorAt(OPEN + 500) })
+    expect(blocks).toHaveLength(50)
+    expect(blocks.at(-1)).toBe(blockOf(OPEN + 49))
+  })
+
+  it('returns nothing before the market opens', () => {
+    expect(selectHistoryBlocks({ market: market(), latest: anchorAt(OPEN - 5) })).toEqual([])
+  })
+
+  it('samples a week-long market evenly on a grid that does not move between refreshes', () => {
+    const week = market({ expiry: OPEN + 7 * 86_400 })
+    const step = historyStepSeconds(week, 240)
+    expect(step).toBe(Math.ceil((7 * 86_400 - 10) / 240))
+    const done = selectHistoryBlocks({ market: week, latest: anchorAt(OPEN + 7 * 86_400 + 60), maxPoints: 240 })
+    expect(done.length).toBeLessThanOrEqual(240)
+    expect(done[1]! - done[0]!).toBe(BigInt(step))
+
+    const early = selectHistoryBlocks({ market: week, latest: anchorAt(OPEN + 3 * step + 7), maxPoints: 240 })
+    expect(early).toEqual(done.slice(0, 4))
+  })
+})
+
+describe('quoteToMidPoint', () => {
+  it('timestamps a quote from its tau', () => {
+    expect(quoteToMidPoint({ tau: 45n, midYes: WAD / 3n }, market())).toEqual({ time: OPEN + 15, midYes: WAD / 3n })
+  })
+
+  it('drops quotes inside the averaging window, after expiry, or when pricing failed', () => {
+    expect(quoteToMidPoint({ tau: 10n, midYes: 0n }, market())).toBeUndefined()
+    expect(quoteToMidPoint({ tau: 10n, midYes: WAD / 2n }, market())).toBeUndefined()
+    expect(quoteToMidPoint({ tau: 0n, midYes: 0n }, market())).toBeUndefined()
+    expect(quoteToMidPoint({ tau: 30n, midYes: 0n }, market())).toBeUndefined()
+  })
+})
+
+describe('buildPredictionSeries', () => {
+  const points = [
+    { time: OPEN + 5, midYes: (WAD * 40n) / 100n },
+    { time: OPEN + 3, midYes: (WAD * 25n) / 100n },
+    { time: OPEN + 4, midYes: (WAD * 30n) / 100n },
+    { time: OPEN + 4, midYes: (WAD * 35n) / 100n },
+  ]
+
+  it('builds an ascending YES series from midYes, last write wins per second', () => {
+    expect(buildPredictionSeries({ points, isYes: true, market: market() })).toEqual([
+      { time: OPEN + 3, value: 0.25 },
+      { time: OPEN + 4, value: 0.35 },
+      { time: OPEN + 5, value: 0.4 },
+    ])
+  })
+
+  it('prices NO as 1 - midYes', () => {
+    expect(buildPredictionSeries({ points, isYes: false }).map((p) => p.value)).toEqual([0.75, 0.65, 0.6])
+  })
+
+  it('ends at 1.00 for the winning token and 0.00 for the losing one at expiry', () => {
+    const settled = market({ status: MarketStatus.Settled, yesWon: true })
+    expect(buildPredictionSeries({ points, isYes: true, market: settled }).at(-1)).toEqual({
+      time: OPEN + 60,
+      value: 1,
+    })
+    expect(buildPredictionSeries({ points, isYes: false, market: settled }).at(-1)).toEqual({
+      time: OPEN + 60,
+      value: 0,
+    })
+  })
+
+  it('ends an invalid market at the 0.50 refund', () => {
+    const invalid = market({ status: MarketStatus.Invalid })
+    expect(buildPredictionSeries({ points, isYes: true, market: invalid }).at(-1)?.value).toBe(0.5)
+    expect(outcomeValue(invalid, false)).toBe(0.5)
+  })
+
+  it('adds no end point while the market is trading or awaiting settlement', () => {
+    expect(buildPredictionSeries({ points, isYes: true, market: market() })).toHaveLength(3)
+    expect(outcomeValue(market(), true)).toBeUndefined()
+  })
+
+  it('still shows the outcome when no quote could be read', () => {
+    const settled = market({ status: MarketStatus.Settled, yesWon: false })
+    expect(buildPredictionSeries({ points: [], isYes: false, market: settled })).toEqual([
+      { time: OPEN + 60, value: 1 },
+    ])
+  })
+})
diff --git a/packages/uniswap/src/features/predictionMarkets/chart/priceHistory.ts b/packages/uniswap/src/features/predictionMarkets/chart/priceHistory.ts
new file mode 100644
index 0000000..3b2ed0f
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/chart/priceHistory.ts
@@ -0,0 +1,136 @@
+import { MarketStatus, WAD } from 'uniswap/src/features/predictionMarkets/sdk'
+
+/** Unichain Sepolia produces a block every second, so block numbers map to timestamps exactly */
+export const PREDICTION_BLOCK_TIME_SECONDS = 1
+
+/** Most history blocks read for one market, long markets are sampled evenly */
+export const PREDICTION_HISTORY_MAX_POINTS = 240
+
+/** A chart point in USD per outcome token (0 to 1) */
+export interface PredictionPricePoint {
+  time: number
+  value: number
+}
+
+/** The `marketInfo` fields the history needs, times in unix seconds */
+export interface HistoryMarket {
+  openTime: number
+  expiry: number
+  window: number
+  status: number
+  yesWon: boolean
+}
+
+/** The hook's mid price for YES at one block */
+export interface MidPoint {
+  time: number
+  midYes: bigint
+}
+
+export interface BlockAnchor {
+  number: bigint
+  timestamp: number
+}
+
+// The hook prices only while tau > window, so the last priced second is one before expiry - window
+export function lastPricedTime(market: HistoryMarket): number {
+  return market.expiry - market.window - 1
+}
+
+export function historyStepSeconds(market: HistoryMarket, maxPoints = PREDICTION_HISTORY_MAX_POINTS): number {
+  const span = Math.max(0, lastPricedTime(market) - market.openTime + 1)
+  return Math.max(1, Math.ceil(span / Math.max(1, maxPoints)))
+}
+
+export function blockAtTime({
+  anchor,
+  time,
+  blockTime = PREDICTION_BLOCK_TIME_SECONDS,
+}: {
+  anchor: BlockAnchor
+  time: number
+  blockTime?: number
+}): bigint {
+  return anchor.number - BigInt(Math.ceil((anchor.timestamp - time) / blockTime))
+}
+
+/** Blocks to read from openTime up to the latest priced second, on a grid anchored at openTime */
+export function selectHistoryBlocks({
+  market,
+  latest,
+  maxPoints = PREDICTION_HISTORY_MAX_POINTS,
+  blockTime = PREDICTION_BLOCK_TIME_SECONDS,
+}: {
+  market: HistoryMarket
+  latest: BlockAnchor
+  maxPoints?: number
+  blockTime?: number
+}): bigint[] {
+  const step = historyStepSeconds(market, maxPoints)
+  const end = Math.min(latest.timestamp, lastPricedTime(market))
+  const blocks: bigint[] = []
+  for (let t = market.openTime; t <= end; t += step) {
+    const block = blockAtTime({ anchor: latest, time: t, blockTime })
+    if (block >= 0n && blocks.at(-1) !== block) {
+      blocks.push(block)
+    }
+  }
+  return blocks
+}
+
+/** The mid at the block a quote was read from, or undefined when the hook no longer prices the market */
+export function quoteToMidPoint(
+  quote: { tau: bigint; midYes: bigint },
+  market: Pick<HistoryMarket, 'expiry' | 'window'>,
+): MidPoint | undefined {
+  if (quote.midYes === 0n || quote.tau <= BigInt(market.window)) {
+    return undefined
+  }
+  return { time: market.expiry - Number(quote.tau), midYes: quote.midYes }
+}
+
+/** What one token pays once the market is final, or undefined while it is not */
+export function outcomeValue(market: Pick<HistoryMarket, 'status' | 'yesWon'>, isYes: boolean): number | undefined {
+  if (market.status === MarketStatus.Settled) {
+    return market.yesWon === isYes ? 1 : 0
+  }
+  if (market.status === MarketStatus.Invalid) {
+    return 0.5
+  }
+  return undefined
+}
+
+export function isFinalMarket(market: Pick<HistoryMarket, 'status'>): boolean {
+  return market.status === MarketStatus.Settled || market.status === MarketStatus.Invalid
+}
+
+function midToValue(midYes: bigint, isYes: boolean): number {
+  const mid = midYes > WAD ? WAD : midYes
+  return Number(isYes ? mid : WAD - mid) / Number(WAD)
+}
+
+/** Ascending YES or NO price series, ending at the payout once the market is final */
+export function buildPredictionSeries({
+  points,
+  isYes,
+  market,
+}: {
+  points: readonly MidPoint[]
+  isYes: boolean
+  market?: HistoryMarket
+}): PredictionPricePoint[] {
+  const byTime = new Map<number, bigint>()
+  for (const p of points) {
+    byTime.set(p.time, p.midYes)
+  }
+  const series = [...byTime.entries()]
+    .sort(([a], [b]) => a - b)
+    .map(([time, midYes]) => ({ time, value: midToValue(midYes, isYes) }))
+
+  const payout = market ? outcomeValue(market, isYes) : undefined
+  if (market && payout !== undefined) {
+    const last = series.at(-1)
+    series.push({ time: last ? Math.max(market.expiry, last.time + 1) : market.expiry, value: payout })
+  }
+  return series
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/chart/usePredictionPriceHistory.ts b/packages/uniswap/src/features/predictionMarkets/chart/usePredictionPriceHistory.ts
new file mode 100644
index 0000000..a82d404
