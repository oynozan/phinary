+  it('forgets the result once the form has no trade', () => {
+    const first = { txRequests: ['first'] }
+    const { result, rerender } = render({ data: first, trade: tradeOf(usdc, yes) })
+    rerender({ data: undefined, trade: undefined })
+    expect(result.current).toBeUndefined()
+    rerender({ data: undefined, trade: tradeOf(usdc, yes) })
+    expect(result.current).toBeUndefined()
+  })
+
+  it('does nothing for other tokens', () => {
+    const { result, rerender } = render({ data: { txRequests: [] }, trade: tradeOf(dai, weth) })
+    rerender({ data: undefined, trade: tradeOf(dai, weth) })
+    expect(result.current).toBeUndefined()
+  })
+})
diff --git a/packages/uniswap/src/features/predictionMarkets/ui/usePredictionSwapTxPlaceholder.ts b/packages/uniswap/src/features/predictionMarkets/ui/usePredictionSwapTxPlaceholder.ts
new file mode 100644
index 0000000..7dd084a
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/ui/usePredictionSwapTxPlaceholder.ts
@@ -0,0 +1,45 @@
+import { TradeType } from '@uniswap/sdk-core'
+import { useEffect, useRef } from 'react'
+import { touchesPredictionToken } from 'uniswap/src/features/predictionMarkets/registry'
+import type { Trade } from 'uniswap/src/features/transactions/swap/types/trade'
+import { currencyId } from 'uniswap/src/utils/currencyId'
+
+/** Pair, trade type, the amount the user typed and the approval step: what a `/swap` result depends on besides the price */
+function placeholderKey(trade: Trade | undefined, approvalAction: string | undefined): string | undefined {
+  if (!trade || !touchesPredictionToken(trade.inputAmount.currency, trade.outputAmount.currency)) {
+    return undefined
+  }
+  const specified = trade.tradeType === TradeType.EXACT_INPUT ? trade.inputAmount : trade.outputAmount
+  return [
+    currencyId(trade.inputAmount.currency),
+    currencyId(trade.outputAmount.currency),
+    trade.tradeType,
+    specified.quotient.toString(),
+    approvalAction,
+  ].join(':')
+}
+
+/**
+ * Last `/swap` result of an outcome-token trade, kept as placeholder until the next lands, for as long as the pair,
+ * trade type, typed amount and approval step stay the same; else undefined
+ */
+export function usePredictionSwapTxPlaceholder<T>({
+  data,
+  trade,
+  approvalAction,
+}: {
+  data: T | undefined
+  trade: Trade | undefined
+  approvalAction?: string
+}): T | undefined {
+  const last = useRef<{ key: string; data: T } | undefined>(undefined)
+  const key = placeholderKey(trade, approvalAction)
+  useEffect(() => {
+    if (!key) {
+      last.current = undefined
+    } else if (data !== undefined) {
+      last.current = { key, data }
+    }
+  }, [key, data])
+  return key && last.current?.key === key ? last.current.data : undefined
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/usePredictionTokenOptions.ts b/packages/uniswap/src/features/predictionMarkets/usePredictionTokenOptions.ts
new file mode 100644
index 0000000..0d6a1bd
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/usePredictionTokenOptions.ts
@@ -0,0 +1,181 @@
+import { useEffect, useMemo, useState } from 'react'
+import type { TokenOption } from 'uniswap/src/components/lists/items/types'
+import { currencyInfosToTokenOptions } from 'uniswap/src/components/TokenSelector/hooks/useCurrencyInfosToTokenOptions'
+import { getCommonBase } from 'uniswap/src/constants/routing'
+import { USDC_UNICHAIN_SEPOLIA } from 'uniswap/src/constants/tokens'
+import { isPredictionChain, PREDICTION_REGISTRY_POLL_MS } from 'uniswap/src/features/predictionMarkets/config'
+import {
+  getPredictionMarkets,
+  getPredictionMarketTrack,
+  getPredictionTracks,
+  usePredictionRegistry,
+} from 'uniswap/src/features/predictionMarkets/registry'
+import type { Market } from 'uniswap/src/features/predictionMarkets/sdk'
+import type { PredictionTrack } from 'uniswap/src/features/predictionMarkets/tracks'
+import { ONE_SECOND_MS } from 'utilities/src/time/time'
+
+const OPEN_MARKETS_PER_TRACK = 4
+const SETTLED_MARKETS_PER_TRACK = 2
+/** Caps for markets no track claims (every market, when the deployment lists no tracks) */
+const OPEN_MARKETS_UNTRACKED = 8
+const SETTLED_MARKETS_UNTRACKED = 4
+/** A track this short or shorter makes the picker re-check cutoffs every second */
+const FAST_TRACK_SECONDS = 120
+
+export const PREDICTION_UNTRACKED_GROUP_ID = 'untracked'
+export const PREDICTION_UNTRACKED_GROUP_NAME = 'Prediction markets'
+
+export interface PredictionPickerGroup {
+  /** The track's scheduler address, or `PREDICTION_UNTRACKED_GROUP_ID` */
+  id: string
+  /** "ETH 1-minute" */
+  name: string
+  markets: Market[]
+}
+
+function isOpen(m: Market, now: bigint): boolean {
+  return m.status === 'Trading' && now >= m.info.openTime && now < m.cutoff
+}
+
+function isFinal(m: Market): boolean {
+  return m.status === 'Settled' || m.status === 'Invalid'
+}
+
+/**
+ * Markets for the token selector: one group per track with its open markets (buy and sell), in track order, and the
+ * newest settled markets of every track in one list (sell to redeem), newest expiry first. Markets past their cutoff
+ * but not yet settled accept no trades and are left out. `markets` is newest first.
+ */
+export function selectPredictionMarketsForPicker(
+  markets: readonly Market[],
+  {
+    nowSeconds,
+    tracks = [],
+    trackOf = (): undefined => undefined,
+  }: {
+    nowSeconds: number
+    tracks?: readonly PredictionTrack[]
+    trackOf?: (m: Market) => PredictionTrack | undefined
+  },
+): { open: PredictionPickerGroup[]; settled: Market[] } {
+  const now = BigInt(Math.floor(nowSeconds))
+  const byTrack = new Map<string, Market[]>()
+  const untracked: Market[] = []
+  for (const m of markets) {
+    const track = trackOf(m)
+    if (track) {
+      const list = byTrack.get(track.scheduler) ?? []
+      list.push(m)
+      byTrack.set(track.scheduler, list)
+    } else {
+      untracked.push(m)
+    }
+  }
+  const open: PredictionPickerGroup[] = []
+  const settled: Market[] = []
+  for (const track of tracks) {
+    const list = byTrack.get(track.scheduler) ?? []
+    const openHere = list.filter((m) => isOpen(m, now)).slice(0, OPEN_MARKETS_PER_TRACK)
+    if (openHere.length) {
+      open.push({ id: track.scheduler, name: track.label, markets: openHere })
+    }
+    settled.push(...list.filter(isFinal).slice(0, SETTLED_MARKETS_PER_TRACK))
+  }
+  const untrackedOpen = untracked.filter((m) => isOpen(m, now)).slice(0, OPEN_MARKETS_UNTRACKED)
+  if (untrackedOpen.length) {
+    open.push({ id: PREDICTION_UNTRACKED_GROUP_ID, name: PREDICTION_UNTRACKED_GROUP_NAME, markets: untrackedOpen })
+  }
+  settled.push(...untracked.filter(isFinal).slice(0, SETTLED_MARKETS_UNTRACKED))
+  const rank = new Map(settled.map((m, i) => [m, i]))
+  settled.sort(
+    (a, b) =>
+      (a.info.expiry === b.info.expiry ? 0 : a.info.expiry > b.info.expiry ? -1 : 1) ||
+      (rank.get(a) ?? 0) - (rank.get(b) ?? 0),
+  )
+  return { open, settled }
+}
+
+function useNowSeconds(active: boolean, intervalMs: number): number {
+  const [now, setNow] = useState(() => Date.now() / 1000)
+  useEffect(() => {
+    if (!active) {
+      return undefined
+    }
+    const id = setInterval(() => setNow(Date.now() / 1000), intervalMs)
+    return () => clearInterval(id)
+  }, [active, intervalMs])
+  return now
+}
+
+export interface PredictionPickerSection {
+  /** Unique per section, for list row keys */
+  id: string
+  name: string
+  options: TokenOption[]
+}
+
+/**
+ * The token selector's prediction sections: USDC (the markets' collateral) once, then one section per track with the
+ * YES/NO tokens of its open markets, and the recently settled markets of every track in `settled`.
+ */
+export function usePredictionTokenOptions(chainId: number | undefined): {
+  open?: PredictionPickerSection[]
+  settled?: TokenOption[]
+} {
+  const version = usePredictionRegistry(chainId)
+  const active = isPredictionChain(chainId)
+  const tracks = getPredictionTracks()
+  const hasTracks = tracks.length > 0
+  const fast = !hasTracks || tracks.some((t) => t.tenorSec <= FAST_TRACK_SECONDS)
+  const now = useNowSeconds(active, fast ? ONE_SECOND_MS : PREDICTION_REGISTRY_POLL_MS)
+
+  // Recomputed on every tick; the options below only change when the listed markets do
+  const selection = useMemo(
+    () =>
+      active
+        ? selectPredictionMarketsForPicker(getPredictionMarkets(), {
+            nowSeconds: now,
+            tracks,
+            trackOf: getPredictionMarketTrack,
+          })
+        : undefined,
+    // oxlint-disable-next-line react-hooks/exhaustive-deps -- re-read the registry when it changes
+    [active, version, now, tracks],
+  )
+  const signature = selection
+    ? JSON.stringify([
+        selection.open.map((g) => [g.id, g.name, ...g.markets.map((m) => m.id.toString())]),
+        selection.settled.map((m) => m.id.toString()),
+      ])
+    : ''
+
+  return useMemo(() => {
+    if (!selection || !chainId) {
+      return {}
+    }
+    const options = (list: Market[]): TokenOption[] =>
+      currencyInfosToTokenOptions(
+        list.flatMap((m) => [getCommonBase(chainId, m.yes.address), getCommonBase(chainId, m.no.address)]),
+      ) ?? []
+    // USDC once, first, so both sides of a trade can be picked from these sections
+    const usdc = currencyInfosToTokenOptions([getCommonBase(chainId, USDC_UNICHAIN_SEPOLIA.address)]) ?? []
+    const groups = selection.open.map((g) => ({ id: g.id, name: g.name, options: options(g.markets) }))
+    const open: PredictionPickerSection[] = hasTracks
+      ? [
+          { id: 'usdc', name: PREDICTION_UNTRACKED_GROUP_NAME, options: usdc },
+          ...groups.map((g) =>
+            g.id === PREDICTION_UNTRACKED_GROUP_ID ? { ...g, name: 'Other prediction markets' } : g,
+          ),
+        ]
+      : [
+          {
+            id: PREDICTION_UNTRACKED_GROUP_ID,
+            name: PREDICTION_UNTRACKED_GROUP_NAME,
+            options: [...usdc, ...groups.flatMap((g) => g.options)],
+          },
+        ]
+    const settled = options(selection.settled)
+    return { open: open.filter((section) => section.options.length), settled: settled.length ? settled : undefined }
+    // oxlint-disable-next-line react-hooks/exhaustive-deps -- `signature` stands for `selection`
+  }, [chainId, version, signature, hasTracks])
+}
