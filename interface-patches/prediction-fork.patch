+++ b/packages/uniswap/src/features/predictionMarkets/chart/usePredictionPriceHistory.ts
@@ -0,0 +1,66 @@
+import { useCallback, useMemo, useSyncExternalStore } from 'react'
+import {
+  getMarketHistorySnapshot,
+  subscribeMarketHistory,
+} from 'uniswap/src/features/predictionMarkets/chart/predictionPriceHistory'
+import {
+  buildPredictionSeries,
+  outcomeValue,
+  type PredictionPricePoint,
+} from 'uniswap/src/features/predictionMarkets/chart/priceHistory'
+import { getPredictionToken, usePredictionRegistry } from 'uniswap/src/features/predictionMarkets/registry'
+import type { OutcomeTokenInfo } from 'uniswap/src/features/predictionMarkets/sdk'
+
+type CurrencyLike = { chainId: number; isToken: boolean; address?: string }
+
+export interface PredictionPriceHistory {
+  entries: PredictionPricePoint[]
+  loading: boolean
+  isError: boolean
+  /** Payout per token once the market is settled */
+  outcome?: number
+}
+
+function tokenAddress(currency: CurrencyLike | undefined): string | undefined {
+  return currency?.isToken ? currency.address : undefined
+}
+
+/** The YES or NO token behind `currency`, re-rendering when the market registry loads it */
+export function usePredictionOutcomeToken(currency: CurrencyLike | undefined): OutcomeTokenInfo | undefined {
+  const address = tokenAddress(currency)
+  usePredictionRegistry(currency?.chainId, address)
+  return getPredictionToken(currency?.chainId, address)
+}
+
+function noopSubscribe(): () => void {
+  return () => undefined
+}
+
+/** On-chain price history for a YES/NO token, or undefined for every other currency */
+export function usePredictionPriceHistory(
+  currency: CurrencyLike | undefined,
+  { skip = false }: { skip?: boolean } = {},
+): PredictionPriceHistory | undefined {
+  const token = usePredictionOutcomeToken(currency)
+  const marketId = token?.marketId
+  const subscribe = useCallback(
+    (listener: () => void) => (marketId === undefined ? () => undefined : subscribeMarketHistory(marketId, listener)),
+    [marketId],
+  )
+  const getSnapshot = useCallback(() => getMarketHistorySnapshot(marketId), [marketId])
+  const snapshot = useSyncExternalStore(skip ? noopSubscribe : subscribe, getSnapshot, getSnapshot)
+  const isYes = token?.isYes
+
+  return useMemo(() => {
+    if (isYes === undefined) {
+      return undefined
+    }
+    const { market, points, loading, isError } = snapshot
+    return {
+      entries: buildPredictionSeries({ points, isYes, market }),
+      loading,
+      isError,
+      outcome: market ? outcomeValue(market, isYes) : undefined,
+    }
+  }, [snapshot, isYes])
+}
diff --git a/packages/uniswap/src/features/predictionMarkets/config.ts b/packages/uniswap/src/features/predictionMarkets/config.ts
new file mode 100644
index 0000000..260e488
--- /dev/null
+++ b/packages/uniswap/src/features/predictionMarkets/config.ts
@@ -0,0 +1,131 @@
+import { UniverseChainId } from '@universe/chains'
+import { PREDICTION_DEPLOYMENT_JSON } from 'uniswap/src/features/predictionMarkets/deployment.generated'
+import {
+  isPlaceholderAddress,
+  parseDeployment,
+  type PredictionDeployment,
+  sameAddress,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import { type Address, getAddress } from 'viem'
+
+/** Prediction markets live only on Unichain Sepolia, against Uniswap v4 "Stack A" and UniversalRouter 2.0. */
+export const PREDICTION_CHAIN_ID = UniverseChainId.UnichainSepolia
+
+/** Public RPC used for chain 1301 everywhere in the fork; already allowed by the app CSP (`https://*.drpc.org/`). */
+export const PREDICTION_RPC_URL = 'https://unichain-sepolia.drpc.org'
+
+export const PREDICTION_QUOTE_POLL_MS = 1_000
+export const PREDICTION_REGISTRY_POLL_MS = 5_000
+/** Newest markets read on every registry poll; older tokens are resolved on demand via `OutcomeToken.hook()`. */
+export const PREDICTION_REGISTRY_WINDOW = 40
+/**
+ * Slots read per track on every registry poll (`scheduler.marketOfSlot(slot)` for the current slot and the ones before
+ * it), so a slow track's markets stay listed however many faster markets opened since.
+ */
+export const PREDICTION_TRACK_SLOTS = 3
+/**
+ * Auto slippage covers this many seconds of price movement between the quote and inclusion (wallet confirmation plus a
+ * block). It is sized per trade from the market's time to expiry, see `autoSlippageBps`.
+ */
+export const PREDICTION_CONFIRM_SECONDS = 5
+/** Auto slippage for a market the registry has not loaded yet (its expiry is unknown). */
+export const PREDICTION_FALLBACK_SLIPPAGE_PERCENT = 25
+/** UniversalRouter + Permit2 + settle/take on top of the quoter's own gas estimate. */
+export const PREDICTION_ROUTER_GAS_OVERHEAD = 120_000n
+/**
+ * Gas limit when the swap cannot be simulated yet (first trade: approval still pending). Unichain charges gas used,
+ * so this is generous; the limit is also at least twice the quoter's estimate plus a Permit2 permit.
+ */
+export const PREDICTION_SWAP_GAS_LIMIT_FALLBACK = 1_000_000n
+export const PREDICTION_PERMIT_GAS_OVERHEAD = 100_000n
+export const PREDICTION_APPROVAL_GAS_LIMIT = 60_000n
+/** `Permit2.approve` sent as a transaction for wallets that cannot sign permits (smart accounts). */
+export const PREDICTION_PERMIT2_APPROVE_GAS_LIMIT = 80_000n
+export const PREDICTION_PERMIT2_APPROVE_SECONDS = 30 * 24 * 60 * 60
+/** Swap deadline when the request carries none (seconds). */
+export const PREDICTION_DEFAULT_DEADLINE_SECONDS = 30 * 60
+
+/** `localStorage` key that overrides the hook address without a rebuild (demo convenience). */
+export const PREDICTION_HOOK_STORAGE_KEY = 'prediction.hook'
+
+function readHookOverride(): Address | undefined {
+  try {
+    const value = typeof localStorage === 'undefined' ? null : localStorage.getItem(PREDICTION_HOOK_STORAGE_KEY)
+    return value && !isPlaceholderAddress(value) ? getAddress(value) : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** One price source from the deployment's `underlyings` list */
+export interface PredictionUnderlying {
+  /** "ETH", "SOL" */
+  symbol: string
+  token?: Address
+  oracle?: Address
+}
+
+/**
+ * Market tracks. A deployment from before the MarketGatekeeper has neither key but a single `marketScheduler`, which
+ * becomes the only entry of `marketSchedulers`.
+ */
+export interface PredictionTracksDeployment {
+  /** The PredictionHook owner that forwards `createMarket` from the track schedulers */
+  marketGatekeeper?: Address
+  /** One MarketScheduler per track, in the gatekeeper's order */
+  marketSchedulers: Address[]
+  /** Without an `underlyings` key, one ETH entry built from the flat `underlyingOracle` and `demoWeth` keys */
+  underlyings: PredictionUnderlying[]
+}
+
+export type PredictionForkDeployment = PredictionDeployment & PredictionTracksDeployment
+
+function jsonAddress(value: unknown): Address | undefined {
+  return typeof value === 'string' && !isPlaceholderAddress(value) ? getAddress(value) : undefined
+}
+
+function jsonAddressList(value: unknown): Address[] {
+  return Array.isArray(value) ? value.map(jsonAddress).filter((a): a is Address => !!a) : []
+}
+
+export function parseTracksDeployment(json: Record<string, unknown>): PredictionTracksDeployment {
+  const schedulers = jsonAddressList(json['marketSchedulers'])
+  const legacyScheduler = jsonAddress(json['marketScheduler'])
+  const underlyings = Array.isArray(json['underlyings'])
+    ? json['underlyings'].flatMap((u: unknown): PredictionUnderlying[] => {
+        const entry = u && typeof u === 'object' ? (u as Record<string, unknown>) : {}
+        const symbol = entry['symbol']
+        return typeof symbol === 'string' && symbol
+          ? [{ symbol, token: jsonAddress(entry['token']), oracle: jsonAddress(entry['oracle']) }]
+          : []
+      })
+    : undefined
+  const ethOracle = jsonAddress(json['underlyingOracle'])
+  return {
+    marketGatekeeper: jsonAddress(json['marketGatekeeper']),
+    marketSchedulers: schedulers.length ? schedulers : legacyScheduler ? [legacyScheduler] : [],
+    underlyings:
+      underlyings ?? (ethOracle ? [{ symbol: 'ETH', token: jsonAddress(json['demoWeth']), oracle: ethOracle }] : []),
+  }
+}
+
+let cached: PredictionForkDeployment | undefined
+
+/**
+ * Contracts from `deployment.generated.ts` (Uniswap defaults for anything missing), plus the optional hook override.
+ * An overriding hook other than the deployment's has no known tracks.
+ */
+export function getPredictionDeployment(): PredictionForkDeployment {
+  cached ??= { ...parseDeployment(PREDICTION_DEPLOYMENT_JSON), ...parseTracksDeployment(PREDICTION_DEPLOYMENT_JSON) }
+  const hook = readHookOverride()
+  if (!hook) {
+    return cached
+  }
+  return sameAddress(hook, cached.predictionHook)
+    ? { ...cached, predictionHook: hook }
+    : { ...cached, predictionHook: hook, marketGatekeeper: undefined, marketSchedulers: [] }
+}
+
+export function isPredictionChain(chainId: number | undefined): boolean {
+  return chainId === PREDICTION_CHAIN_ID
+}
