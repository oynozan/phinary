@@ -0,0 +1,186 @@
+import { waitFor } from '@testing-library/react-native'
+import { Token } from '@uniswap/sdk-core'
+import { SharedQueryClient } from '@universe/api'
+import { registerPredictionMarkets, resetPredictionRegistry } from 'uniswap/src/features/predictionMarkets/registry'
+import {
+  type HookQuote,
+  type Market,
+  type MarketInfo,
+  predictionPoolKey,
+  UNICHAIN_SEPOLIA,
+  WAD,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import { makePredictionTrack, type PredictionTrack } from 'uniswap/src/features/predictionMarkets/tracks'
+import { predictionFetchError } from 'uniswap/src/features/predictionMarkets/tradingApiFormat'
+import type { PredictionMarketLive } from 'uniswap/src/features/predictionMarkets/ui/predictionMarketLive'
+import { PredictionMarketPanel } from 'uniswap/src/features/predictionMarkets/ui/PredictionMarketPanel'
+import { renderWithProviders } from 'uniswap/src/test/render'
+import { CurrencyField } from 'uniswap/src/types/currency'
+import { getAddress } from 'viem'
+
+const state = vi.hoisted(() => ({
+  derived: {} as Record<string, unknown>,
+  live: undefined as PredictionMarketLive | undefined,
+  track: undefined as PredictionTrack | undefined,
+}))
+
+vi.mock('uniswap/src/features/transactions/swap/stores/swapFormStore/useSwapFormStore', () => ({
+  useSwapFormStoreDerivedSwapInfo: (selector: (s: unknown) => unknown): unknown => selector(state.derived),
+}))
+
+vi.mock('uniswap/src/features/predictionMarkets/registry', async (importOriginal) => ({
+  ...(await importOriginal<object>()),
+  usePredictionRegistry: (): number => 0,
+  getPredictionTokenTrack: (): PredictionTrack | undefined => state.track,
+}))
+
+vi.mock('uniswap/src/features/predictionMarkets/ui/predictionMarketLive', () => ({
+  predictionMarketLiveQueryOptions: (ref?: { marketId: bigint }): object => ({
+    queryKey: ['predictionMarketLive-test', ref?.marketId.toString()],
+    queryFn: (): PredictionMarketLive | undefined => state.live,
+    enabled: !!ref,
+  }),
+}))
+
+const HOOK = getAddress('0x00000000000000000000000000000000c0de2aa8')
+// The vendored deployment's ETH oracle (`underlyingOracle`), so the market reads as an ETH market
+const ETH_ORACLE = getAddress('0x1F356D9E7d6dBE6d807aCBc5D163a7af265cd080')
+const SOL_ORACLE = getAddress('0x0000000000000000000000000000000000002080')
+const USDC = UNICHAIN_SEPOLIA.usdc
+const YES = getAddress('0xfe00000000000000000000000000000000000001')
+const NO = getAddress('0x0100000000000000000000000000000000000001')
+const usdc = new Token(1301, USDC, 6, 'USDC', 'USDC')
+const yes = new Token(1301, YES, 6, 'YES', 'YES')
+
+// ln(2691.96) in WAD
+const LN_STRIKE = 7_898_024_831_813_214_351n
+
+function info(overrides: Partial<MarketInfo> = {}): MarketInfo {
+  const expiry = BigInt(Math.floor(Date.now() / 1000) + 35)
+  return {
+    yes: YES,
+    no: NO,
+    oracle: ETH_ORACLE,
+    lnStrikeWad: LN_STRIKE,
+    openTime: expiry - 60n,
+    expiry,
+    window: 10,
+    cutoffBuffer: 2,
+    status: 1,
+    yesWon: false,
+    bucket: 0n,
+    outYes: 0n,
+    outNo: 0n,
+    invYes: 0n,
+    invNo: 0n,
+    ...overrides,
+  }
+}
+
+function market(i: MarketInfo, ticker?: string): Market {
+  const token = (isYes: boolean): Market['yes'] => ({
+    address: isYes ? YES : NO,
+    symbol: ticker ? `${ticker}${isYes ? 'UP' : 'DOWN'}` : isYes ? 'YES' : 'NO',
+    name: isYes ? 'YES' : 'NO',
+    decimals: 6,
+    isYes,
+    marketId: 7n,
+    poolKey: predictionPoolKey({ token: isYes ? YES : NO, usdc: USDC, hook: HOOK }),
+  })
+  return {
+    id: 7n,
+    hook: HOOK,
+    status: 'Trading',
+    info: i,
+    yes: token(true),
+    no: token(false),
+    strikeUsd: 2691.96,
+    cutoff: i.expiry - 12n,
+  }
+}
+
+const quote: HookQuote = {
+  tradable: true,
+  tau: 35n,
+  varE36: 0n,
+  xWad: 0n,
+  midYes: (WAD * 503n) / 1000n,
+  askYes: (WAD * 546n) / 1000n,
+  bidYes: (WAD * 460n) / 1000n,
+  askNo: (WAD * 540n) / 1000n,
+  bidNo: (WAD * 454n) / 1000n,
+}
+
+function selectPair(error: Error | null = null): void {
+  state.derived = {
+    chainId: 1301,
+    currencies: { [CurrencyField.INPUT]: { currency: usdc }, [CurrencyField.OUTPUT]: { currency: yes } },
+    trade: { error },
+  }
+}
+
+describe('PredictionMarketPanel', () => {
+  beforeEach(() => {
+    resetPredictionRegistry()
+    SharedQueryClient.clear()
+    state.track = undefined
+  })
+
+  it('renders nothing for tokens that are not YES/NO outcome tokens', () => {
+    state.derived = {
+      chainId: 1,
+      currencies: { [CurrencyField.INPUT]: { currency: usdc } },
+      trade: { error: null },
+    }
+    const { queryByTestId } = renderWithProviders(<PredictionMarketPanel />)
+    expect(queryByTestId('prediction-market-panel')).toBeNull()
+  })
+
+  it('shows the question, live prices, the countdown and why the typed amount cannot trade', async () => {
+    const live = info()
+    registerPredictionMarkets([market(live)])
+    state.live = { info: live, quote, spotUsd: 2695.12 }
+    selectPair(
+      predictionFetchError({ detail: 'x', extra: { predictionCode: 'OUT_OF_BAND', isYes: true, isBuy: true } }),
+    )
+    const { getByText } = renderWithProviders(<PredictionMarketPanel />)
+    expect(getByText(/ETH above \$2,691\.96 at \d\d:\d\d:\d\d UTC\?/)).toBeTruthy()
+    expect(getByText('Trading')).toBeTruthy()
+    expect(getByText(/Trading closes in 0:2[23]/)).toBeTruthy()
+    await waitFor(() => expect(getByText('Ask $0.546 · Bid $0.460')).toBeTruthy())
+    expect(getByText('Ask $0.540 · Bid $0.454')).toBeTruthy()
+    expect(getByText(/ETH \$2,695\.12, \$3\.16 above strike/)).toBeTruthy()
+    expect(getByText(/outside the band the market quotes/)).toBeTruthy()
+  })
+
+  it('names the market asset and track, and prices it from the market oracle', async () => {
+    const live = info({ oracle: SOL_ORACLE, lnStrikeWad: 5_018_603_463_745_432_548n })
+    registerPredictionMarkets([{ ...market(live, 'SOL15M'), strikeUsd: 151.2 }])
+    state.track = makePredictionTrack({
+      scheduler: getAddress('0x0000000000000000000000000000000000005c04'),
+      oracle: SOL_ORACLE,
+      ticker: 'SOL15M',
+      periodSec: 900,
+      tenorSec: 900,
+      underlyings: [{ symbol: 'SOL', oracle: SOL_ORACLE }],
+    })
+    state.live = { info: live, quote, spotUsd: 151.35 }
+    selectPair()
+    const { getByText, queryByText } = renderWithProviders(<PredictionMarketPanel />)
+    expect(getByText(/^SOL above \$151\.20 at \d\d:\d\d:\d\d UTC\?$/)).toBeTruthy()
+    await waitFor(() => expect(getByText(/15-minute market · SOL \$151\.35, \$0\.15 above strike/)).toBeTruthy())
+    expect(queryByText(/ETH/)).toBeNull()
+  })
+
+  it('tells a holder of the losing token that it cannot be sold', async () => {
+    const settled = info({ status: 2, yesWon: false, expiry: BigInt(Math.floor(Date.now() / 1000) - 20) })
+    registerPredictionMarkets([market(settled)])
+    state.live = { info: settled, quote: undefined, spotUsd: 2690 }
+    selectPair()
+    const { getByText, queryByText } = renderWithProviders(<PredictionMarketPanel />)
+    await waitFor(() => expect(getByText('Settled: NO won')).toBeTruthy())
+    expect(getByText('NO won - YES is worth $0 and cannot be sold')).toBeTruthy()
+    expect(getByText('Pays $1.00')).toBeTruthy()
+    expect(queryByText(/above strike|below strike/)).toBeNull()
+  })
+})
