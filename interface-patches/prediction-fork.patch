@@ -0,0 +1,391 @@
+import { normalizeTokenAddressForCache } from '@universe/chains'
+import { useEffect, useSyncExternalStore } from 'react'
+import {
+  getPredictionDeployment,
+  isPredictionChain,
+  type PredictionForkDeployment,
+  PREDICTION_QUOTE_POLL_MS,
+  PREDICTION_REGISTRY_POLL_MS,
+  PREDICTION_REGISTRY_WINDOW,
+  PREDICTION_TRACK_SLOTS,
+} from 'uniswap/src/features/predictionMarkets/config'
+import { getPredictionPublicClient } from 'uniswap/src/features/predictionMarkets/rpc'
+import {
+  isPlaceholderAddress,
+  listMarkets,
+  type Market,
+  type OutcomeTokenInfo,
+  type PoolKey,
+  resolveOutcomeToken,
+  sameAddress,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  classifyBySymbol,
+  MARKET_GATEKEEPER_ABI,
+  type PredictionTrack,
+  readPredictionMarketsByIds,
+  readPredictionTracks,
+  TRACK_SCHEDULER_ABI,
+} from 'uniswap/src/features/predictionMarkets/tracks'
+import { logger } from 'utilities/src/logger/logger'
+import type { Address, Client } from 'viem'
+import { multicall } from 'viem/actions'
+
+/** Outcome tokens discovered from the hook's market registry, keyed by lowercase address. */
+const tokens = new Map<string, OutcomeTokenInfo>()
+const markets = new Map<string, Market>()
+const foreign = new Set<string>()
+const pending = new Map<string, Promise<OutcomeTokenInfo | undefined>>()
+const listeners = new Set<() => void>()
+/** Market id -> the scheduler that opened it, from `gatekeeper.schedulerOf` or `scheduler.marketOfSlot` */
+const marketSchedulers = new Map<string, Address>()
+let tracks: PredictionTrack[] = []
+/** The gatekeeper and scheduler list `tracks` were read for; undefined until a read succeeds */
+let tracksSource: string | undefined
+let version = 0
+let timer: ReturnType<typeof setInterval> | undefined
+let inflight: Promise<void> | undefined
+
+function notify(): void {
+  version++
+  for (const l of listeners) {
+    l()
+  }
+}
+
+/** Adds markets (and their YES/NO tokens) to the registry. Returns true when anything changed. */
+export function registerPredictionMarkets(list: readonly Market[]): boolean {
+  let changed = false
+  for (const m of list) {
+    const prev = markets.get(m.id.toString())
+    if (!prev || prev.status !== m.status) {
+      changed = true
+    }
+    markets.set(m.id.toString(), m)
+    for (const t of [m.yes, m.no]) {
+      const key = normalizeTokenAddressForCache(t.address)
+      if (!tokens.has(key)) {
+        tokens.set(key, t)
+        changed = true
+      }
+    }
+  }
+  if (changed) {
+    notify()
+  }
+  return changed
+}
+
+function registerToken(t: OutcomeTokenInfo): void {
+  const key = normalizeTokenAddressForCache(t.address)
+  if (!tokens.has(key)) {
+    tokens.set(key, t)
+    notify()
+  }
+}
+
+async function ensureTracks(client: Client, d: PredictionForkDeployment): Promise<void> {
+  const source = [d.marketGatekeeper ?? '', ...d.marketSchedulers].join(',').toLowerCase()
+  if (tracksSource === source) {
+    return
+  }
+  const next = await readPredictionTracks(client, {
+    gatekeeper: d.marketGatekeeper,
+    schedulers: d.marketSchedulers,
+    underlyings: d.underlyings,
+    multicallAddress: d.multicall3,
+  })
+  tracks = next
+  tracksSource = source
+  marketSchedulers.clear()
+  notify()
+}
+
+/**
+ * Classifies `list` with `gatekeeper.schedulerOf` and registers each track's markets of the last
+ * `PREDICTION_TRACK_SLOTS` slots, which the newest-N window can miss for a slow track. Markets outside the window are
+ * re-read until they are settled.
+ */
+async function refreshTrackMarkets({
+  client,
+  d,
+  hook,
+  list,
+}: {
+  client: Client
+  d: PredictionForkDeployment
+  hook: Address
+  list: readonly Market[]
+}): Promise<void> {
+  const gatekeeper = d.marketGatekeeper
+  if (!gatekeeper || !tracks.length) {
+    return
+  }
+  const now = Math.floor(Date.now() / 1000)
+  const slots = tracks.flatMap((t) =>
+    Array.from({ length: PREDICTION_TRACK_SLOTS }, (_, i) => ({
+      track: t,
+      slot: BigInt(Math.floor(now / t.periodSec) - i),
+    })),
+  )
+  const unclassified = list.filter((m) => !marketSchedulers.has(m.id.toString())).map((m) => m.id)
+  const results = await multicall(client, {
+    contracts: [
+      ...slots.map(
+        ({ track, slot }) =>
+          ({ address: track.scheduler, abi: TRACK_SCHEDULER_ABI, functionName: 'marketOfSlot', args: [slot] }) as const,
+      ),
+      ...unclassified.map(
+        (id) => ({ address: gatekeeper, abi: MARKET_GATEKEEPER_ABI, functionName: 'schedulerOf', args: [id] }) as const,
+      ),
+    ],
+    allowFailure: true,
+    multicallAddress: d.multicall3,
+  })
+  const classify = (id: bigint, scheduler: Address): boolean => {
+    if (sameAddress(marketSchedulers.get(id.toString()), scheduler)) {
+      return false
+    }
+    marketSchedulers.set(id.toString(), scheduler)
+    return true
+  }
+  let classified = false
+  const trackIds: bigint[] = []
+  for (const [i, { track }] of slots.entries()) {
+    const r = results[i]
+    if (r?.status === 'success' && typeof r.result === 'bigint' && r.result > 0n) {
+      classified = classify(r.result, track.scheduler) || classified
+      trackIds.push(r.result)
+    }
+  }
+  for (const [i, id] of unclassified.entries()) {
+    const r = results[slots.length + i]
+    if (r?.status === 'success' && typeof r.result === 'string') {
+      // The zero address (an id the gatekeeper never created) is cached too, and leaves the symbol fallback
+      classified = classify(id, r.result as Address) || classified
+    }
+  }
+  const inWindow = new Set(list.map((m) => m.id.toString()))
+  const stale = trackIds.filter((id) => {
+    const known = markets.get(id.toString())
+    return !inWindow.has(id.toString()) && known?.status !== 'Settled' && known?.status !== 'Invalid'
+  })
+  const changed = registerPredictionMarkets(
+    await readPredictionMarketsByIds(client, { hook, ids: stale, multicallAddress: d.multicall3 }),
+  )
+  if (classified && !changed) {
+    notify()
+  }
