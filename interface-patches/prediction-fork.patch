+import { Token } from '@uniswap/sdk-core'
+import { SelectTokenButton } from 'uniswap/src/components/CurrencyInputPanel/SelectTokenButton'
+import { BaseTokenOptionItem } from 'uniswap/src/components/lists/items/tokens/TokenOptionItem/BaseTokenOptionItem'
+import { TokenContextMenuVariant } from 'uniswap/src/components/lists/items/tokens/TokenOptionItem/types'
+import { OnchainItemListOptionType } from 'uniswap/src/components/lists/items/types'
+import { getCommonBase } from 'uniswap/src/constants/routing'
+import { registerPredictionMarkets, resetPredictionRegistry } from 'uniswap/src/features/predictionMarkets/registry'
+import { type Market, predictionPoolKey, UNICHAIN_SEPOLIA } from 'uniswap/src/features/predictionMarkets/sdk'
+import { getCurrencySymbolDisplayText } from 'uniswap/src/features/predictionMarkets/symbolDisplay'
+import { renderWithProviders } from 'uniswap/src/test/render'
+import { getAddress, zeroAddress } from 'viem'
+
+const HOOK = getAddress('0x00000000000000000000000000000000c0de2aa8')
+const YES = getAddress('0xfe000000000000000000000000000000000000a1')
+const NO = getAddress('0x01000000000000000000000000000000000000a1')
+const OTHER = getAddress('0xdead0000000000000000000000000000000000a1')
+
+function market15m(): Market {
+  const token = (isYes: boolean): Market['yes'] => ({
+    address: isYes ? YES : NO,
+    symbol: isYes ? 'ETH15MUP' : 'ETH15MDOWN',
+    name: `ETH15M ${isYes ? '>' : '<'} $2690.13 26 Sep 14:15`,
+    decimals: 6,
+    isYes,
+    marketId: 161n,
+    poolKey: predictionPoolKey({ token: isYes ? YES : NO, usdc: UNICHAIN_SEPOLIA.usdc, hook: HOOK }),
+  })
+  return {
+    id: 161n,
+    hook: HOOK,
+    status: 'Trading',
+    info: {
+      yes: YES,
+      no: NO,
+      oracle: zeroAddress,
+      lnStrikeWad: 0n,
+      openTime: 0n,
+      expiry: 900n,
+      window: 30,
+      cutoffBuffer: 2,
+      status: 1,
+      yesWon: false,
+      bucket: 0n,
+      outYes: 0n,
+      outNo: 0n,
+      invYes: 0n,
+      invNo: 0n,
+    },
+    yes: token(true),
+    no: token(false),
+    strikeUsd: 2690.13,
+    cutoff: 868n,
+  }
+}
+
+describe('outcome token symbols', () => {
+  beforeEach(() => {
+    resetPredictionRegistry()
+    registerPredictionMarkets([market15m()])
+  })
+
+  it('shows registered outcome tokens in full and cuts other long symbols as before', () => {
+    expect(getCurrencySymbolDisplayText(new Token(1301, NO, 6, 'ETH15MDOWN'))).toBe('ETH15MDOWN')
+    expect(getCurrencySymbolDisplayText(new Token(1301, OTHER, 6, 'ETH15MDOWN'))).toBe('ETH15…')
+    // The same address on another chain is not ours
+    expect(getCurrencySymbolDisplayText(new Token(1, NO, 6, 'ETH15MDOWN'))).toBe('ETH15…')
+    expect(getCurrencySymbolDisplayText(new Token(1301, OTHER, 6, 'USDC'))).toBe('USDC')
+    expect(getCurrencySymbolDisplayText(undefined)).toBeUndefined()
+  })
+
+  it('shows the full symbol on the swap form token button', () => {
+    const { getByText } = renderWithProviders(
+      <SelectTokenButton selectedCurrencyInfo={getCommonBase(1301, NO)} testID={undefined} onPress={(): void => {}} />,
+    )
+    expect(getByText('ETH15MDOWN')).toBeTruthy()
+  })
+
+  it('shows the full symbol in the token selector row', () => {
+    const currencyInfo = getCommonBase(1301, YES)
+    if (!currencyInfo) {
+      throw new Error('outcome token not registered')
+    }
+    const { getByText } = renderWithProviders(
+      <BaseTokenOptionItem
+        option={{ type: OnchainItemListOptionType.Token, currencyInfo, quantity: null, balanceUSD: undefined }}
+        contextMenuVariant={TokenContextMenuVariant.TokenSelector}
+        onPress={(): void => {}}
+      />,
+    )
+    expect(getByText('ETH15MUP')).toBeTruthy()
+  })
+})
