+        oracle: t.oracle,
+        ticker: t.ticker,
+        periodSec: t.period,
+        tenorSec: t.period,
+        underlyings: [
+          { symbol: 'ETH', oracle: ETH_ORACLE },
+          { symbol: 'SOL', oracle: SOL_ORACLE },
+        ],
+      }),
+    ),
+  )
+
+  it('orders by asset in first-seen order, then by period', () => {
+    expect(tracks.map((t) => t.ticker)).toEqual(['SOL1M', 'SOL15M', 'ETH1M', 'ETH15M'])
+  })
+
+  it('classifies an outcome symbol by exact ticker match only', () => {
+    expect(classifyBySymbol('ETH1MUP', tracks)?.ticker).toBe('ETH1M')
+    expect(classifyBySymbol('ETH15MDOWN', tracks)?.ticker).toBe('ETH15M')
+    expect(classifyBySymbol('SOL1MDOWN', tracks)?.ticker).toBe('SOL1M')
+    expect(classifyBySymbol('ETHUP', tracks)).toBeUndefined()
+    expect(classifyBySymbol('ETH15MUPX', tracks)).toBeUndefined()
+    // The pre-gatekeeper "ETH" ticker is a prefix of "ETH15M"; prefixes never match
+    const legacy = makePredictionTrack({
+      scheduler: ETH1M.scheduler,
+      ticker: 'ETH',
+      periodSec: 60,
+      tenorSec: 120,
+      underlyings: [],
+    })
+    expect(classifyBySymbol('ETH15MUP', [legacy, ...tracks])?.ticker).toBe('ETH15M')
+    expect(classifyBySymbol('ETHDOWN', [legacy, ...tracks])?.label).toBe('ETH 2-minute')
+  })
+
+  it('names durations and assets', () => {
+    expect([60, 900, 120, 3_600, 86_400, 90].map(formatTrackDuration)).toEqual([
+      '1-minute',
+      '15-minute',
+      '2-minute',
+      '1-hour',
+      '1-day',
+      '90-second',
+    ])
+    expect(['ETH1M', 'ETH15M', 'SOL1M', 'ETH'].map(assetFromTicker)).toEqual(['ETH', 'ETH', 'SOL', 'ETH'])
+    const underlyings = [{ symbol: 'SOL', oracle: SOL_ORACLE }]
+    expect(predictionMarketAsset({ oracle: SOL_ORACLE, underlyings })).toBe('SOL')
+    expect(predictionMarketAsset({ symbol: 'ETH15MDOWN', underlyings })).toBe('ETH')
+    expect(predictionMarketAsset({ symbol: 'YES', oracle: zeroAddress, underlyings })).toBeUndefined()
+  })
+
+  it('reads the pre-gatekeeper deployment: its single scheduler, and ETH from the flat oracle keys', () => {
+    const legacy = parseTracksDeployment({
