+      underlyingOracle: ETH_ORACLE,
+      demoWeth: '0x7fcf39acb2934d1A93D6469AE8DE0EcF33eb26E5',
+    })
+    expect(legacy).toEqual({
+      marketGatekeeper: undefined,
+      marketSchedulers: [getAddress('0x511fFFb9fE5d393B10bF185A9c580A732Eff44Dd')],
+      underlyings: [
+        { symbol: 'ETH', token: getAddress('0x7fcf39acb2934d1A93D6469AE8DE0EcF33eb26E5'), oracle: ETH_ORACLE },
+      ],
+    })
+    expect(parseTracksDeployment({})).toEqual({ marketGatekeeper: undefined, marketSchedulers: [], underlyings: [] })
+    expect(
+      parseTracksDeployment({
+        marketGatekeeper: GATEKEEPER,
+        marketSchedulers: [ETH1M.scheduler, 'TBD', ETH15M.scheduler],
+        marketScheduler: '0x511fFFb9fE5d393B10bF185A9c580A732Eff44Dd',
+        underlyings: [{ symbol: 'SOL', oracle: SOL_ORACLE }, { oracle: ETH_ORACLE }],
+      }),
+    ).toEqual({
