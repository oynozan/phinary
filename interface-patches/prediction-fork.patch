+import type { Currency } from '@uniswap/sdk-core'
+import { getPredictionToken } from 'uniswap/src/features/predictionMarkets/registry'
+import { getSymbolDisplayText } from 'uniswap/src/utils/currency'
+
+/**
+ * The symbol to show for a currency: our outcome tokens in full (a 15-minute track's "ETH15MDOWN" is 10 characters,
+ * and the stock 6-character cut would show "ETH15…" for both of its sides), anything else as `getSymbolDisplayText`.
+ */
+export function getCurrencySymbolDisplayText(currency: Maybe<Currency>): Maybe<string> {
+  if (currency?.isToken && getPredictionToken(currency.chainId, currency.address)) {
+    return currency.symbol
+  }
+  return getSymbolDisplayText(currency?.symbol)
+}
