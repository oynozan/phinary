+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, renderHook, waitFor } from '@testing-library/react'
+import { CurrencyAmount, Token, TradeType } from '@uniswap/sdk-core'
+import { FetchError, TradingApi } from '@universe/api'
+import type { PropsWithChildren } from 'react'
+import { registerPredictionMarkets, resetPredictionRegistry } from 'uniswap/src/features/predictionMarkets/registry'
+import { type Market, predictionPoolKey, UNICHAIN_SEPOLIA } from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  getPredictionErrorData,
+  PREDICTION_RPC_ERROR_CODE,
+  predictionFetchError,
+  toPredictionFetchError,
+} from 'uniswap/src/features/predictionMarkets/tradingApiFormat'
+import { usePredictionSwapTxPlaceholder } from 'uniswap/src/features/predictionMarkets/ui/usePredictionSwapTxPlaceholder'
+import { useTradeQuery } from 'uniswap/src/features/transactions/swap/hooks/useTrade/useTradeQuery'
+import type { Trade, UseTradeArgs } from 'uniswap/src/features/transactions/swap/types/trade'
+import { getAddress, zeroAddress } from 'viem'
+
+const service = vi.hoisted(() => ({
+  getTrade: vi.fn(),
+  prepareTradeInput: (params?: { amountSpecified?: { toExact: () => string; currency: { symbol?: string } } }) =>
+    params?.amountSpecified
+      ? { amount: params.amountSpecified.toExact(), symbol: params.amountSpecified.currency.symbol }
+      : null,
+}))
+
+vi.mock('uniswap/src/features/services', () => ({ useTradeService: () => service }))
+vi.mock('uniswap/src/features/transactions/hooks/usePollingIntervalByChain', () => ({
+  usePollingIntervalByChain: () => 1_000,
+  useQuoteRefetchIntervalForChain: () => 1_000,
+}))
+
+const HOOK = getAddress('0x00000000000000000000000000000000c0de2aa8')
+const USDC_ADDRESS = UNICHAIN_SEPOLIA.usdc
+const YES = getAddress('0xfe00000000000000000000000000000000000001')
+const NO = getAddress('0x0100000000000000000000000000000000000001')
+const usdc = new Token(1301, USDC_ADDRESS, 6, 'USDC', 'USDC')
+const yes = new Token(1301, YES, 6, 'YES', 'YES')
+const no = new Token(1301, NO, 6, 'NO', 'NO')
+const dai = new Token(1, getAddress('0x6b175474e89094c44da98b954eedeac495271d0f'), 18, 'DAI', 'DAI')
+const weth = new Token(1, getAddress('0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2'), 18, 'WETH', 'WETH')
+
+function market(): Market {
+  const token = (isYes: boolean): Market['yes'] => ({
+    address: isYes ? YES : NO,
+    symbol: isYes ? 'YES' : 'NO',
+    name: isYes ? 'YES' : 'NO',
+    decimals: 6,
+    isYes,
+    marketId: 1n,
+    poolKey: predictionPoolKey({ token: isYes ? YES : NO, usdc: USDC_ADDRESS, hook: HOOK }),
+  })
+  const expiry = BigInt(Math.floor(Date.now() / 1000) + 3_600)
+  return {
+    id: 1n,
+    hook: HOOK,
+    status: 'Trading',
+    info: {
+      yes: YES,
+      no: NO,
+      oracle: zeroAddress,
+      lnStrikeWad: 0n,
+      openTime: 0n,
+      expiry,
+      window: 10,
+      cutoffBuffer: 2,
+      status: 1,
+      yesWon: false,
+      bucket: 0n,
+      outYes: 0n,
+      outNo: 0n,
+      invYes: 0n,
+      invNo: 0n,
+    },
+    yes: token(true),
+    no: token(false),
+    strikeUsd: 2_700,
+    cutoff: expiry - 12n,
+  }
+}
+
+function args(input: Token, output: Token): UseTradeArgs {
+  return {
+    account: undefined,
+    amountSpecified: CurrencyAmount.fromRawAmount(input, 1_000_000),
+    otherCurrency: output,
+    tradeType: TradeType.EXACT_INPUT,
+  } as unknown as UseTradeArgs
+}
+
+function wrapper({ children }: PropsWithChildren): JSX.Element {
+  const client = new QueryClient({ defaultOptions: { queries: { retryDelay: 10 } } })
+  return <QueryClientProvider client={client}>{children}</QueryClientProvider>
+}
+
+const FIRST_TRADE = { quoteHash: 'first', trade: { id: 'first' } }
+
+const closedError = (): FetchError =>
+  predictionFetchError({ detail: 'closed', extra: { predictionCode: 'MARKET_CLOSED', revert: 'NotTradable' } })
+
+describe('useTradeQuery with outcome tokens', () => {
+  beforeEach(() => {
+    resetPredictionRegistry()
+    registerPredictionMarkets([market()])
+    service.getTrade.mockReset()
+  })
+
+  it('drops the last quote once the hook rejects the pair, without flickering back to loading', async () => {
+    service.getTrade.mockResolvedValueOnce(FIRST_TRADE).mockRejectedValue(closedError())
+    const seen: { loading: boolean; hasData: boolean; hasError: boolean }[] = []
+    const { result } = renderHook(
+      () => {
+        const r = useTradeQuery(args(usdc, yes))
+        seen.push({ loading: r.isLoading, hasData: !!r.data, hasError: !!r.error })
+        return r
+      },
+      { wrapper },
+    )
+    await waitFor(() => expect(result.current.data).toEqual(FIRST_TRADE))
+    await waitFor(() => expect(result.current.error).toBeInstanceOf(FetchError), { timeout: 3_000 })
+    expect(result.current.data).toBeUndefined()
+    expect(result.current.isLoading).toBe(false)
+
+    const firstRejection = seen.findIndex((s) => s.hasError)
+    const callsAtRejection = service.getTrade.mock.calls.length
+    await act(() => new Promise((resolve) => setTimeout(resolve, 2_500)))
+    const after = seen.slice(firstRejection)
+    expect(after.every((s) => !s.loading && !s.hasData && s.hasError)).toBe(true)
+    // Polling continues once a second, with no immediate retry of a rejection
+    const extraCalls = service.getTrade.mock.calls.length - callsAtRejection
+    expect(extraCalls).toBeGreaterThanOrEqual(1)
+    expect(extraCalls).toBeLessThanOrEqual(3)
+  }, 10_000)
+
+  it('shows the next quote as soon as the hook accepts the pair again', async () => {
+    service.getTrade
+      .mockResolvedValueOnce(FIRST_TRADE)
+      .mockRejectedValueOnce(closedError())
+      .mockResolvedValue({ quoteHash: 'back', trade: { id: 'back' } })
+    const { result } = renderHook(() => useTradeQuery(args(usdc, no)), { wrapper })
+    await waitFor(() => expect(result.current.error).toBeInstanceOf(FetchError), { timeout: 3_000 })
+    await waitFor(() => expect(result.current.data?.quoteHash).toBe('back'), { timeout: 3_000 })
+    expect(result.current.error).toBeNull()
+  }, 10_000)
+
+  it('keeps the stale quote hidden when an RPC error follows the rejection', async () => {
+    service.getTrade
+      .mockResolvedValueOnce(FIRST_TRADE)
+      .mockRejectedValueOnce(closedError())
+      .mockRejectedValue(toPredictionFetchError(new Error('upstream timeout')))
+    const seen: { loading: boolean; hasData: boolean }[] = []
+    const { result } = renderHook(
+      () => {
+        const r = useTradeQuery(args(usdc, yes))
+        seen.push({ loading: r.isLoading, hasData: !!r.data })
+        return r
+      },
+      { wrapper },
+    )
+    await waitFor(() => expect(result.current.data).toEqual(FIRST_TRADE))
+    const firstQuote = seen.length
+    await waitFor(
+      () => expect(getPredictionErrorData(result.current.error)?.errorCode).toBe(PREDICTION_RPC_ERROR_CODE),
+      {
+        timeout: 4_000,
+      },
+    )
+    const rejected = seen.slice(firstQuote).findIndex((s) => !s.hasData)
+    expect(rejected).toBeGreaterThanOrEqual(0)
+    expect(seen.slice(firstQuote + rejected).every((s) => !s.hasData && !s.loading)).toBe(true)
+  }, 10_000)
+
+  it('stops polling once the market is settled', async () => {
+    const settled = predictionFetchError({
+      detail: 'closed',
+      extra: { predictionCode: 'MARKET_CLOSED', revert: 'MarketClosed', isBuy: false },
+    })
+    service.getTrade.mockRejectedValue(settled)
+    const { result } = renderHook(() => useTradeQuery(args(yes, usdc)), { wrapper })
+    await waitFor(() => expect(result.current.error).toBe(settled), { timeout: 3_000 })
+    const calls = service.getTrade.mock.calls.length
+    await act(() => new Promise((resolve) => setTimeout(resolve, 2_500)))
+    expect(service.getTrade.mock.calls.length).toBe(calls)
+    expect(result.current.isLoading).toBe(false)
+  }, 10_000)
+
+  it('keeps the stale quote with the error for other tokens, as upstream does', async () => {
+    const upstreamError = new FetchError({
+      response: new Response(null, { status: 404 }),
+      data: { errorCode: TradingApi.Err404.errorCode.RESOURCE_NOT_FOUND },
+    })
+    service.getTrade.mockResolvedValueOnce(FIRST_TRADE).mockRejectedValue(upstreamError)
+    const { result } = renderHook(() => useTradeQuery(args(dai, weth)), { wrapper })
+    await waitFor(() => expect(result.current.data).toEqual(FIRST_TRADE))
+    await waitFor(() => expect(result.current.error).toBe(upstreamError), { timeout: 3_000 })
+    expect(result.current.data).toEqual(FIRST_TRADE)
+  }, 10_000)
+})
+
+describe('usePredictionSwapTxPlaceholder', () => {
+  const tradeOf = (
+    input: Token,
+    output: Token,
+    { amount = 1_000_000, tradeType = TradeType.EXACT_INPUT }: { amount?: number; tradeType?: TradeType } = {},
+  ): Trade =>
+    ({
+      tradeType,
+      inputAmount: CurrencyAmount.fromRawAmount(input, tradeType === TradeType.EXACT_INPUT ? amount : 7),
+      outputAmount: CurrencyAmount.fromRawAmount(output, tradeType === TradeType.EXACT_OUTPUT ? amount : 7),
+    }) as unknown as Trade
+
+  type Props = { data: { txRequests: string[] } | undefined; trade: Trade | undefined; approvalAction?: string }
+  const render = (initialProps: Props) =>
+    renderHook((props: Props) => usePredictionSwapTxPlaceholder(props), { initialProps })
+
+  beforeEach(() => {
+    resetPredictionRegistry()
+    registerPredictionMarkets([market()])
+  })
+
+  it('keeps the last /swap result of the trade across renders while the next one loads', () => {
+    const first = { txRequests: ['first'] }
+    const { result, rerender } = render({ data: first, trade: tradeOf(usdc, yes) })
+    rerender({ data: undefined, trade: tradeOf(usdc, yes) })
+    expect(result.current).toBe(first)
+    rerender({ data: undefined, trade: tradeOf(usdc, yes) })
+    expect(result.current).toBe(first)
+    rerender({ data: undefined, trade: tradeOf(usdc, no) })
+    expect(result.current).toBeUndefined()
+  })
+
+  it('never hands one amount, trade type or approval step the result of another', () => {
+    const first = { txRequests: ['first'] }
+    const { result, rerender } = render({ data: first, trade: tradeOf(usdc, yes), approvalAction: 'none' })
+    rerender({ data: undefined, trade: tradeOf(usdc, yes, { amount: 1_000_000_000 }), approvalAction: 'none' })
+    expect(result.current).toBeUndefined()
+    rerender({
+      data: undefined,
+      trade: tradeOf(usdc, yes, { tradeType: TradeType.EXACT_OUTPUT }),
+      approvalAction: 'none',
+    })
+    expect(result.current).toBeUndefined()
+    rerender({ data: undefined, trade: tradeOf(usdc, yes), approvalAction: 'permit2-approve' })
+    expect(result.current).toBeUndefined()
+    rerender({ data: undefined, trade: tradeOf(usdc, yes), approvalAction: 'none' })
+    expect(result.current).toBe(first)
+    // The output amount of an exact-in quote moves with the price and does not change the key
+    rerender({
+      data: undefined,
+      trade: { ...tradeOf(usdc, yes), outputAmount: CurrencyAmount.fromRawAmount(yes, 9) } as unknown as Trade,
+      approvalAction: 'none',
