+let gasPriceCache: { value: bigint; at: number } | undefined
+
+async function gasPrice(client: Client): Promise<bigint> {
+  if (gasPriceCache && Date.now() - gasPriceCache.at < GAS_PRICE_TTL_MS) {
+    return gasPriceCache.value
+  }
+  try {
+    gasPriceCache = { value: await getGasPrice(client), at: Date.now() }
+    return gasPriceCache.value
+  } catch {
+    return gasPriceCache?.value ?? FALLBACK_GAS_PRICE
+  }
