+  const yesKey = predictionPoolKey({ token: YES, usdc: USDC, hook: HOOK })
+  const noKey = predictionPoolKey({ token: NO, usdc: USDC, hook: HOOK })
+  const token = (isYes: boolean) => ({
+    address: isYes ? YES : NO,
+    symbol: isYes ? 'YES-ETH4000' : 'NO-ETH4000',
+    name: isYes ? 'Yes ETH >= 4000' : 'No ETH >= 4000',
+    decimals: 6,
+    isYes,
+    marketId: 1n,
+    poolKey: isYes ? yesKey : noKey,
+  })
+  return {
+    id: 1n,
+    hook: HOOK,
+    status,
+    info: {
+      yes: YES,
+      no: NO,
+      oracle: zeroAddress,
+      lnStrikeWad: 0n,
+      openTime: 0n,
+      expiry,
+      window,
+      cutoffBuffer: 0,
+      status: ['None', 'Trading', 'Settled', 'Invalid'].indexOf(status),
+      yesWon: false,
+      bucket: 0n,
+      outYes: 0n,
+      outNo: 0n,
+      invYes: 0n,
