+import { FetchError, TradingApi } from '@universe/api'
+import { WarningAction, WarningLabel } from 'uniswap/src/components/modals/WarningModal/types'
+import { registerPredictionMarkets, resetPredictionRegistry } from 'uniswap/src/features/predictionMarkets/registry'
+import {
+  type HookQuote,
+  type Market,
+  MarketStatus,
+  PredictionSwapError,
+  predictionPoolKey,
+  UNICHAIN_SEPOLIA,
+  WAD,
+} from 'uniswap/src/features/predictionMarkets/sdk'
+import {
+  isFinalPredictionRejection,
+  isPredictionQuoteRejection,
+  predictionClosingError,
+  predictionUsdcOnlyError,
+  shouldRetryPredictionQuote,
+  toPredictionFetchError,
+} from 'uniswap/src/features/predictionMarkets/tradingApiFormat'
+import {
+  formatCountdown,
+  formatMarketQuestion,
+  formatMarketTime,
+} from 'uniswap/src/features/predictionMarkets/ui/marketFormat'
+import {
+  describeOutcome,
+  getPredictionMarketPhase,
+  summarizePredictionMarket,
+} from 'uniswap/src/features/predictionMarkets/ui/marketStatus'
+import { getPredictionSwapWarning } from 'uniswap/src/features/predictionMarkets/ui/predictionErrors'
+import { getSwapWarningFromError } from 'uniswap/src/features/transactions/swap/hooks/useSwapWarnings/getSwapWarningFromError'
+import type { DerivedSwapInfo } from 'uniswap/src/features/transactions/swap/types/derivedSwapInfo'
+import { getAddress, zeroAddress } from 'viem'
+
+const HOOK = getAddress('0x00000000000000000000000000000000c0de2aa8')
+const USDC = UNICHAIN_SEPOLIA.usdc
+const YES = getAddress('0xfe00000000000000000000000000000000000001')
+const NO = getAddress('0x0100000000000000000000000000000000000001')
+
+// 23:02:04 UTC, a 60 s market opened at 23:01:04 with a 10 s window and a 2 s buffer
+const EXPIRY = 1_790_377_324
+const OPEN = EXPIRY - 60
+const CUTOFF = EXPIRY - 12
+
+function market(status: Market['status'] = 'Trading', yesWon = false): Market {
+  const token = (isYes: boolean): Market['yes'] => ({
+    address: isYes ? YES : NO,
+    symbol: isYes ? 'YES-2691.96-230204' : 'NO-2691.96-230204',
+    name: isYes ? 'YES ETH>2691.96 23:02:04' : 'NO ETH>2691.96 23:02:04',
+    decimals: 6,
+    isYes,
+    marketId: 46n,
+    poolKey: predictionPoolKey({ token: isYes ? YES : NO, usdc: USDC, hook: HOOK }),
+  })
+  return {
+    id: 46n,
+    hook: HOOK,
+    status,
+    info: {
+      yes: YES,
+      no: NO,
+      oracle: zeroAddress,
+      lnStrikeWad: 0n,
+      openTime: BigInt(OPEN),
+      expiry: BigInt(EXPIRY),
+      window: 10,
+      cutoffBuffer: 2,
+      status: MarketStatus[status],
+      yesWon,
+      bucket: 0n,
+      outYes: 0n,
+      outNo: 0n,
+      invYes: 0n,
+      invNo: 0n,
+    },
+    yes: token(true),
+    no: token(false),
+    strikeUsd: 2691.96,
+    cutoff: BigInt(CUTOFF),
+  }
+}
+
+function hookRevert(name: string, isBuy: boolean, isYes = true): FetchError {
+  const code =
+    name === 'NotTradable' || name === 'MarketClosed'
+      ? 'MARKET_CLOSED'
+      : name === 'OutOfBand'
+        ? 'OUT_OF_BAND'
+        : 'CAPACITY'
+  const m = market()
+  return toPredictionFetchError(
+    new PredictionSwapError({ message: 'x', code, revert: { code, message: 'x', name, path: [name], raw: '0x' } }),
+    { token: isYes ? m.yes : m.no, poolKey: m.yes.poolKey, zeroForOne: true, isBuy },
+  )
+}
+
+describe('prediction market formatting', () => {
+  it('writes the market question and times in UTC, like the market names', () => {
+    const m = market()
+    expect(formatMarketQuestion({ ...m, asset: 'ETH' }, EXPIRY - 30)).toBe('ETH above $2,691.96 at 23:02:04 UTC?')
+    expect(formatMarketQuestion({ ...m, asset: 'SOL' }, EXPIRY - 30)).toBe('SOL above $2,691.96 at 23:02:04 UTC?')
+    expect(formatMarketQuestion({ ...m, asset: undefined }, EXPIRY - 30)).toBe('Price above $2,691.96 at 23:02:04 UTC?')
+    expect(formatMarketTime(EXPIRY, EXPIRY - 3 * 86_400)).toBe('Sep 25, 23:02:04 UTC')
+  })
+
+  it('formats countdowns', () => {
+    expect(formatCountdown(23)).toBe('0:23')
+    expect(formatCountdown(725)).toBe('12:05')
+    expect(formatCountdown(3_723)).toBe('1:02:03')
+    expect(formatCountdown(2 * 86_400 + 3 * 3_600)).toBe('2d 3h')
+    expect(formatCountdown(-5)).toBe('0:00')
+  })
+})
+
+describe('prediction market status', () => {
+  it('follows the hook trading window: open until expiry - window - cutoffBuffer', () => {
+    const m = market()
+    expect(getPredictionMarketPhase(m, OPEN - 1)).toBe('upcoming')
+    expect(getPredictionMarketPhase(m, OPEN)).toBe('trading')
+    expect(getPredictionMarketPhase(m, CUTOFF - 5)).toBe('trading')
+    expect(getPredictionMarketPhase(m, CUTOFF - 4)).toBe('closing')
+    expect(getPredictionMarketPhase(m, CUTOFF - 1)).toBe('closing')
+    expect(getPredictionMarketPhase(m, CUTOFF)).toBe('closed')
+    expect(getPredictionMarketPhase(market('Settled'), CUTOFF)).toBe('settled')
+    expect(getPredictionMarketPhase(market('Invalid'), EXPIRY + 10)).toBe('invalid')
+  })
+
+  it('tells the holder what they can do in each phase', () => {
+    expect(summarizePredictionMarket({ market: market(), isYes: true, now: CUTOFF - 23 })).toEqual({
+      phase: 'trading',
+      badge: 'Trading',
+      hint: 'Trading closes in 0:23',
+    })
+    expect(summarizePredictionMarket({ market: market(), isYes: true, now: CUTOFF - 3 })).toEqual({
+      phase: 'closing',
+      badge: 'Closing',
+      hint: 'Trading closes in 0:03, too soon for a new swap to confirm',
+    })
+    expect(summarizePredictionMarket({ market: market(), isYes: true, now: CUTOFF + 1 })).toEqual({
+      phase: 'closed',
+      badge: 'Closed - awaiting settlement',
+      hint: 'Trading closed - settles at 23:02:04 UTC',
+    })
+    expect(summarizePredictionMarket({ market: market('Settled', true), isYes: true, now: EXPIRY + 5 }).hint).toBe(
+      'YES won - sell YES for exactly $1.00',
+    )
+    const lost = summarizePredictionMarket({ market: market('Settled', false), isYes: true, now: EXPIRY + 5 })
+    expect(lost.badge).toBe('Settled: NO won')
+    expect(lost.hint).toBe('NO won - YES is worth $0 and cannot be sold')
+    expect(summarizePredictionMarket({ market: market('Invalid'), isYes: false, now: EXPIRY + 5 }).badge).toBe(
+      'Invalid',
+    )
+  })
+
+  it('shows ask and bid while tradable, the mid after the cutoff and fixed payouts once settled', () => {
+    const quote: HookQuote = {
+      tradable: true,
+      tau: 30n,
+      varE36: 0n,
+      xWad: 0n,
+      midYes: (WAD * 503n) / 1000n,
+      askYes: (WAD * 546n) / 1000n,
+      bidYes: (WAD * 460n) / 1000n,
+      askNo: (WAD * 540n) / 1000n,
+      bidNo: (WAD * 454n) / 1000n,
+    }
+    const { info } = market()
+    expect(describeOutcome({ info, quote, isYes: true })).toEqual({
+      probability: '50.3%',
+      prices: 'Ask $0.546 · Bid $0.460',
+    })
+    expect(describeOutcome({ info, quote, isYes: false })).toEqual({
+      probability: '49.7%',
+      prices: 'Ask $0.540 · Bid $0.454',
+    })
+    expect(describeOutcome({ info, quote: { ...quote, tradable: false }, isYes: true }).prices).toBe('Mid $0.503')
+    expect(describeOutcome({ info, quote: { ...quote, midYes: 0n }, isYes: true })).toEqual({
+      probability: '-',
+      prices: '',
+    })
+    expect(describeOutcome({ info: market('Settled', false).info, quote, isYes: false })).toEqual({
+      probability: 'Won',
+      prices: 'Pays $1.00',
+    })
+  })
+})
+
+describe('prediction swap-form errors', () => {
+  beforeEach(() => {
+    resetPredictionRegistry()
+    registerPredictionMarkets([market()])
+    vi.useFakeTimers()
+    vi.setSystemTime((CUTOFF + 3) * 1000)
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  it('explains a closed market on the swap button instead of "No routes found"', () => {
+    const warning = getPredictionSwapWarning(hookRevert('NotTradable', true))
+    expect(warning).toMatchObject({
+      type: WarningLabel.NoRoutesError,
+      action: WarningAction.DisableReview,
+      title: 'Trading closed',
+      buttonText: 'Trading closed',
+      message: 'Trading closed at 23:01:52 UTC. The market settles at 23:02:04 UTC.',
+    })
+  })
+
+  it('explains the app refusing to quote in the last seconds before the cutoff', () => {
+    const m = market()
+    const closing = predictionClosingError({ token: m.yes, poolKey: m.yes.poolKey, zeroForOne: true, isBuy: true })
+    expect(getPredictionSwapWarning(closing)).toMatchObject({
+      action: WarningAction.DisableReview,
+      buttonText: 'Trading closing',
+      message: 'Trading closes at 23:01:52 UTC, too soon for a swap to confirm before then.',
+    })
+    expect(isPredictionQuoteRejection(closing)).toBe(true)
+    expect(isFinalPredictionRejection(closing)).toBe(false)
+  })
+
+  it('says a losing token cannot be sold after settlement', () => {
+    expect(getPredictionSwapWarning(hookRevert('MarketClosed', false, true))?.buttonText).toBe(
+      "NO won - YES can't be sold",
+    )
+    expect(getPredictionSwapWarning(hookRevert('MarketClosed', false, false))?.message).toBe(
+      'YES won. NO is worth $0 and cannot be sold.',
+    )
+  })
+
+  it('names band, capacity and liquidity rejections', () => {
+    expect(getPredictionSwapWarning(hookRevert('OutOfBand', true))?.title).toBe('Price outside trading band')
+    expect(getPredictionSwapWarning(hookRevert('EpochCapExceeded', true))?.title).toBe('Amount too large')
+    expect(getPredictionSwapWarning(hookRevert('Insolvent', false))?.title).toBe('Not enough liquidity')
+    expect(getPredictionSwapWarning(predictionUsdcOnlyError())?.title).toBe('Trade against USDC')
+  })
+
+  it('keeps RPC failures retryable and marks hook rejections final', () => {
+    const rpc = toPredictionFetchError(new Error('fetch failed'))
+    expect(getPredictionSwapWarning(rpc)).toMatchObject({
+      type: WarningLabel.SwapRouterError,
+      buttonText: 'Price unavailable, retrying',
+    })
+    expect(isPredictionQuoteRejection(rpc)).toBe(false)
+    expect(shouldRetryPredictionQuote(0, rpc)).toBe(true)
+    expect(shouldRetryPredictionQuote(1, rpc)).toBe(false)
+    const closed = hookRevert('NotTradable', true)
+    expect(isPredictionQuoteRejection(closed)).toBe(true)
+    expect(shouldRetryPredictionQuote(0, closed)).toBe(false)
+    expect(isFinalPredictionRejection(closed)).toBe(false)
+    expect(isFinalPredictionRejection(hookRevert('MarketClosed', false))).toBe(true)
+    expect(isFinalPredictionRejection(rpc)).toBe(false)
+  })
+
+  it('routes prediction errors through getSwapWarningFromError and leaves other errors alone', () => {
+    const derivedSwapInfo = { currencies: {} } as unknown as DerivedSwapInfo
+    const t = ((key: string) => key) as never
+    expect(getSwapWarningFromError({ error: hookRevert('NotTradable', true), t, derivedSwapInfo })).toMatchObject({
+      buttonText: 'Trading closed',
+    })
+    const hosted = new FetchError({
+      response: new Response(null, { status: 404 }),
+      data: { errorCode: TradingApi.Err404.errorCode.RESOURCE_NOT_FOUND, detail: 'No quotes available' },
+    })
+    const warning = getSwapWarningFromError({ error: hosted, t, derivedSwapInfo })
+    expect(warning.type).toBe(WarningLabel.NoRoutesError)
+    expect(warning.title).toBe('swap.warning.noRoutesFound.title')
+    expect(warning.buttonText).toBeUndefined()
+    expect(getPredictionSwapWarning(hosted)).toBeUndefined()
+  })
+})
