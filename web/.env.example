# Server-only URL. Development defaults to this local indexer.
# Production requires an explicit URL reachable from the Next.js server.
PHINARY_INDEXER_URL=http://127.0.0.1:42069
# Optional RPC for reads (defaults to the deployment file). Several comma-separated URLs: the first is primary,
# the rest are fallbacks. Wallets that add the network always get the public URL from the deployment file.
# NEXT_PUBLIC_PHINARY_RPC_URL=
