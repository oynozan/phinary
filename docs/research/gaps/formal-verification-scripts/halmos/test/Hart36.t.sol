pragma solidity 0.8.26;
import {Test, console2} from "forge-std/Test.sol";
import {HartTail} from "../src/HartTail.sol";
import {HartTail36} from "../src/HartTail36.sol";
contract Hart36Test is Test {
    function t36(int256 z) external pure returns (int256) { return HartTail36.tail(z); }
    function t18(int256 z) external pure returns (int256) { return HartTail.tail(z); }
    function test_fixedAtCounterexamples() public view {
        int256[54] memory z = [int256(6202233335529410195), 6303079096165091875, 6027786722934775865, 5286460121124371423, 6661458662939610403, 6440060383440821730, 6187948572333097328, 6872358835780745878, 6708725881521969668, 5699734168296885338, 6861540423837912252, 6261417537473808714, 6586946719950138967, 7033987578397241766, 6287807734453241216, 6866251872966935580, 6269369559929890963, 7018639873943999809, 6521026490074892365, 5522234626869426889, 6961247426627469447, 6472486661021418114, 5346810820153643763, 6122979636497310445, 5816209346199876760, 5737320250332275286, 5542473309140766945, 6428588690145350153, 6873274956246548227, 6402247417246185363, 5436802834143626541, 5739864034497744388, 6170555127200533908, 5517256551338532797, 6304276255718248057, 6836054508481123237, 6801063959607372407, 6786239988578995128, 6801882007148922120, 7014738756134657494, 5284307399387502956, 5859223291689422138, 5828138772452585824, 5050085068442036099, 6204407000511264393, 6741120820358182155, 5377058072789453700, 5807661220352765048, 5905284558499070212, 5946034498939224035, 5261241198012984400, 6561247593932007152, 6712243007923218722, 6103744821760623262];
        for (uint256 i; i < z.length; ++i) assertLe(this.t36(z[i] + 1), this.t36(z[i]));
    }
    function test_gas() public view {
        int256[4] memory z = [int256(3e17), 1.3e18, 4.2e18, 6.6e18];
        for (uint256 i; i < 4; ++i) {
            uint256 g = gasleft(); HartTail36.tail(z[i]); uint256 g36 = g - gasleft();
            g = gasleft(); HartTail.tail(z[i]); uint256 g18 = g - gasleft();
            console2.log("z", uint256(z[i]), g36, g18);
        }
    }
    /// differential vs the checked WAD port (same values up to the extra precision)
    /// forge-config: default.fuzz.runs = 100000
    function testFuzz_close(int256 z) public view {
        z = bound(z, 0, 9e18);
        int256 a = this.t36(z); int256 b = this.t18(z);
        assertApproxEqAbs(a, b, 2);
    }
}
