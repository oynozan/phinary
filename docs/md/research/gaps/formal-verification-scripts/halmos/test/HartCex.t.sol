pragma solidity 0.8.26;
import {Test, console2} from "forge-std/Test.sol";
import {HartTail} from "../src/HartTail.sol";
contract HartCex is Test {
    function tailExt(int256 z) external pure returns (int256) { return HartTail.tail(z); }
    function cdf(int256 x) public view returns (int256) { return x <= 0 ? this.tailExt(-x) : 1e18 - this.tailExt(x); }
    function test_counterexamples() public view {
        int256[] memory z = new int256[](54);
        z[0] = 6202233335529410195;
        z[1] = 6303079096165091875;
        z[2] = 6027786722934775865;
        z[3] = 5286460121124371423;
        z[4] = 6661458662939610403;
        z[5] = 6440060383440821730;
        z[6] = 6187948572333097328;
        z[7] = 6872358835780745878;
        z[8] = 6708725881521969668;
        z[9] = 5699734168296885338;
        z[10] = 6861540423837912252;
        z[11] = 6261417537473808714;
        z[12] = 6586946719950138967;
        z[13] = 7033987578397241766;
        z[14] = 6287807734453241216;
        z[15] = 6866251872966935580;
        z[16] = 6269369559929890963;
        z[17] = 7018639873943999809;
        z[18] = 6521026490074892365;
        z[19] = 5522234626869426889;
        z[20] = 6961247426627469447;
        z[21] = 6472486661021418114;
        z[22] = 5346810820153643763;
        z[23] = 6122979636497310445;
        z[24] = 5816209346199876760;
        z[25] = 5737320250332275286;
        z[26] = 5542473309140766945;
        z[27] = 6428588690145350153;
        z[28] = 6873274956246548227;
        z[29] = 6402247417246185363;
        z[30] = 5436802834143626541;
        z[31] = 5739864034497744388;
        z[32] = 6170555127200533908;
        z[33] = 5517256551338532797;
        z[34] = 6304276255718248057;
        z[35] = 6836054508481123237;
        z[36] = 6801063959607372407;
        z[37] = 6786239988578995128;
        z[38] = 6801882007148922120;
        z[39] = 7014738756134657494;
        z[40] = 5284307399387502956;
        z[41] = 5859223291689422138;
        z[42] = 5828138772452585824;
        z[43] = 5050085068442036099;
        z[44] = 6204407000511264393;
        z[45] = 6741120820358182155;
        z[46] = 5377058072789453700;
        z[47] = 5807661220352765048;
        z[48] = 5905284558499070212;
        z[49] = 5946034498939224035;
        z[50] = 5261241198012984400;
        z[51] = 6561247593932007152;
        z[52] = 6712243007923218722;
        z[53] = 6103744821760623262;
        uint256 n;
        for (uint256 i; i < z.length; ++i) {
            int256 a = this.tailExt(z[i]); int256 b = this.tailExt(z[i] + 1);
            if (b > a) n++;
            // Phi-hat = 1 - tail on x > 0: it DEcreases by one wei when x increases by one wei
            assertEq(cdf(z[i] + 1) + 1, cdf(z[i]));
            // and on x < 0: cdf(-(z+1)) > cdf(-z) although -(z+1) < -z
            assertGt(cdf(-z[i] - 1), cdf(-z[i]));
        }
        console2.log("EVM-confirmed tail(z+1) > tail(z):", n, "of", z.length);
        assertEq(n, z.length);
    }
}
